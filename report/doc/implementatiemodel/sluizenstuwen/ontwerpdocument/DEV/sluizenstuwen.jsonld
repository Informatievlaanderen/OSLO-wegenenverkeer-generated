        {
            "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Bodembescherming",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "definition": {
                "nl": "Een specifieke constructieve maatregel die is ontworpen om de bodem en onderliggende fundering van de sluis of stuw te beschermen tegen erosie en andere vormen van schade veroorzaakt door waterstromen. Bodembescherming helpt om de stabiliteit en duurzaamheid van de constructie te waarborgen en mogelijke gevolgen van erosie te voorkomen."
            },
