skos:Concept a rdfs:Class;
  rdfs:label "Beweegbaar deel"@nl,
    "type beweging"@nl,
    "Aardingsinstallatie aardingsstelsel"@nl,
    "Meteo foto beschrijving"@nl .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling.foto> a owl:ObjectProperty;
  rdfs:comment "Een foto van de opstelling zoals die te zien is op het openbaar domein."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling.hoek> a owl:ObjectProperty;
  rdfs:comment "De hoek waarin het fysiek bord gepositioneerd is ten opzichte van een vooropgestelde as."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range xsd:decimal .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling.kaartvoorstelling> a owl:ObjectProperty;
  rdfs:comment "Grafische weergave van de opstelling in ontwerp met visueel onderscheid op basis van de status van het bord nl: bestaand, gepland of te verwijderen."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling.technischeVoorstelling> a owl:ObjectProperty;
  rdfs:comment "Grafische weergave van de opstelling zoals fysiek te zien op het openbaar domein met aanduiding van opstelhoogtes en horizontale verschuivingen."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcAardingsstelsel.attestDNB> a owl:ObjectProperty;
  <http://purl.org/vocab/vann/usageNote> "Voor een globaal aardingsstelsel moet een attest voorzien worden zoniet moet er van uitgegaan worden dat het om een gescheiden stelsel gaat "@nl;
  rdfs:comment "Een bestandsbijlage met het attest volgens het aardingsstelsel voorzien door de distributienetbeheerder ."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcAardingsstelsel>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcAardingsstelsel.type> a owl:ObjectProperty;
  rdfs:comment "Geeft het type aan van het aardingsstelsel volgens een keuzelijst."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcAardingsstelsel>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range skos:Concept .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug.astype> a owl:ObjectProperty;
  rdfs:comment "Maximale aslast van een uitzonderlijk voertuig dat zonder bijkomend advies over de brug mag rijden, uitgedrukt in kiloNewton."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInKiloNewton> .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug.totaleLast> a owl:ObjectProperty;
  rdfs:comment "Maximale totale last van een uitzonderlijk voertuig dat zonder bijkomend advies over de brug mag rijden, uitgedrukt in kiloNewton."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInKiloNewton> .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug.voorwaarden> a owl:DatatypeProperty;
  rdfs:comment "De randvoorwaarden van toepassing op de brug."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie>;
  rdfs:range xsd:string .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcDVWtoelaatbareSchipsafemetingen.maximaleBreedte> a owl:ObjectProperty;
  rdfs:comment "De maximale toelaatbare Breedte"@nl;
