    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Muurvegetatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Muurvegetatie"
      },
      "definition": {
        "nl": "Muurvegetaties zijn gebonden aan door de mens gecreëerde stenige, doorgaans steile tot verticale standplaatsen. Voorbeelden zijn kerkhofmuren, stadswallen, ruïnes, kademuren, oude forten en bunkers."
      },
