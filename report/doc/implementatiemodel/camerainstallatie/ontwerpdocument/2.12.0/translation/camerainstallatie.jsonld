    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Camera.opstelhoogte",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "name": "opstelhoogte",
      "inpackage": "OTHER_PACKAGE",
      "usage": {
        "nl": "De plaats waar de draagconstructie in de grond bevestigd is, bepaalt van waar gemeten wordt voor het bepalen van de opstelhoogte. Wanneer een camera die een brugdek overziet, bevestigd is aan een paal die naast de brug staat, wordt de hoogte gemeten vanaf de basis van de paal en niet vanaf het brugdek. "
      },
      "definition": {
        "nl": "De hoogte waarop de camera bevestigd is, gemeten ten opzichte van het maaiveld waarin de draagconstructie voor de camera verankerd is."
      },
      "label": {
        "nl": "opstelhoogte"
      },
      "ap-label-nl": {
        "nl": "opstelhoogte"
      },
      "ap-definition-nl": {
