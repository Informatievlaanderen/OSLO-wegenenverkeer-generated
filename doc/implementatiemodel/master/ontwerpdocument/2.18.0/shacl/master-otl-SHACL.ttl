<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#KamerShape/eef3aa764ce7a367564c223be90c380bc3898a27> rdfs:seeAlso "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#Kamer%3ABevestiging";
  shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PutBovenbouw>,
