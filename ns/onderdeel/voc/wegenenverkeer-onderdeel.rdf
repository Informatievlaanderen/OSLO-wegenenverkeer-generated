    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De oppervlakte van het gekleurd wegdeel in vierkante meter.</rdfs:comment>
