  <owl:DatatypeProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kokercomplex.ligtFunderingInOpRandWaterweg">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Geeft aan of de fundering van het landhoofd in of op de rand van de waterweg ligt.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.11.0-RC2</ns0:usageNote>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kokercomplex">
