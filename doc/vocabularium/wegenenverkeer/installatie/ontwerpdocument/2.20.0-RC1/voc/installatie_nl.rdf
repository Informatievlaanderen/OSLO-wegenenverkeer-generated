    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het type afwerking van de leuning.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.18.0-RC1</ns0:usageNote>
