<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#ConstructieElementShape/49f36b168dfd8d372dd964a17ca93fcf51d5d515> rdfs:seeAlso "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#ConstructieElement%3ABevestiging%20(target)";
  shacl:description "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."@nl;
  shacl:name "Bevestiging (target)"@nl;
  shacl:nodekind "sh:BlankNodeOrIRI";
  shacl:path <https://wegenenverkeer.data.vlaanderen.be/doc/implementatiemodel/master/#Bevestiging>;
  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De verwachte waarde voor Bevestiging (target) is een rdfs:Resource (URI of blank node)"];
  <https://data.vlaanderen.be/ns/shacl#rule> "" .

<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#ConstructieElementShape/5a08e493ecdeab33b32fbf22eecec84e5b1a4f2d> rdfs:seeAlso "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#ConstructieElement%3ASluit%20aan%20op";
  shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ComplexeGeleiding>;
  shacl:description "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."@nl;
  shacl:name "Sluit aan op"@nl;
  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Sluit aan op moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ComplexeGeleiding> zijn."];
  <https://data.vlaanderen.be/ns/shacl#rule> "" .

<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#ConstructieElementShape/8538498ca121309aa762d08080bc19b24ec68189> rdfs:seeAlso "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#ConstructieElement%3ALigt%20op";
  shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement>;
  shacl:description "Deze relatie geeft aan dat 2 onderdelen direct fysiek op elkaar liggen. Deze relatie heeft een richting en gaat van het bovenste naar het onderste onderdeel."@nl;
  shacl:name "Ligt op"@nl;
  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Ligt op moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement> zijn."];
  <https://data.vlaanderen.be/ns/shacl#rule> "" .

