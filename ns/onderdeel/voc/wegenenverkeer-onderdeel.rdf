        <rdfs:comment xml:lang="nl">Behuizing in de vorm van een kast typisch gebruikt buiten,langs de kant van de weg.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Buitenkast"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast.heeftMaaibescherming">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan of de kast voorzien is van bescherming tegen schade bij het maaien van de omgeving rond de kast.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast.mplan">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Mechanisch plan van de volledige installatie. Er wordt één plan toegevoegd per installatie/techniek die op de kast is aangesloten.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Bestanden van het type dwg of pdf.</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Type van de wegkantkast volgens de gangbare types.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegreflector.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De vorm van wegreflector.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegreflector">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Heeft als doel de zichtbaarheid van verkeerseilanden te verhogen en geleiding van de weggebruiker langs de weg.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Bebakening"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wentellager.merk">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het merk van het lager.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wentellager">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een wentellager of rollend lager is een lager waarin de wrijving wordt verminderd door het gebruiken van rollende elementen tussen de as en de boring. Afhankelijk van de aard en de vorm van het rollend element, spreken we van cilinderlagers, diabololagers, kegellagers, kogellagers, naaldlagers, bollagers of tonlagers.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Lager"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wentellager.modelnaam">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De modelnaam volgens de fabrikant van het lager.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wentellager"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wentellager.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan welk type wentellager hier gebruikt wordt.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wentellager"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Werkschakelaar">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Een handbediende schakelaar die in de nabijheid van een elektromechanische installatie is aangebracht om deze gedurende onderhouds- en reparatiewerkzaamheden te kunnen uitschakelen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#MotorVermogenskring"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wervel.peil">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Dit is het niveau in meter-TAW van de inlaat van het wervelventiel.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wervel">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een wervel is een debietsbeperkend element dat zich tussen 2 kamers of tussen een kamer en een leiding bevindt.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wildreflector.drager">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De constructie waar de wildreflector is aan bevestigd.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wildreflector">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een wildreflector is een reflecterend afschrikkingssysteem voor groot en klein wild nabij een weg.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Bebakening"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wilgenstruweel">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">H1 - wilgensoorten, sporkehout, gewone vlier, braam spp., brede stekelvaren, grote brandnetel, hondsdraf, kleefkruid, pitrus.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Windmeter.merk">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het merk van de windmeter.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Windmeter">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een meettoestel dat windsnelheid en/of windrichting meet. Het meetresultaat wordt omgezet in een uitleesbaar signaal.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Sensoropstelling"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Windmeter.modelnaam">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De mùodelnaam van de windmeter.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Windmeter"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Windmeter.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het type van windmeter.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Windmeter"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef.gewicht">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het gewicht van de wormschroef in kilogram.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een spiraalvormige schroef die toelaat vloeistoffen, sluries, of poeders te transporteren. De schroef, geplaatst in een gesloten of deels open buis, wordt aangedreven en draait rond zijn eigen as. Deze draaiende beweging leidt tot de verplaatsing van het te verplaatsen medium. Wanneer het medium in opwaartse richting getransporteerd wordt spreekt men van een pomp. Wanneer het medium in afwaartse richting beweegt en al doende de schroef doet draaien, spreekt men van een turbine. Wordt ook wel waterschroef, opvoerschroef, vijzelpomp, of een schroef van Archimedes genoemd. </rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PompSchroefEnWaaier"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInKilogram"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef.isAfgesloten">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan of de schroef zich in een buis bevindt en dus afgesloten is.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef.isVisvriendelijk">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan of de wormschroef visvriendelijk is. Een schroef is visvriendelijk, als hij zodanig is ontworpen dat een vissen die worden meegeschept in leven blijven.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef.lengte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De lengte van de wormschroef volgens zijn as.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef.opvoerhoogte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De hoogte tot waarop het medium wordt opgepompt.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zelfsluiter.sluitkracht">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft de mogelijkheden en instelling van het zelfsluitend mechanische aan.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zelfsluiter">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Mechanisme voor oa. deuren en poorten dat er voor zorgt dat de gekoppelde deur of poort sluit zonder verdere tussenkomst.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcZelfsluiterSluitkracht"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zelfsluiter.uitvoeringswijze">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft de stand van de deursluiter in het dagelijks gebruik aan.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zelfsluiter"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zender.merk">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het merk van een zender.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zender">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een apparaat dat signalen uitzendt.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ZenderOntvangerToegang"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zender.modelnaam">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De modelnaam/product range van een zender.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zender"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zender.toepassing">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De techniek of standaard waarmee signalen over het netwerk verstuurd worden. Mogelijke waarden zijn onder andere: KAR, wifi, GPRS of GSM..</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.8.0 </ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zender"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DteTekstblok"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zendmast.hoogte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De hoogte van de zendmast.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zendmast">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een constructie, doorgaans hoger dan 10 meter, die door mensen beklimbaar is en waarop apparatuur kan worden geïnstalleerd. Aan de mast is doorgaans een koppelstuk voorzien dat rond de mast klemt en bevestigbaar is op verschillende hoogtes met de nodige doorgangen voor de aansluitkabels, dat toelaat de antenne's te bevestigen.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zendmast.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het type zendmast.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zendmast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zendontvanger.frequentierange">
