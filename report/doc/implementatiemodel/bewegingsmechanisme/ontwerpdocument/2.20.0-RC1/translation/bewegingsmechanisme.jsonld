    {
      "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Balans",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "inpackage": "OTHER_PACKAGE",
      "definition": {
        "nl": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
      },
      "label": {
        "nl": "Balans"
      },
      "ap-label-nl": {
        "nl": "Balans"
      },
      "ap-definition-nl": {
        "nl": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
      },
      "extra": {
        "EA-Name": "Balans",
        "EA-Guid": "{8A65DA0A-F947-4496-80C8-1DF1EC0AB84C}",
        "EA-Package": "OSLO-Installatie",
        "EA-Type": "CLASS",
        "EA-Parents": "",
        "EA-Parents2": [
          {
            "name": "ConstructiefObject",
            "label": "Constructief object",
            "package": "OSLO-Abstracten",
            "uri": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
          }
        ],
        "parentclasses": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#ConstructiefObject",
        "label": {
          "nl": "Balans"
        },
        "definition": {
          "nl": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
        },
        "usage": "",
        "ap-label-nl": {
          "nl": "Balans"
        },
        "ap-definition-nl": {
          "nl": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
        },
        "ap-usageNote-nl": "",
        "ap-codelist": "",
        "RawTags": [
          {
            "key": "beheerstatus",
            "value": "Gepubliceerd",
            "note": "Values: Nieuw,Gepubliceerd,InVerwerking,UitGebruik,Vervangen,Geconsolideerd,UitGebruikGeconsolideerd,NieuwGeconsolideerd,NieuwUitGebruik\r\nDefault: Nieuw\r\n"
          },
          {
            "key": "creatie",
            "value": "2.12.0-RC2.510",
            "note": "null"
          },
          {
            "key": "definition-nl",
            "value": "NOTE",
            "note": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
          },
          {
            "key": "deprecated",
            "value": "false",
            "note": "Values: false,true\r\nDefault: false\r\n"
          },
          {
            "key": "imported",
            "value": "1",
            "note": "null"
          },
          {
            "key": "laatstGewijzigd",
            "value": "2.12.0-RC2.510",
            "note": "null"
          },
          {
            "key": "label-nl",
            "value": "Balans",
            "note": "null"
