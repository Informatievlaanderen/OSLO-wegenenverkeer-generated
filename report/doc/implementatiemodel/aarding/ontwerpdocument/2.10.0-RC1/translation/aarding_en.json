    {
      "EA-Guid": "{69A6549E-3205-4901-A9AD-F01E8DC0BF14}",
      "name": "Aardingsinstallatie",
      "label": {
        "nl": "Aardingsinstallatie",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "Een galvanische verbinding van een elektrische installatie met de aarde. De elektrische installatie die op deze wijze met de aarde wordt verbonden krijgt een spanning van nul volt.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{A53A6A8D-E3DF-4172-AE29-9DBD83A5C2A1}",
      "name": "Aardingsstelsel details.",
      "label": {
        "nl": "Aardingsstelsel details.",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "Complex datatype dat het mogelijk maakt om het attest van de distributienetbeheerder toe te voegen in het geval van een globaal aardingsstelsel.",
        "en": "Enter your translation here"
      },
      "usage": {
        "nl": "Het attest is enkel vereist voor globale aardingsstelsels. Voor gescheiden aardinsstelsel kanhet attribuut attestDNB leeg blijven.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{528E3742-F760-4bf0-8A5F-74E10B3D7704}",
      "name": "Aardingskabel",
      "label": {
        "nl": "Aardingskabel",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "Een aardingskabel is een geleidende verbinding, typisch uit koper, die ervoor zorgt dat een ongewenste elektrische stroom (foutstroom) op een installatie naar de aarde kan afgeleid worden.",
        "en": "Enter your translation here"
      },
      "usage": {
        "nl": "Dit type verwijst naar een kabel die enkel de aarding als functie heeft en niet de geel-groene draad in een voedingskabel. Die laatste maakt impliciet deel uit van de voedingskabel.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{AF368246-F5A1-4554-93C3-929A4D8C22C7}",
      "name": "Aardingslus",
      "label": {
        "nl": "Aardingslus",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "Een koperen geleider die onder de fundering van een gebouw de contouren van het te aarden gebouw volgt. De lus vertrekt en komt aan op de aardingsonderbreker.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{9F23E00C-42A4-4a9b-9DDB-7C3E3099EAD7}",
      "name": "Aardingsonderbreker",
      "label": {
        "nl": "Aardingsonderbreker",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "De verbindingsklem waarop de aardgeleider(s), de hoofdbeschermingsgeleider(s), en de hoofdequipotentiaalgeleider(s) toekomen. Het gaat om een T-vormige klem, waarbij de functie van meetklem en hoofdaardingsklem wordt gecombineerd.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{946071A5-6413-4420-8F88-8326E10A67D6}",
      "name": "Aardingspen",
      "label": {
        "nl": "Aardingspen",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "De aardingspen is het deel van de aardingsinstallatie dat in direct contact staat met de grond / de aarde.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{851E2395-627F-4352-8324-2E91CD6B80DE}",
      "name": "Bevestiging",
      "label": {
        "nl": "Bevestiging",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Deze relatie heeft geen richting.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{934B51FF-2196-42b8-A270-340048A0D384}",
      "name": "Equipotentiaal verbinding",
      "label": {
        "nl": "Equipotentiaal verbinding",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "Een equipotentiaal verbinding, ook wel equipotentiaalgeleider genoemd, voorziet de galvanische verbinding van een metalen object, dat in normale toestand niet stroomvoerend is, met het aardingsstelsel. Deze verbinding mag als aardingsgeleider derhalve nooit verbroken worden.",
        "en": "Enter your translation here"
      }
    },
    {
      "EA-Guid": "{43B11E61-958D-4a8f-A983-3C012ACA45C0}",
      "name": "Hoort bij",
      "label": {
        "nl": "Hoort bij",
        "en": "Enter your translation here"
      },
      "definition": {
        "nl": "De relatie geeft aan dat een onderdeel of collectie behoort bij, deel van of lid van een (andere) groep of collectie is.",
        "en": "Enter your translation here"
      }
    }
