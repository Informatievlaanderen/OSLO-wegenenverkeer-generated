  <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Centreermechanisme">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een geleidingsmechanisme dat een beweegbaar constructieonderdeel begeleidt opdat het zich correct positioneert bij het beëindigen van de beweging.</rdfs:comment>
