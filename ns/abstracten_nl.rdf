  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.assetId">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
    <rdfs:comment xml:lang="nl">Unieke identificatie van de aanvullende geometrie zoals toegekend door de beheerder of n.a.v. eerste aanlevering door de leverancier.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
        <rdfs:comment xml:lang="nl">Abstracte om de eigenschappen en relaties van AanvullendeGeometrie te bundelen.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMVersie"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMDBStatus"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMToestand"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcIdentificator"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.bijlage">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
    <rdfs:comment xml:lang="nl">Het document of artefact dat een geometrie heeft of een bijlage is.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.naam">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
    <rdfs:comment xml:lang="nl">De mensleesbare naam van een aanvullende geometrie of bijlage. De beheerder kent deze naam toe of geeft de opdracht om deze toe te kennen.</rdfs:comment>
