        {
            "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Kopmuur",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "definition": {
                "nl": "Een kopmuur is een inrichtingselement van de wegbaan, dat gebruikt wordt voor de geleiding van verkeer bij grachten. Een kopmuur is een keermuur die een functie vervult van afwateringssysteem en is in de regel haaks op de hartlijn van de wegcorridor georiënteerd. Afgeschuinde varianten worden als meer vergevingsgezind gezien bij een aanrijding."
            },
            "label": {
                "nl": "Kopmuur"
            },
            "ap-label-nl": {
                "nl": "Kopmuur"
            },
            "ap-definition-nl": {
