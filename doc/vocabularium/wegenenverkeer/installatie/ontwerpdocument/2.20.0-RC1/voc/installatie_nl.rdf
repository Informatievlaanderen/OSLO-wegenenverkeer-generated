    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Geeft de type gebruikers aan die kunnen voorkomen in de desbetreffende koker.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Koker"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Koker.maximaleVrijeHoogte">
