    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De waarde van de elektrische stroom aan de ingangszijde van de omvormer.</rdfs:comment>
