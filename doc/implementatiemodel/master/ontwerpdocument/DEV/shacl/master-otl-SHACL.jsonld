      "sh:property": [
        {
          "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/DEV#ComplexeGeleidingShape/21f219edbc3aebd4d4f3c8de99d8a1e420faf466",
          "rdfs:seeAlso": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/DEV#ComplexeGeleiding%3ASluit%20aan%20op",
          "sh:description": {
            "nl": "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."
          },
          "sh:name": {
