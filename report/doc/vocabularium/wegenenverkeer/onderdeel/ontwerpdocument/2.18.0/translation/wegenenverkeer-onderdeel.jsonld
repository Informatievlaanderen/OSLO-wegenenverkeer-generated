    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DynamischeVluchtwegindicatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Dynamische vluchtwegindicatie"
      },
      "definition": {
        "nl": "Armaturen die ingezet worden indien er alternatieve vluchtconcepten worden toegepast. De vluchtroute loopt dan meestal gedeeltelijk door de ondersteunende koker. De borden geven de te volgen vluchtroute aan en zijn pas zichtbaar zodra ze worden ingeschakeld. Bij evacuatie kan er ook een extra ondersteunende omroepbericht worden ingezet."
      },
      "label": {
        "nl": "Dynamische vluchtwegindicatie"
      },
