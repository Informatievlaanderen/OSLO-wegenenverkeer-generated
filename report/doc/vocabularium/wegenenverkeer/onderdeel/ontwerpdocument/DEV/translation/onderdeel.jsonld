    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm.heeftBoomplaat",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "name": "heeft boomplaat",
      "inpackage": "ACTIVE_PACKAGE",
      "label-nl": {
        "nl": "heeft boomplaat"
      },
      "definition": {
        "nl": "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."
      },
      "label": {
        "nl": "heeft boomplaat"
      },
      "definition-nl": {
        "nl": "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."
      },
      "extra": {
