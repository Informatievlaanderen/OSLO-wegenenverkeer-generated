        <rdfs:comment xml:lang="nl">De vloer van de kolk. De vloer dient opgesplitst te worden per moot, elke moot heeft een aparte vloer.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
