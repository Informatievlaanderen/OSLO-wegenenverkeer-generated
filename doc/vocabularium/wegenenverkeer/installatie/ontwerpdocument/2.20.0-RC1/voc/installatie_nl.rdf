  <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kabelbewegingsmechanisme">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een mechanisme dat gebruik maakt van kabels om kracht over te brengen en bewegingen uit te voeren.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Bewegingsmechanisme"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kabelkoker">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een ruimte die een of meerdere kabels of leidingen beschermt tegen beschadiging en/of de kabels of leidingen op een gecontroleerde plaats laat hangen of liggen. De constructieve elementen die de ruimte creëeren vormen een aaneen- en afgesloten geheel dat niet meer uit elkaar kan gehaald worden. De kabels en leidingen zijn enkel nog toegankelijk door in de koker zelf rond te lopen (of te kruipen). De koker is op die toegankelijkheid voorzien.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#NaampadObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Kabelgeleiding"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#ConstructiefObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kabelveerhuis.diameter">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De diameter van het kabelveerhuis, uitgedrukt in millimeter.</rdfs:comment>
