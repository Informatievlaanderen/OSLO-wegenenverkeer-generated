        {
          "@id": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/riolering/ontwerpdocument/2.7.1#LinkendElementShape/21f219edbc3aebd4d4f3c8de99d8a1e420faf466",
          "rdfs:seeAlso": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/riolering/ontwerpdocument/2.7.1#LinkendElement%3ASluit%20aan%20op",
