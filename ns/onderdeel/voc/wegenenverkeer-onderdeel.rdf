    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Software waarmee de verkeersregelaar geprogrammeerd kan worden.</rdfs:comment>
