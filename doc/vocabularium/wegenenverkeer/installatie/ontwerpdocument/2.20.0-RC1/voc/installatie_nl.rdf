    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#NaampadObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#InspectieputRiolering.hoekverdraaiing">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Verschil in richting tussen inkomende en uitgaande rioolbuis.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.19.0-RC3</ns0:usageNote>
