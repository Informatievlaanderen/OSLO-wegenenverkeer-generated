      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Fundering",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor verschillende manieren om er voor te zorgen dat het eigen gewicht van het object dat de fundering krijgt en de krachten uitgeoefend op dat object, zoals nuttige belasting, sneeuw, winddruk, enzovoorts, worden overgedragen op de draagkrachtige ondergrond. Een fundering zit hoofdzakelijk onder het maaiveld en heeft tot doel het stabiliseren van een ander object."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructieElement"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Kantopsluiting",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor de gemeenschappelijke eigenschappen en relaties voor de kantopsluiting."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LijnvormigElement",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LaagProductidentificatiecode"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LEDBord",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte klasse die de gemeenschappelijke eigenschappen van verschillende types dynamische verkeersborden groepeert."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Verkeersbord"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Laag",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor de gemeenschappelijke eigenschappen van de onderliggende verhardings- en funderings-onderdelen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LaagBouwklasse",
      "@type": "http://www.w3.org/2002/07/owl#Class",
