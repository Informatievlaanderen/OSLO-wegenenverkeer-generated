    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#ConstructieSokkel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Constructie sokkel"
      },
      "definition": {
        "nl": "Betonnen zool die het object dat erop rust verhoogt of dat dient om een structuur op een goede manier te kunnen opleggen/verbinden met de fundering."
      },
      "label": {
        "nl": "Constructie sokkel"
