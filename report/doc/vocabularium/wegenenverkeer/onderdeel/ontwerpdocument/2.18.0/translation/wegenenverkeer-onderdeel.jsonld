        ],
        "parentclasses": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Detectielus",
        "label": {
          "nl": "Virtuele detectiezone"
        },
        "definition": {
          "nl": "Een virtuele detectiezone is een draadloos alternatief voor een traditionele lus. Op basis van GPS gegevens wordt een zone of traject vastgelegd waarbinnen er (al dan niet selectieve) input dient geleverd te worden aan de verkeersregelaar. De virtuele detectiezone kan ook gebruikt worden om de detectiezones van detectiecamera's en radars te inventariseren. "
        },
        "usage": "",
        "label-nl": {
          "nl": "Virtuele detectiezone"
        },
