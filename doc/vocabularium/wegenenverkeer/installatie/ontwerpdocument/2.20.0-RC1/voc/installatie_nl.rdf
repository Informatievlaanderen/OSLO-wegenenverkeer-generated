    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Geeft aan of de funderingsaanzet al dan niet onder de bodem ligt.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.11.0-RC2</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kokercomplex"/>
