  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver.maximaalVermogen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Maximaal afgenomen vermogen van de driver en lamp/lichtbron samen (incl. verlies/verbruik van de driver zelf).</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een LED-driver is een elektronisch toestel dat de stroomtoevoer naar de LED's dimensioneert om de goede werking te verzekeren. Via de instelparameters van de driver kan uiteindelijk de lichtsterkte van de LED verlichting aangepast worden.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInWatt"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver.maximaleAanstuurstroom">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Maximale aanstuurstroom die de LED-driver kan leveren.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMilliAmpere"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver.merk">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het merk van de LED-driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver.modelnaam">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De modelnaam van de LED-driver.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver.protocol">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Protocol gebruikt door de LED-driver voor het aansturen van de LED's.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LKSensorDoorverbinddoos">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Een doorverbinddoos die in specifieke opstellingen de zender-ontvanger en de reflector voedt en hun data doorstuurt naar de controle unit.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Niet elke opstelling maakt gebruik van een sensordoorverbinddoos. De doorverbinddoos geeft enkel data (en voeding) door maar verwerkt nooit data. De verwerking gebeurt altijd in de controle unit.</ns0:usageNote>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord.aardingsnet">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De manier waarop respectievelijk de bron en de verbruiker met de aarde verbonden worden om op die manier foutstromen af te voeren.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Verzameling van alle elektrische componenten nodig voor de voeding en sturing van applicaties die erop aangesloten zijn. Omvat onder andere automaten,klemmenblokken,...</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord.elektrischSchema">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het elektrisch aansluitschema van het laagspanningsbord.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Bestanden van het type pdf,dwg of dxf.</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord.kabelberekeningsnota">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De verzameling van alle berekeningen uitgevoerd om de secties en maximale lengtes van de kabels, gebruikt in de installatie, te bepalen.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord"/>
