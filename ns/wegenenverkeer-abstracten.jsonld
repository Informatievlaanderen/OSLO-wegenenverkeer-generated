    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Detectielus",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor een detectielus. Een detectielus is een kabel onder het wegdek die in staat is om voertuigen te detecteren teneinde de verkeersregelaar aan te sturen. Selectieve lussen zijn in staat om gecodeerde informatie door te geven van prioritaire voertuigen, niet-selectieve lussen geven informatie door van alle voertuigen die het detectie gebied passeren."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Detectie"
      ]
    },
