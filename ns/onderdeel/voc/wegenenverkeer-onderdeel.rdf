    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#CementBentonietwand"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
