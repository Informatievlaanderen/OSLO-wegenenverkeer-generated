    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/brug/ontwerpdocument/2.6.0-RC2#BrugShape",
      "@type": "sh:NodeShape",
      "sh:closed": false,
      "sh:property": [
        {
          "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/brug/ontwerpdocument/2.6.0-RC2#BrugShape/256b677e634a327f7c262129b207bd69c45dfdc1",
          "rdfs:seeAlso": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/brug/ontwerpdocument/2.6.0-RC2#Brug%3Aburgerlijke%20klasse",
          "sh:description": {
            "nl": "Maximaal toegelaten belasting door gestandariseerde assen, meestal uitgedrukt als totaalgewicht / aslast in kN. Dit dient als ontwerpbelasting en om te oordelen of reële konvooien de brug kunnen overschrijden."
          },
          "sh:name": {
