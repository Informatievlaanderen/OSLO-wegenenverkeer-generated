<rdfs:domain>
<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VerruigdGrasland'>
<rdfs:comment xml:lang='nl'>R2 - grote brandnetel, kleefkruid, ridderzuring, akkerdistel, speerdistel, gewone berenklauw, fluitenkruid, bramen, klit, jacobskruiskruid, ijle dravik, dolle kervel, kweek, kropaar, haagwinde, zevenblad.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

