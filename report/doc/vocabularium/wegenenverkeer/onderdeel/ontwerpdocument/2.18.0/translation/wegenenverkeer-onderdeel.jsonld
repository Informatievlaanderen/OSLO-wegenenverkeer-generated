    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BoogpaalVerkeerslicht",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Boogpaal verkeerslicht"
      },
      "definition": {
        "nl": "Paal bestemd voor het bevestigen van seinlantaarns boven het wegdek. Geschikt voor het bevestigen van ten hoogste 4 seinlantaarns van het type 300 en van één of meerdere lantaarns van het type 200 op de paalschacht. De vrije hoogte ten opzichte van het wegdek bedraagt onder de lantaarns 6.500 millimeter voor palen met grote draagwijdte (7,5 meter overspanning) en 5.500 millimeter voor de palen met middelgrote draagwijdte (3,5 meter overspanning)."
      },
      "label": {
        "nl": "Boogpaal verkeerslicht"
      },
