  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kokerafsluiting">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het geheel van o.a. slagbomen,verkeerslichten en detectielussen in functie van de afsluiting van een koker.</rdfs:comment>
