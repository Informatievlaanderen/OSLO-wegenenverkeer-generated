<https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.20.0-RC1#CabineShape/eef3aa764ce7a367564c223be90c380bc3898a27> rdfs:seeAlso "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.20.0-RC1#Cabine%3ABevestiging";
  shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#HSBeveiligingscel>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Transformator>;
  shacl:description "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."@nl;
  shacl:name "Bevestiging"@nl;
  shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/#Bevestiging>;
