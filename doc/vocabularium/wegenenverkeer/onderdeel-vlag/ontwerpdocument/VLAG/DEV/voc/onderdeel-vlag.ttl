<https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm.boompaalconstructie> a owl:ObjectProperty;
  rdfs:comment "Een constructie om de wortels van de aangeplante boom vast te zetten of te fixeren met oa. palen."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm>;
