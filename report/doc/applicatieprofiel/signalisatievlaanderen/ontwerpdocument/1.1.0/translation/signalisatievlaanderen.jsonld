    {
      "@id": "https://schema.org/Schedule.perSetPositie",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "name": "per setpositie",
      "inpackage": "OTHER_PACKAGE",
      "usage": {
        "nl": "Bv als iets maandelijks plaatsvindt op maandag om te zeggen dat het bv de eerste maandag is vd maand. Frequentie is dan maandelijks, perDag is Maandag en de perSetpositie is dan 1. Ook negatieve cijfers zijn mogelijk, bv -1 zou aangeven dat het op de laatste maandag vd maand plaatsvindt."
      },
      "definition": {
        "nl": "N-de keer dat iets plaatsvindt uit de verzameling van mogelijke tijdstippen."
      },
