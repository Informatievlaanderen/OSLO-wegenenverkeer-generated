    {
      "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VastTegengewicht",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "inpackage": "OTHER_PACKAGE",
      "definition": {
        "nl": "Het vast tegengewicht betreft de hoeveelheid massa die onlosmakelijk met de machtarm is verbonden om (mee) het bewegende brugdeel te balanceren. De hoeveelheid massa benadert de vooropgestelde mate van onevenwicht. De massa kan bestaan uit beton, steen, staal, gietijzer of lood dat permanent ingewerkt is in de constructie."
      },
      "label": {
        "nl": "Vast tegengewicht"
      },
      "ap-label-nl": {
        "nl": "Vast tegengewicht"
      },
