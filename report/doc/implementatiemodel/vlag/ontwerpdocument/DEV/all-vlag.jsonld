        {
            "@id": "https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "usage": {
                "nl": "Dit kan een verkeersbord,verkeerslicht of wegmarkering zijn. Merk op: het gaat hier om de conceptuele weergave en niet om de fysieke wegsignalisatie op het openbaar domein."
            },
            "definition": {
                "nl": "De voorstelling van een aanwijzing ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode."
            },
            "label": {
                "nl": "Verkeersteken"
            },
            "ap-label-nl": {
                "nl": "Verkeersteken"
            },
