</owl:DatatypeProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.merk'>
<rdfs:comment xml:lang='nl'>Het merk van de camera.</rdfs:comment>

