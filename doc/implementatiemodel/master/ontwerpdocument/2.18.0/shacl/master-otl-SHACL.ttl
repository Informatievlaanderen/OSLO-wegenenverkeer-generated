  shacl:path <https://wegenenverkeer.data.vlaanderen.be/doc/implementatiemodel/master/#Bevestiging>;
  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Rack> zijn."], [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Rack> zijn."], [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Dongle> zijn."], [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Dongle> zijn."];
  <https://data.vlaanderen.be/ns/shacl#rule> "" .

<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#HardwareShape/f634432d0dade6668162b175d5e770d2423d7d1f> rdfs:seeAlso "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#Hardware%3Avormfactor";
