      "definition": {
        "nl": "Abstracte die de relaties voorziet van gemeenschappelijk eigenschappen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMVersie",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMDBStatus"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#TelecommunicationsAppurtenance",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Appurtenance-objecten zijn toebehoren of accessoires, dus allerlei apparaten, toestellen en dergelijke,kortom diverse soorten leidingelementen."
      },
      "usage": {
        "nl": "Gebruik dit type enkel voor aanlevering voor AKELA indien geen specifieke types aanwezig zijn in OTL."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#Appurtenance"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#TelecommunicationsCable",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een aansluiting of reeks aansluitingen van een nutsvoorzieningennet voor het overbrengen van data van de ene locatie naar een andere."
      },
      "usage": {
        "nl": "Gebruik dit type enkel voor aanlevering voor AKELA indien geen specifieke types aanwezig zijn in OTL."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Kabel"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#Toegangsprocedure",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De procedure die gevolgd moet worden om toegang te verkrijgen tot een object."
      },
      "usage": {
        "nl": "Om een toegangspunt tot het object te verduidelijken, kan er een punt geometrie aangeleverd worden om het toegangspunt aan te geven."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMVersie",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMToestand",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMDBStatus"
      ]
    }
