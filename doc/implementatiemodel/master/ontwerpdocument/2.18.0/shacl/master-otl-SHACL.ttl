<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#StroomkringShape/eef3aa764ce7a367564c223be90c380bc3898a27> rdfs:seeAlso "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#Stroomkring%3ABevestiging";
  shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord>;
  shacl:description "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."@nl;
  shacl:name "Bevestiging"@nl;
  shacl:path <https://wegenenverkeer.data.vlaanderen.be/doc/implementatiemodel/master/#Bevestiging>;
  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord> zijn."], [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord> zijn."];
  <https://data.vlaanderen.be/ns/shacl#rule> "" .

