    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Stormraam",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Stormraam"
      },
      "definition": {
        "nl": "Open raamwerk dat aan zeezijde van de afwaartse sluisdeur tegen de sluisdeur geplaatst wordt en vergrendeld door het inschuiven van een spie via verticale cilinder op de deur. Bij voorspelde storm vermijdt dit schade door het voorkomen van klapperen van de afwaartse deuren bij grote stormgolven en wisselende waterdruk."
      },
