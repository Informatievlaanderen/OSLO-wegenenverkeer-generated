  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PlintGC.afmetingen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Met dit complex datatype worden de afmetingen van de plint weergegeven. Indien de plint afwijkt van een rechthoekige vorm wordt deze informatie in de technische fiche opgeslagen.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PlintGC">
