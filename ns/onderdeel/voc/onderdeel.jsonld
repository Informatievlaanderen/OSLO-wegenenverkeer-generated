    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#PlintGC",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een plint is een betonnen balk/plaat die de akoestische dichtheid verzekert tussen de schermelementen van de geluidswerende constructie en de bodem."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructieElement",
