    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De afstand tussen het hoogste en laagste punt van de aansluitopening in millimeter.</rdfs:comment>
