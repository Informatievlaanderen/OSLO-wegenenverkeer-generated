      "@id": "https://wegenenverkeer-test.data.vlaanderen.be/doc/implementatiemodel/tunnelevacuatie/#Sturing",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "name": "sturing",
      "inpackage": "OTHER_PACKAGE",
      "usage": {
        "nl": "Relatie uit gebruik sinds versie 2.4.0-RC1"
      },
      "definition": {
        "nl": "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."
      },
      "label": {
        "nl": "Sturing"
      },
      "ap-label-nl": {
        "nl": "Sturing"
      },
