    {
      "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Heftoren",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "inpackage": "OTHER_PACKAGE",
      "definition": {
        "nl": "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."
      },
      "label": {
        "nl": "Heftoren"
      },
      "ap-label-nl": {
        "nl": "Heftoren"
      },
      "ap-definition-nl": {
        "nl": "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."
      },
      "extra": {
        "EA-Name": "Heftoren",
        "EA-Guid": "{C7118380-74F0-47fb-8651-E0146D80CE9B}",
        "EA-Package": "OSLO-Installatie",
        "EA-Type": "CLASS",
        "EA-Parents": "",
        "EA-Parents2": [
          {
            "name": "ConstructiefObject",
            "label": "Constructief object",
            "package": "OSLO-Abstracten",
            "uri": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
          }
        ],
        "parentclasses": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#ConstructiefObject",
        "label": {
          "nl": "Heftoren"
        },
        "definition": {
          "nl": "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."
        },
        "usage": "",
        "ap-label-nl": {
          "nl": "Heftoren"
        },
        "ap-definition-nl": {
          "nl": "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."
        },
        "ap-usageNote-nl": "",
        "ap-codelist": "",
        "RawTags": [
          {
            "key": "beheerstatus",
