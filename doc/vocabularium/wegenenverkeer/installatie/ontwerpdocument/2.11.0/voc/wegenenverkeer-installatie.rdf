  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Landhoofd.funderingsAanzetOnderDeBodemVanDeWaterweg">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Geeft aan of er een funderingsaanzet is onder de bodem van de waterweg, al dan niet.</rdfs:comment>
