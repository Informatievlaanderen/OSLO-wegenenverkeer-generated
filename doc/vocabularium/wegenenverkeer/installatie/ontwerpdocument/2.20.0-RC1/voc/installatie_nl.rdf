  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Onderrolwagen.gewicht">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het gewicht van de wagen, uitgedrukt in kilogram.</rdfs:comment>
