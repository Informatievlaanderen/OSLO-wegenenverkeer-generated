    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Duingrasland",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Duingrasland"
      },
      "usage": {
        "nl": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
      },
      "usageNote-nl": {
        "nl": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
      },
      "definition": {
        "nl": "G5a - Zanddoddengras, Kleverige reigersbek, Ruw vergeet-mij-nietje, Kruipend stalkruid, Zandhoornbloem, Duinfakkelgras, Liggende asperge, Duindravik, Duinviooltje, Kegelsilene, Ruwe klaver, Duin- en gewimperd langbaardgras, Lathyruswikke, Geel walstro, Grote tijm, Geel zonneroosje, Liggend bergvlas, Nachtsilene, Walstrobremraap, Kalkbedstro, Zachte haver, Voorjaarsganzerik, Duindravik, Gestreepte klaver, Wondklaver."
      },
      "label": {
        "nl": "Duingrasland"
      },
      "definition-nl": {
        "nl": "G5a - Zanddoddengras, Kleverige reigersbek, Ruw vergeet-mij-nietje, Kruipend stalkruid, Zandhoornbloem, Duinfakkelgras, Liggende asperge, Duindravik, Duinviooltje, Kegelsilene, Ruwe klaver, Duin- en gewimperd langbaardgras, Lathyruswikke, Geel walstro, Grote tijm, Geel zonneroosje, Liggend bergvlas, Nachtsilene, Walstrobremraap, Kalkbedstro, Zachte haver, Voorjaarsganzerik, Duindravik, Gestreepte klaver, Wondklaver."
