    <rdfs:comment xml:lang="nl">Hoogte die door gebruikers kan gehanteerd worden voor vervoer, rekening houdend met voorwerpen die aan de koker bevestigd zijn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Koker"/>
    <rdfs:range rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Koker.ontwerpbelasting">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De ontwerpbelasting is de maximale belasting die een constructie kan opnemen zonder te bezwijken.</rdfs:comment>
