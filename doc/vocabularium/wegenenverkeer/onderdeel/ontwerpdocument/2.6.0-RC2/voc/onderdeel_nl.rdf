<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#LigtOp'>
<rdfs:comment xml:lang='nl'>Deze relatie geeft aan dat 2 onderdelen direct fysiek op elkaar liggen. Deze relatie heeft een richting en gaat van het bovenste naar het onderste onderdeel.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DirectioneleRelatie' />

</owl:Class>

