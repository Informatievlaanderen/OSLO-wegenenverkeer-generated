  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Geleiding> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#GrondankerVerdeelplaat> a owl:Class;
  rdfs:comment "Dikke staalplaat tussen de te verankeren constructie en ankerkop. Wordt toegepast om de ankerkracht te spreiden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Groutpaal> a owl:Class;
  rdfs:comment "In de grond gevormde paal waar d.m.v. hoge druk de grond met water-cementmengsel (grout) wordt vermengd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Hoogtedetectie> a owl:Class;
  rdfs:comment "Hoogtedetectiesysteem voor het voorkomen van schade aan kunstwerken. Stuurt vaak een dynamisch bord aan. Voor handhaving staat het in relatie met een ANPR-camera."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Injectiepaal> a owl:Class;
  rdfs:comment "Trillingsvrij in de grond gevormde stalen buisschroefpaal, waarbij tijdens of na het schroef/draaiproces een mengsel van water en cement (= grout) door de holle boorschacht wordt geïnjecteerd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Kabelmof> a owl:Class;
  rdfs:comment "Een verbindingsgreep die aansluitingen van kabels rondom afsluit."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#KringsBerliner> a owl:Class;
  rdfs:comment "Een grond- en/of waterkerende constructie, die bestaat uit een verticaal in de grond geplaatste wand."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#KunststoffenDamplank> a owl:Class;
  rdfs:comment "Een grondkerende plank, vervaardigd uit kunststof (bv. PVC, glasvezel, composiet, ...), die kan bestaan in verschillende plankvormen. De plank weegt minder dan beton, hout of staal."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DamplankAbstracte> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LetterCijferMarkering> a owl:Class;
  rdfs:comment "Een markering bestaande uit individuele letters en/of cijfers."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FiguratieMarkeringToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Lockermanagementmodule> a owl:Class;
  rdfs:comment "Inrichting voor het beheer van lockerkasten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#MIVLus> a owl:Class;
  rdfs:comment "Meten in Vlaanderen : inductieve lus,ingeslepen in het wegdek."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#MIVProcessorkaart> a owl:Class;
  rdfs:comment "Meten in Vlaanderen : processorkaart van de lokale verwerkingseenheid."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Micropaal> a owl:Class;
  rdfs:comment "In de grond gevormde paal met kleine diameter die bestaat uit een stalen inbouwelement (staaf) waarrond een groutkolom wordt gevormd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Motorsturing> a owl:Class;
  rdfs:comment "Type voor verschillende technieken voor de aansturing van de snelheid (toerental) van een motor."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#MotorVermogenskring>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#NietStandaardStalenProfiel> a owl:Class;
  rdfs:comment "Een stalen constructie-element waarvan de lengte vele malen groter is dan de breedte en de hoogte in doorsnede. Niet-standaard stalen profiel omvat alle speciale,op maat gemaakte en/of niet vaak voorkomende profielen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#StalenProfiel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Noodstopknop> a owl:Class;
  rdfs:comment "Een knop waarmee de werking van een machine of installatie koste wat het koste onmiddellijk stilgelegd wordt. Ook noodstopschakelaar genoemd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Onderwaterkruising> a owl:Class;
  rdfs:comment "Gebruikt voor de registratie van kenmerken en geometrie van een ruimte waar kabels en leidingen onder een waterweg door gaan."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Ontvanger> a owl:Class;
  rdfs:comment "Toestel voor het opvangen van signalen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ZenderOntvangerToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Oplegging> a owl:Class;
  rdfs:comment "Een oplegging of steunpunt is een element dat is vastgemaakt aan de vaste ondergrond (vb. aan het landhoofd) of aan een ander constructiedeel. Een oplegging beperkt hier de beweging van het bewegend lichaam (vb. van de brugklap). Een oplegging kan ook een dempend effect hebben bij het sluiten van een bewegend lichaam."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PLC> a owl:Class;
  rdfs:comment "Een verwerkingseenheid die volgens een vaste cyclus op basis van informatie van zijn ingangen, zijn uitgangen aanstuurt op basis van zijn programma. Omwille van zijn vormfactor kan de eenheid gebruikt worden in een vijandige omgeving."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Controller>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Persleiding> a owl:Class;
  rdfs:comment "Ondergronds kanaal of pijp voor afvoer van een vloeistof of gas onder druk."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Buis> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Pictogram> a owl:Class;
  rdfs:comment "Een bord dat een symbool of afbeelding bevat dat de plaats inneemt van een tekst."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BevestigingGC> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PlintGC> a owl:Class;
  rdfs:comment "Een plint is een betonnen balk/plaat die de akoestische dichtheid verzekert tussen de schermelementen van de geluidswerende constructie en de bodem."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BetonnenConstructieElement>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementenGC> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PoEInjector> a owl:Class;
  rdfs:comment "Een toestel waarmee stroom/voeding voor een ander toestel over een datakabel kan gestuurd worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Radiolistener> a owl:Class;
  rdfs:comment "Een radiotoestel om de verschillende uitgezonden radiozenders (FM en DAB+) of boodschappen te beluisteren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#IPNetwerkToegangObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Repeater> a owl:Class;
  rdfs:comment "Apparatuur die het ontvangen signaal versterkt doorgeeft."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ZenderOntvangerToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Riem> a owl:Class;
  rdfs:comment "Een riem of aandrijfriem zorgt voor het overbrengen van vermogen tussen twee riemschijven. Een riem is samen met een riemschijf en riemspanner onderdeel van een riemoverbrenging."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#SelectieveDetectielus> a owl:Class;
  rdfs:comment "De selectieve detectielussen moeten bepaalde voertuigen toelaten het kruispunt prioritair te dwarsen. Daarvoor zijn die prioritaire voertuigen uitgerust met een zendtoestel dat gecodeerd informatie doorstuurt naar een datalus in het wegdek. Deze lus is verbonden met een demodulator die de informatie decodeert en doorstuurt naar de verkeersregelaar van het te dwarsen kruispunt"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SelNietSelLus> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Signaalkabel> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De kabel zorgt primair voor de uitwisseling van digitale en analoge stuursignalen tussen twee onderdelen, bv. tussen een sensor en een verwerkingseenheid. De sturing verloopt in principe via lagere spanning. In voorkomende gevallen kan die ook met gewone netspanning gebeuren om de gekoppelde techniek van stroom te voorzien. De sturing primeert evenwel op het loutere transport van spanning en vermogen. "@nl;
  rdfs:comment "Kabel die primair zorgt voor het uitwisselen van digitale en analoge stuursignalen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kabel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Slemlaag> a owl:Class;
  rdfs:comment "Een slemlaag (slem) is een oppervlaktebehandeling die bestaat uit een mengsel dat ter plaatse bereid en verwerkt wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AndereLaag> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Sleufbekisting> a owl:Class;
  rdfs:comment "Een kistsysteem (synoniemen: boxen, Verbau-systeem of grootvlakbeschoeiing) om sleuven/bouwputten te beschoeien. De kist kan op verschillende manieren opgebouwd worden. Enkel grondkerend en bedoeld als tijdelijke beschoeiing."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Stopcontact> a owl:Class;
  rdfs:comment "Een aansluitpunt op het elektrisch net voor afname van elektrische energie met behulp van een stekker."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Stuurklep> a owl:Class;
  rdfs:comment "Een afsluiter die vanop afstand bediend wordt om te bepalen of er al of niet vloeistof of gas door de leiding stroomt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Telecomkabel> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Hierin komen alle telecomkabels. Bij twijfel of een kabel tot elektriciteit of telecom behoort wordt gekozen voor elektriciteitskabel omdat dit het meeste risico inhoudt bij graafwerken."@nl;
  rdfs:comment "Een aansluiting of reeks aansluitingen van een nutsvoorzieningennet voor het overbrengen van data van de ene locatie naar een andere."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kabel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#ThermoHygrometer> a owl:Class;
  rdfs:comment "Een meettoestel dat de temperatuur en vochtigheid van een omgeving of medium meet. Het meetresultaat wordt omgezet in een uitleesbaar signaal."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Sensoropstelling> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Toegangscontrole> a owl:Class;
  rdfs:comment "Component voor controle van de toegang tot een ruimte of behuizing."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#TrottoirbandStd> a owl:Class;
  rdfs:comment "Gestandaardiseerde kantopsluiting,bestemd om de rand van de verharding te beschermen en te versterken."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#GestandaardiseerdeKantopsluiting> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#TrottoirbandWatergreppelStd> a owl:Class;
  rdfs:comment "Gestandaardiseerde kantopsluiting, die een trottoirband en een watergreppel combineert in een geheel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#GestandaardiseerdeKantopsluiting> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Veiligheidsrelais> a owl:Class;
  rdfs:comment "Relais voor de bewaking van de noodstop binnen het noodstopcircuit. Voldoet omwille aan specifieke vereisten om te vermijden dat een storing tot een verlies van de veiligheidsfunctie kan leiden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Verankeringslandhoofd> a owl:Class;
  rdfs:comment "De verankeringsconstructie aan het einde van een cementbetonverharding."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Verkeersspiegel> a owl:Class;
  rdfs:comment "Een verkeersspiegel is een spiegel die de zichtbaarheid verbetert van het aankomende verkeer."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Signalisatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Verwarmingselement> a owl:Class;
  rdfs:comment "Toestel dat het verwarmingslint van warmte voorziet afhankelijk van de omgevingstemperatuur."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#VlakGeluidsschermelement> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De technische fiche van \"Geluidsschermelementen\" bevat extra informatie over: kleurvariatie/kleurverloop, mate van profilering van de absorberende laag, statische belasting, gedetailleerde materiaalspecificaties, of er gebruik wordt gemaakt van een draadpaneel om beplanting op te laten groeien, de eventuele kromming van de schermelementen en ook in welke mate het scherm naar voor of naar achter helt."@nl;
  rdfs:comment "Een vlak scherm zijn alle schermtypes die getest kunnen worden volgens de normen NBN EN 1793-1 NBN EN 1793-2."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Geluidsschermelement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Voedingskabel> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> """Het gaat om voedingskabels die niet behoren het het openbaar nutsvoorzieningennet. Binnen het eigen netwerk kan een entiteit de voedingskabels ter beschikking stellen en beheren voor anderen binnen dezelfde (overkoepelende) entiteit. Ook in dat geval is er nog steeds sprake van voedingskabels.
"""@nl;
  rdfs:comment "Zorgt voor het overbrengen van een elektrisch vermogen van de ene locatie naar de andere binnen een privaat netwerk. Onder dit type vallen ook installatiedraden die beschouwd worden als kabels met slechts één ader."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kabel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#WVLichtmast> a owl:Class;
  rdfs:comment "Paal voorzien van armen voor het bevestigen van wegverlichtingstoestellen. Omvat het deurtje, klemmenblok, montagekastje, de bevestigingsmaterialen (bv. voetplaten) en fundering of verankeringsmassief. Gebruik Lichtmast voor de bevestiging van andere toestellen dan wegverlichting."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Lichtmast> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegdekvoeg> a owl:Class;
  rdfs:comment "Dwarsvoegen en langsvoegen met uitzondering van de krimpvoegen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#WeggebondenDetector> a owl:Class;
  rdfs:comment "Weggebonden detectoren zijn draadloze in het wegdek geïntegreerde radars of magnetische inductiesensoren. Ze zitten ingebed in een cilinder, die geplaatst wordt in het wegdek en die draadloos communiceert met een access point die met de verkeersregelaar verbonden is"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Detectie>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FirmwareObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wentellager> a owl:Class;
  rdfs:comment "Een wentellager of rollend lager is een lager waarin de wrijving wordt verminderd door het gebruiken van rollende elementen tussen de as en de boring. Afhankelijk van de aard en de vorm van het rollend element, spreken we van cilinderlagers, diabololagers, kegellagers, kogellagers, naaldlagers, bollagers of tonlagers."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Lager> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Windmeter> a owl:Class;
  rdfs:comment "Een meettoestel dat windsnelheid en/of windrichting meet. Het meetresultaat wordt omgezet in een uitleesbaar signaal."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Sensoropstelling> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zender> a owl:Class;
  rdfs:comment "Een apparaat dat signalen uitzendt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ZenderOntvangerToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aansluitopening> a owl:Class;
  rdfs:comment "Een kleine doorgang in de wand tussen twee kamers, of aan het begin van een leiding."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#AlarmModule> a owl:Class;
  rdfs:comment "Module binnen een installatie, waar de verschillende alarmen van andere modules toekomen, en die via het netwerk doorgestuurd kunnen worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#IPNetwerkToegangObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BestratingVanBetonstraatsteen> a owl:Class;
  rdfs:comment "Bestrating van geprefabriceerde stenen in beton die (in de afgesproken mate) voldoen aan de vereisten van NBN EN 1338 en NBN B21-311."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Bestrating> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BitumineuzeLaag> a owl:Class;
  rdfs:comment "Flexibele verharding die meestal uit bitumineus gebonden materialen (asfalt of gietasfalt) bestaat en laagsgewijs wordt aangelegd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LaagBouwklasse> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Breedplaat> a owl:Class;
  rdfs:comment "Geprefabriceerd structuurelement dat over de volledige lengte voorzien is van minstens 2 driedimensionale tralieliggers en dat bestemd is om de meewerkende onderkant te vormen van een dragende brugdekplaat of van een bouwkundige constructie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BypassSchakelaar> a owl:Class;
  rdfs:comment "Een schakelaar die toelaat om de stroomtoevoer naar afnemende technieken via het geschakeld toestel zoals een UPS, te omzeilen en te isoleren om veilig te kunnen werken aan dat toestel terwijl de stroomtoevoer voor afnemende technieken verzekerd blijft."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Cabine> a owl:Class;
  rdfs:comment "Een behuizing voornamelijk bestemd voor het beschermen van elektromechanische technieken waarin het omwille van de grootte en toegankelijkheid mogelijk is om rond te lopen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Inloopbehuizing> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Codeklavier> a owl:Class;
  rdfs:comment "Toestel voor het aansturen van een asset op basis van ingetoetste codes."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Display> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Daar waar een monitor algemeen ingezet kan worden, is een display ontworpen voor gebruik bij een specifieke techniek.  Een display kan signalen verwerken volgens een eigen logica en verschilt daarin van Controlepaneel."@nl;
  rdfs:comment "Een display is een elektrisch apparaat, ingebed in een techniek, waarop informatie visueel afgebeeld wordt. en dat kan gebruikt voor sturing van die techniek."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Drukknop> a owl:Class;
  rdfs:comment "Drukknoppen zijn de toestellen die opgesteld zijn op kruispunten om de aanwezigheid te melden van voetgangers of fietsers die de rijweg wensen over te steken of voor het aanmelden van openbaar vervoer. De toestellen sturen een geheugenelement (module voor de sturing en visualisatie) in de verkeersregelaar aan, zodanig dat een kortstondig indrukken van de drukknop of kortstondig aanraken van de sensor volstaat opdat de aanvraag tot doorgang blijft gelden tot de doorgang verleend wordt"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#NietWeggebondenDetectie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAfmetingNetwerkelement> a owl:Class;
  rdfs:comment "Complex datatype voor de afmetingen van een netwerktelement."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcBeschermingVraatschade> a owl:Class;
  rdfs:comment "Complex datatype voor bescherming van de stam tegen knaagdieren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcExterneReferentie> a owl:Class;
  rdfs:comment "Complex datatype waarmee een referentienummer zoals gekend bij de externe partij bv. aannemer, VLCC, ... kan toegevoegd worden aan object."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcGrondbijmenging> a owl:Class;
  rdfs:comment "Complex datatype om extra informatie van de bijmenging van grond te capteren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtuAfmetingGrondvlak> a owl:Class;
  rdfs:comment "Datatype voor de afmeting van een (grond)vlak volgens zijn vorm."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtuWvLichtmastBevsToestelMethode> a owl:Class;
  rdfs:comment "Union datatype voor de wijze waarop verlichtingstoestellen bevestigd zijn op een lichtmast, indien dit een standaard methode is dan kan deze geselecteerd worden uit een keuzelijst. Bij afwijkende methode kan de methode toegelicht worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DynBordExternePU> a owl:Class;
  rdfs:comment "Externe stuureenheid die buiten het dynamisch bord bevestigd is, in de buurt van de openbare weg. Het betreft dus geen stuureenheid in een serverroom, noch een stuureenheid op het bord zelf."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PU> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Fietstelsysteem> a owl:Class;
  rdfs:comment "Toestel bij de fietstelinstallatie dat gegevens van detectielussen over passerende fietsers verzamelt en verwerkt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#FiguratieMarkering> a owl:Class;
  rdfs:comment "Een markering als figuratie op de weg aangebracht om het verkeer te waarschuwen, informeren of regelen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FiguratieMarkeringToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Galgpaal> a owl:Class;
  rdfs:comment "De galgpalen zijn bestemd voor het bevestigen van verkeerslichten, signaalborden, wegwijzers boven het wegdek. Bovendien laten zij het bevestigen toe van één of meerdere lantaarns van het type 200 op de paalschacht. De draagwijdte van de arm moet kunnen reiken tot 9 m. De galgpalen beantwoorden aan SB270-51-6.15"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VRIDraagconstructie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Grindkern> a owl:Class;
  rdfs:comment "In de grond gevormd of vrijgestort cilindrisch element uit grind dat door heien of trillen wordt verdicht."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Hardware> a owl:Class;
  rdfs:comment "Fysieke componenten of onderdelen van een computer."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#HardwareToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#HeeftBetrokkene> a owl:Class;
  rdfs:comment "Koppelt een natuurlijk persoon,rechtspersoon of een hoedanigheid (een functie eerder dan de persoon die de functie uitoefent) aan een object in een bepaalde rol."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DirectioneleRelatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Huisaansluitput> a owl:Class;
  rdfs:comment "Het constructieonderdeel (putje of T-stuk) dat de verbinding vormt tussen de private riolering en de huisaansluiting."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Put>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PutRelatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Hulpstuk> a owl:Class;
  rdfs:comment "Stukken die zorgen voor verbindingen tussen buizen en/of leidingen om bv. van richting te veranderen,te verlengen,te verlopen van diameter,meerdere buizen op mekaar aan te sluiten,..."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#OmhullendeInrichting>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Hydrant> a owl:Class;
  rdfs:comment "Aftappunt van de brandleiding bedoeld voor de brandweer. Ook brandkraan genoemd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Brandvoorziening> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#InwendigVerlichtPictogram> a owl:Class;
  rdfs:comment "Verlichtingstoestel om de aandacht te vestigen op een pictogram dat erop bevestigd is."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#KabelnetToegang> a owl:Class;
  rdfs:comment "Knooppunt van Kabelnet dat toegang geeft tot de informatie die in Kabelnet bewaard wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#KantstrookStd> a owl:Class;
  rdfs:comment "Gestandaardiseerde kantopsluiting, bestemd om de verharding steun te geven."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#GestandaardiseerdeKantopsluiting> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LijnvormigElementMarkering> a owl:Class;
  rdfs:comment "Een markering van een lijnvormig element om de zichtbaarheid te verhogen om het verkeer te waarschuwen, informeren of regelen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Markering>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AOWSType> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Lockerkast> a owl:Class;
  rdfs:comment "Een lockerkast is een geheel dat onderverdeeld is in een aantal kleinere en smallere opslagruimtes, bedoeld voor het opslaan van persoonlijke goederen of bezittingen. De lockers kunnen vaak afzonderlijk geopend en afgesloten worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kast> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Meetcel> a owl:Class;
  rdfs:comment "Een cel voorzien met uitrusting voor het meten van het energieverbruik aan de hoogspanningszijde van de transformator."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Meetmicrofoon> a owl:Class;
  rdfs:comment "Een microfoon is een elektromechanisch instrument dat geluid omzet in een elektrisch signaal. Een meetmicrofoon registreert de geluidsdruk, is gevoelig voor geluid uit alle richtingen en heeft een vlakke frequentiekarakteristiek. Nauwkeurigheid is hier belangrijker dan geluidskwaliteit. In een tunnel meet de microfoon het geluidsniveau in de tunnel om het volume van een luidspreker aan te kunnen passen om zo verstaanbaar mogelijk te communiceren. "@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Motorvangplank> a owl:Class;
  rdfs:comment "Een constructie geïnstalleerd aan een geleideconstructie of in de onmiddellijke omgeving ervan,met als doel de ernst van een botsing van een motorrijder met de geleideconstructie te reduceren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AfschermendeConstructie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#NietSelectieveDetectielus> a owl:Class;
  rdfs:comment "Een niet-selectieve detectielus werkt onder invloed van een wijziging in de zelfinductie van een lus in het wegdek wanneer het metaal van een voertuig binnen het gevoeligheidsgebied van de lus komt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SelNietSelLus> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstort> a owl:Class;
  rdfs:comment "Een overstort is een drempel tussen twee kamers waar water vanaf een bepaald peil van de ene naar de andere kamer kan stromen. Tussen twee kamers kunnen een of meerdere overstorten voorkomen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PMU> a owl:Class;
  rdfs:comment "Zorgt voor de specifieke stroomvereisten van de sensoren zodat de sensoren altijd een geschikte en stabiele stroom ontvangen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Plantbakvorm> a owl:Class;
  rdfs:comment "Beplanting die niet in volle grond werd aangebracht, maar in bakvorm."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VegetatieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Rioleringsbuis> a owl:Class;
  rdfs:comment "Ondergronds kanaal of pijp voor gravitaire afvoer van water."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Buis> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#SchampkantStd> a owl:Class;
  rdfs:comment "Gestandaardiseerde kantopsluiting, die zones van voertuigenverkeer onderling of voertuigenzones van andere verkeerszones scheidt en de overschrijding door voertuigen bemoeilijkt maar geen voertuigkerende functie heeft."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#GestandaardiseerdeKantopsluiting> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#SignaalControleModule> a owl:Class;
  rdfs:comment "Een controlemodule dat nagaat of een specifiek (meestal DC-)signaal nog aanwezig is of dat de signaal/ruis-verhouding niet te laag is."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Signaalfilter> a owl:Class;
  rdfs:comment "Een frequentiegestuurde module (in het bereik van 0 Hz tot 20 kHz) dat bepaalde frequentiebereiken kan versterken, doorlaten of verzwakken."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Slagboomarm> a owl:Class;
  rdfs:comment "De bewegende arm van een slagboominstallatie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Sleuf> a owl:Class;
  rdfs:comment "Lijnvormige verdieping van de natuurlijke ondergrond, nodig voor het leggen van leidingen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Spankabel> a owl:Class;
  rdfs:comment "Een kabel die gebruikt kan worden als externe naspanning of als wapening."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Tijdschakelaar> a owl:Class;
  rdfs:comment "Een apparaat met een interne klok dat een stuursignaal uitstuurt nadat de klok een specifiek tijdsinterval heeft opgemeten. Ook klokschakelaar of timer genoemd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#VerlichtingstoestelNaHP> a owl:Class;
  rdfs:comment "Het geheel van de natrium hoge druk lamp (NaHP) en de behuizing die werden samengesteld met als doel: * de lichtstroom van de lichtbronnen hoofdzakelijk op het te verlichten oppervlak (doorlopende wegsectie, conflictgebied,...) te richten, teneinde de zichtbaarheid te verhogen; * de lichtstroom te beheersen zodat de weggebruikers niet verblind worden en de lichthinder beperkt wordt; * het optisch systeem, de lichtbronnen en de hulpapparatuur tegen uitwendige invloeden te beschermen"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VerlichtingstoestelConnector>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verlichtingstoestel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#WaterdoorlatendeBestrating> a owl:Class;
  rdfs:comment "Betonstraatstenen of betontegels die omwille van hun vormkenmerken (bv. drainageopeningen of verbrede voegen) of betonstructuur (poreus beton met een open korrelopbouw) water doorlaten zoals omschreven in PTV 122."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Bestrating> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#WatergreppelStd> a owl:Class;
  rdfs:comment "Gestandaardiseerde kantopsluiting, bestemd om water van de verharding op te vangen en af te voeren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#GestandaardiseerdeKantopsluiting> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Weegcel> a owl:Class;
  rdfs:comment "Een toestel dat op basis van druk het gewicht meet van een object dat er rechtstreeks of via een tussenliggende plaat bovenop geplaatst wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Weegcomputer> a owl:Class;
  rdfs:comment "Een verwerkingseenheid met als input de weeggegevens van de weegcellen en output het gewicht."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast> a owl:Class;
  rdfs:comment "Behuizing in de vorm van een kast typisch gebruikt buiten,langs de kant van de weg."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Buitenkast> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Zonnepaneel> a owl:Class;
  rdfs:comment "Toestel om elektrische energie op te wekken uit zonlicht met als doel het voeden van een installatie. Ook wel fotovoltaïsche cellen of zonnecellen genoemd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Voedingspunt>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BevestigingGC> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#AIDModule> a owl:Class;
  rdfs:comment "Aparte hardware module voor automatische incidentdetectie op camerabeelden. De module kan centraal of lokaal opgesteld staan maar altijd als apart onderdeel, niet als deel van de camera die de beelden doorstuurt. Ze kan gebruikt worden voor modules die analoge beelden analyseren en voor modules die werken op basis van digitale beelden. Het doel is om op een automatische en zo intelligent mogelijk manier gebeurtenissen uit de beelden van een CCTV-camera te halen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Armatuurcontroller> a owl:Class;
  rdfs:comment "Controller die op het verlichtingstoestel wordt gemonteerd en die één verlichtingstoestel aanstuurt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Communicatieapparatuur>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FirmwareObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Audioversterker> a owl:Class;
  rdfs:comment "Elk toestel dat een inkomend audiosignaal omzet naar een signaal dat meerdere luidsprekers kan aansturen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BetonnenConstructieObject> a owl:Class;
  rdfs:comment "Een generiek betonnen constructie-element dat op maat gemaakt is. Dit gaat niet over een (standaard) betonnen profiel of plaat, maar over een specifiek gevormd betonnen object."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BetonnenConstructieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BetonnenDamplank> a owl:Class;
  rdfs:comment "De geprefabriceerde damplank van beton wordt gebruikt bij hoge gronddruk en is meestal een permanente grondkering. Deze damplank is voorzien van een visbek/contra-visbek aansluiting."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DamplankAbstracte> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BetonnenHeipaal> a owl:Class;
  rdfs:comment "Betonnen paal die in de grond wordt gebracht door deze in een hei-installatie te plaatsen waarna men er een zwaar gewicht (heiblok) op laat vallen. De grond onder de paal wordt samengeperst waardoor de draagkracht groter wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BetonnenConstructieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Bevestigingsbeugel> a owl:Class;
  rdfs:comment "Verbindingsstuk waarmee een object kan vastgemaakt worden aan een steun of oppervlak."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BevestigingGC> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Brandblusser> a owl:Class;
  rdfs:comment "Een apparaat om het vuur van een kleine brand mee te doven. Het bestaat uit een cilinder waarin een beperkte hoeveelheid blusmiddel onder druk staat."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Calamiteitendoorsteek> a owl:Class;
  rdfs:comment "Een calamiteitendoorsteek, afgekort CADO, is een mechanische constructie voor het opklappen van een deel van de vangrail in de middenberm van een weg. Het primaire doel van de calamiteitendoorsteek is het doorlaten van hulpverleningsvoertuigen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Damwand> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.8.0 "@nl;
  rdfs:comment "Een grond- en/of waterkerende constructie,die bestaat uit een verticaal in de grond geplaatste wand."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Dichting> a owl:Class;
  rdfs:comment "Een element, machineonderdeel of constructie gebruikt om het naar buiten of naar binnen dringen of lekken van fluïda te voorkomen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcSoftwarePoortconfiguratie> a owl:Class;
  rdfs:comment "Complex datatype dat beschrijft welke poort voor welke service gebruikt wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtuAfmetingVerkeersbord> a owl:Class;
  rdfs:comment "Union datatype voor de afmeting van het verkeersbord."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DwarseMarkeringVerschuind> a owl:Class;
  rdfs:comment "Een schuine markering dwars op de weg aangebracht om het verkeer te waarschuwen, informeren of regelen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DwarseMarkeringToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#ExterneDetectie> a owl:Class;
  rdfs:comment "Inputsignalen bv. van een brug of een overweg, die door een externe partij doorgegeven worden teneinde de verkeersregelaar aan te sturen. Dit object wordt niet gebruikt voor eigen lussen van een ander kruispunt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Detectie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#GekleurdWegvlakMarkering> a owl:Class;
  rdfs:comment "Een markering van een wegdeel aangebracht om het verkeer te waarschuwen, informeren of regelen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Markering>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AOWSType> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Geotextiel> a owl:Class;
  rdfs:comment "Geotextiel om grondoppervlakken, taluds en/of bodems te beschermen tegen erosie door wind, golfslag en/of stroming van water, afkomstig hetzij van afstromende neerslag, hetzij van afvloeiend oppervlaktewater."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AndereLaag> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#HoutenConstructieprofiel> a owl:Class;
  rdfs:comment "Houten enkelvoudig constructie-element waarvan de lengte vele malen groter is dan de breedte en de hoogte in doorsnede. De breedte is weer gelijk of kleiner dan de hoogte. Dit profiel heeft een dragende functie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#HoutenConstructieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#IpPowerSwitch> a owl:Class;
  rdfs:comment "Een IP powerswitch levert netspanning (230V) aan achterliggende apparaten. Door in te loggen op de powerswitch kunt u de poort en dus de netspanning naar het aangesloten apparaat vanop afstand uit en aan zetten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Klimvorm> a owl:Class;
  rdfs:comment "Plant met buigzame stengels die zich aan muren,bomen,enz. hecht en zodoende omhoog klimt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VegetatieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LEDDriver> a owl:Class;
  rdfs:comment "Een LED-driver is een elektronisch toestel dat de stroomtoevoer naar de LED's dimensioneert om de goede werking te verzekeren. Via de instelparameters van de driver kan uiteindelijk de lichtsterkte van de LED verlichting aangepast worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Laagspanningsbord> a owl:Class;
  rdfs:comment "Verzameling van alle elektrische componenten nodig voor de voeding en sturing van applicaties die erop aangesloten zijn. Omvat onder andere automaten,klemmenblokken,..."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Luidspreker> a owl:Class;
  rdfs:comment "Een luidspreker is een apparaat waarmee elektrische signalen worden omgezet in geluid."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Motorbeveiligingsschakelaar> a owl:Class;
  rdfs:comment "Techniek voor het beveiliging van een moter tegen schade door overbelasting."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#MotorVermogenskring>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Neerslagsensor> a owl:Class;
  rdfs:comment "Detectie van neerslag(hoeveelheid/intensiteit)."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Sensoropstelling> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Onderbouw> a owl:Class;
  rdfs:comment "Gedeelte van het baanlichaam dat tussen het baanbed en de verharding ligt. Deze omvat onderfundering,fundering en de straatlaag."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LaagDikte>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Laag> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering> a owl:Class;
  rdfs:comment "Een markering overlangs op de weg aangebracht om het verkeer te waarschuwen, informeren of regelen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Markering>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AOWSType> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Slagboomkolom> a owl:Class;
  rdfs:comment "De koker van een slagboominstallatie die de motor bevat en waaraan de slagboomarm bevestigd is."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#SoortenrijkSchraalGraslandGraslandfase5> a owl:Class;
  rdfs:comment "G5 - Een fijn, soortenrijk mozaïek van geel-, grijs- en blauwgroene laagblijvende schijngrassen (zeggen en russen) en kruiden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Grasland> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Stroomverdelingssysteem> a owl:Class;
  rdfs:comment "Een stroomverdelingssysteem, ook wel Power Distribution Unit of PDU genoemd, is een inrichting met verschillende outputs voor het distribueren van elektriciteit."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef> a owl:Class;
  rdfs:comment "Een spiraalvormige schroef die toelaat vloeistoffen, sluries, of poeders te transporteren. De schroef, geplaatst in een gesloten of deels open buis, wordt aangedreven en draait rond zijn eigen as. Deze draaiende beweging leidt tot de verplaatsing van het te verplaatsen medium. Wanneer het medium in opwaartse richting getransporteerd wordt spreekt men van een pomp. Wanneer het medium in afwaartse richting beweegt en al doende de schroef doet draaien, spreekt men van een turbine. Wordt ook wel waterschroef, opvoerschroef, vijzelpomp, of een schroef van Archimedes genoemd. "@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PompSchroefEnWaaier> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Afsluiting> a owl:Class;
  rdfs:comment "Op het terrein ondubbelzinnig aanwijsbare en permanent verankerde scheiding."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Beschermbuis> a owl:Class;
  rdfs:comment "Een buis bestemd voor de doorvoer van kabels en/of leidingen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#OmhullendeInrichting>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Leiding> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BloemrijkGraslandGraslandfase4> a owl:Class;
  rdfs:comment "G4 - Fijn mozaïek van grassen, kruiden, russen en zeggen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Grasland> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Contactpunt> a owl:Class;
  rdfs:comment "Techniek voor het meten van een aan- of afwezigheid van contact tussen de onderdelen waaraan deze bevestigd is."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcCompacteBatterij> a owl:Class;
  rdfs:comment "Complex datatype waarmee de informatie, zoals merk, modelnaam, spanning, enz..., van de compacte batterij wordt verzameld."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcSierbeplAanleg> a owl:Class;
  rdfs:comment "Complex datatype voor dat de aanleg van sierbeplanting beschrijft."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcTrottoirbandVorm> a owl:Class;
  rdfs:comment "Complex datatype voor de vorm van een trotoirband."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Ecoraster> a owl:Class;
  rdfs:comment "Een geleiding om dieren te leiden naar een plaats (ecoduct, ecotunnel, ...) waar ze veilig een drukke weg kunnen oversteken."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ComplexeGeleiding> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#FiguratieMarkeringVerschuind> a owl:Class;
  rdfs:comment "Een schuine markering als figuratie op de weg aangebracht om het verkeer te waarschuwen, informeren of regelen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FiguratieMarkeringToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingsmassief> a owl:Class;
  rdfs:comment "Een fundering waarop een klein(er) object geplaatst wordt of er (in principe) onlosmakelijk in vastgezet wordt (vb.: een paal/een steun, een kleine sokkel,...) Als het grotere constructie-elementen betreft (vb.: een pijler, een gebouw,...), moeten andere onderdelen van fundering gebruikt worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Fundering> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Grond> a owl:Class;
  rdfs:comment "Lithologisch hoofd- en nevenbestanddeel (als code) van de laag zoals gebruikt bij Databank Ondergrond Vlaanderen (gecodeerde lithologie en geotechnische codering)."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LaagDikte>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Laag> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#IntercomServer> a owl:Class;
  rdfs:comment "Centrale module - inclusief configuratiesoftware - die de intercomtoestellen koppelt, bv. per tunnel of per complex, en een gateway opzet naar de centrale systemen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#IoTSensor> a owl:Class;
  rdfs:comment "Een sensor die veranderingen in de omgeving registreert en erop reageert."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LetterMarkeringVerschaald> a owl:Class;
  rdfs:comment "Een markering bestaande uit letters die een verschaling ondergaat zoals een vergroting en/of een verkleining."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FiguratieMarkeringToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#LuchtkwaliteitZenderOntvanger> a owl:Class;
  rdfs:comment "Onderdeel van de luchtkwaliteitsensor dat het signaal uitstuurt en ontvangt op basis waarvan de luchtkwaliteit gemeten wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Luchtkwaliteittoestel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Netwerkkaart> a owl:Class;
  rdfs:comment "Component van een NetwerkElement om specifieke verbindingen te leggen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Omvormer> a owl:Class;
  rdfs:comment "Een object, bijna altijd geplaatst in paar geplaatst, omvorming en \"de\"-omvorming, dat een signaal binnenneemt en terug uitstuurt maar dan op een andere manier. Er zijn een hele reeks manieren. - Omvorming waar er gewijzigd wordt van type kabel om dezelfde boodschap over te versturen, bv. omvorming van UTP naar Coax. - Omvorming van codering bv. analoog naar digitaal en in omgekeerde richting digitaal naar analoog (omvorming van codering analoog-digitaal verschilt van een encoder omdat een encoder een eindproduct aflevert; in dit geval is de omvorming ter ondersteuning het transport en zal er altijd een omvorming zijn terug naar analoog) - Omvorming die de gegevens opnieuw versterkt zodat ze over een langere afstand kunnen getransporteerd worden. Deze variant heeft niet noodzakelijk een tweede omvormer om terug te gaan naar het origineel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstortrand> a owl:Class;
  rdfs:comment "Een overstortrand heeft als doel het afvoeren van (pieken in) overtollig rioolwater vanuit de gemengde riolering naar het oppervlaktewater."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PTRegelaar> a owl:Class;
  rdfs:comment "Deze PT-module staat in voor het ontvangen en bewerken van telegrammen van voertuigen van het openbaar vervoer (bussen, trams)."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Rack> a owl:Class;
  rdfs:comment "Interne draagstructuur binnen een behuizing voor (elektromechanische) toestellen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord> a owl:Class;
  rdfs:comment "Verkeersbord met op het beeldvlak een tekening en/of tekst die worden weergegeven met een geëigend bekledingsmateriaal."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verkeersbord> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Ruigte> a owl:Class;
  rdfs:comment "Terrein of zoomvegetatie gedomineerd door ruigtekruiden of riet,die niet jaarlijks gemaaid wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#GrazigeVegetatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Segmentcontroller> a owl:Class;
  rdfs:comment "Controller die zorgt voor de bewaking en bediening van verlichtingssegmenten per paal en aldus zorgt voor de communicatie tussen de cabine en de armatuurcontrollers."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Controller> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Sokkel> a owl:Class;
  rdfs:comment "Onderdeel dat zich voornamelijk voornamelijk boven het maaiveld bevindt en als doel heeft het object dat er op rust te verhogen, het object te omhullen ter bescherming of de ondergrond te nivelleren. Afhankelijk van de grootte van dat object en van de omvang van de sokkel, kan die ook zorgen voor nodige stabiliteit zoals een fundering."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#StalenTrekstaaf> a owl:Class;
  rdfs:comment "Verbindingselement tussen 2 wanden, bv. ronde staven. Toegepast bij (passieve) ankerschotten, kofferdammen,..."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondanker> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Tandwielkast> a owl:Class;
  rdfs:comment "Systeem dat mechanisch vermogen van een motor omzet naar mechanisch vermogen met een kracht/snelheidsverhouding op maat van een bewegingsmechanisme."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Toestelventilator> a owl:Class;
  rdfs:comment "Ventilator met als primaire functie het afkoelen van een bepaald toestel, apparaat, of machineonderdeel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#VRCommunicatiekaart> a owl:Class;
  rdfs:comment "Modem die alle toestandswijzigingen van de stuurkaart doorgeeft aan het afstandsbewakingssysteem. De module maakt continue een backup van alle log en data gegevens en slaat deze op op de aanwezige SD kaart. Tevens wordt de module ook gebruikt om vanop afstand te kunnen communiceren met de regelaar"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VRModuleMetFirmware> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Ventilator> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De ruimtes in kwestie zijn groot tot middelgroot zoals bv. kasten, cabines, lokalen en groter. Een ventilator in de behuizing van een toestel die dient om het toestel te koelen, wordt als Toestelventilator toegevoegd aan de OTL."@nl;
  rdfs:comment "Onderdeel voor het creëren van luchtcirculatie binnen een open of gesloten ruimte met het oog op het vervangen van vervuilde door zuivere lucht. Voor een gesloten ruimte kan de luchtcirculatie ook zorgen voor afkoeling."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Ventilatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Weegsensor> a owl:Class;
  rdfs:comment "Registratie van de wieldruk van een voertuig (alle klassen). Dit wordt vertaald naar een massa."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#ZuilTGC> a owl:Class;
  rdfs:comment "Een zuil om badgelezers en videofoonposten op te plaatsen. Deze bevinden zich typisch aan slagbomen of automatische poorten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Afsluiter> a owl:Class;
  rdfs:comment "Een afsluiter dient om rioolstrengen af te sluiten bij bv. gebreken."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Antenne> a owl:Class;
  rdfs:comment "Toestel verbonden met een zender of ontvanger ten behoeve van het opvangen of verspreiden van signalen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Communicatieapparatuur> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Batterij> a owl:Class;
  rdfs:comment "Element bestaande uit meerdere elektrochemische cellen voor het leveren van elektriciteit,die ontstaat door de omzetting van opgeslagen chemische energie in elektrische energie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Voedingspunt>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Brandhaspel> a owl:Class;
  rdfs:comment "Een brandslang met spuitmond,opgerold op een haspel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Brandvoorziening> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Brugdekvoeg> a owl:Class;
  rdfs:comment "Voegconstructie die dient om een opening te overbruggen. Voldoende vervormbaar om zich te kunnen aanpassen aan de bewegingen van de boorden en weerstandbiedend om belastingen te kunnen opvangen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Buisbekleding> a owl:Class;
  rdfs:comment "De bekleding of coating ter bescherming van de buis."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Cementbetonverharding> a owl:Class;
  rdfs:comment "Stijve verharding met of zonder wapening verkregen door cementbeton te spreiden en mechanisch te verdichten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LaagBouwklasse> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcLENorm> a owl:Class;
  rdfs:comment "Complex datatype voor de norm van het lijnvormig element."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#FMRepeaterBox> a owl:Class;
  rdfs:comment "Een radio-ontvanger en -zender, die het FM-signaal ontvangt en weer doorgeeft om zo grotere afstanden te overbruggen en plaatsen te bereiken, waar de radiosignalen niet geraken, zoals in tunnels. De uitvoering is van het type 'box' waar aparte repeatermodules per frequentie of voor meerdere frequenties kunnen ingestoken worden, zoals in een vaste computer."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#IPNetwerkToegangObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Grasland> a owl:Class;
  rdfs:comment "Grazige vegetatie met daarin kruidachtigen die jaarlijks één of meerdere malen per jaar gemaaid of begraasd wordt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#GrazigeVegetatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#IOKaart> a owl:Class;
  rdfs:comment "Een kaart of module die gebruikt wordt voor de ingang of uitgang van een verwerkingseenheid (bv. een PLC). Op de IO-kaart worden perifere toestellen en sensoren aangesloten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Schacht> a owl:Class;
  rdfs:comment "Gedeelte van de put tussen regeling en de kamer."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PutRelatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#StalenBuispaal> a owl:Class;
  rdfs:comment "Volledig op lengte gelast element, meestal door middel van rondnaden, eventueel met inbegrip van de slotprofielen, die door middel van heien of pulsen op diepte wordt gebracht en nadien wordt opgevuld."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#StalenDamplank> a owl:Class;
  rdfs:comment "Slank geprofileerd stalen profiel, op de uiteindes voorzien van \"sloten\" om de planken met elkaar te verbinden en zodoende een continu gronddicht scherm te vormen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DamplankAbstracte>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#StalenConstructieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Stortsteen> a owl:Class;
  rdfs:comment "Natuursteen van onregelmatige vorm,meestal gebruikt voor verstevigings- en beschermingsdoeleinden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AndereLaag> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Struweel> a owl:Class;
  rdfs:comment "Een struweel is een met struiken begroeide oppervlakte dat minimaal 5 m breed is, minimaal 1 m hoog, maar meestal 2 tot 5 m hoog is. Een struweel is meestal meersoortig en vaak aan de rand van een bos terug te vinden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#HoutigeVegetatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Terugslagklep> a owl:Class;
  rdfs:comment "Een terugslagklep is een klep die dient om water, vloeistof, granulaat, poeder of gas in één richting door te laten. Meestal duwt het medium de klep bij het heenstromen open en sluit een veer of de zwaartekracht de klep."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Voorzetconstructie> a owl:Class;
  rdfs:comment "Een voorzetconstructie is een wandconstructie die vóór een bestaande muur wordt geplaatst. Doorgaans uitgevoerd met kleine spouw met isolatiemateriaal en aan de binnenzijde van het bouw- of kunstwerk."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BekledingComponent> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#ANPRCamera> a owl:Class;
  rdfs:comment "Nummerplaatherkenningscamera: een camera die als output de nummerplaat van een voertuig in tekst geeft en een foto van het deel van het voertuig waar de nummerplaat zich bevindt. Afhankelijk van het merk en type gecombineerd met een al dan niet bewegend overzichtsbeeld."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Bewegingssensor> a owl:Class;
  rdfs:comment "Een bewegingsmelder of aanwezigheidsmelder detecteert de beweging of aanwezigheid van een persoon, dier of object binnen een bepaalde zone. Het resultaat wordt omgezet in een uitleesbaar signaal."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Dompelpomp> a owl:Class;
  rdfs:comment "Een pomp die geheel in de te verpompen vloeistof wordt ondergedompeld. Ook klokpomp of onderwaterpomp genoemd. Voor kleinschalige dompelpompen gebruikt men ook de naam lekwaterpomp."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcOlieType> a owl:Class;
  rdfs:comment "Complex datatype om het type olie te beschrijven."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Kamer> a owl:Class;
  rdfs:comment "Een kamer is een aanééngesloten ondergrondse constructie waarbinnen vrije stroming van water over de bodem mogelijk is. Een constructie of inspectieput kan één of meerdere kamers hebben."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PutRelatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Schakelketting> a owl:Class;
  rdfs:comment "Een schakelketting bestaat uit een reeks met elkaar verbonden schakels. Ze worden doorgaans gebruikt om trekkrachten uit te oefenen, zoals bv. bij hijsinstallaties."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Schanskorf> a owl:Class;
  rdfs:comment "Een schanskorf bestaat uit een metalen gaasnet dat wordt gevuld met steenachtige materialen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AndereVerharding> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Silo> a owl:Class;
  rdfs:comment "Meestal een metalen reservoir voor eerder vaste vulmiddelen,zoals korrels,kristallen: zout,zand,enz,waarbij op een gecontroleerde manier middelen kunnen afgenomen of bijgevuld worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Software> a owl:Class;
  rdfs:comment "Geheel van computerprogramma's met bijbehorende data."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SoftwareToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Spanningsomvormer> a owl:Class;
  rdfs:comment "Een apparaat dat de invoerspanning kan omvormen om een andere uitvoerspanning te bekomen. Typisch is dit type apparaat ook in staat om de frequentie van de elektriciteit te veranderen. Het kan dus gelijkspanning omvormen naar wisselspanning (alternator of wisselrichter), wisselspanning naar wisselspanning van een andere frequentie, of wisselspanning naar gelijkspanning (gelijkrichter)."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS> a owl:Class;
  rdfs:comment "Toestel (Uninterruptible Power Supply = niet onderbreekbare voeding) voor het leveren van elektrische energie van een vastgelegde kwaliteit, onafhankelijk van de beschikbaarheid van een betrouwbare netspanning. Indien het openbare net niet langer bruikbaar is om als energiebron te fungeren, wordt de energievoorziening overgenomen door de accubatterij. Deze zal gedurende een bepaalde tijd, afhankelijk van de capaciteit, de stroomvoorziening verzorgen. De UPS dient om de (minimale) voeding ononderbroken te verzekeren"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Voedingspunt> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Ladder> a owl:Class;
  rdfs:comment "Een ladder is een constructie van verticale bomen met horizontale sporten die gebruikt wordt als klimmiddel/gereedschap."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Metselwerk> a owl:Class;
  rdfs:comment "Bouwconstructie met stenen waarbij metselspecie het verband tussen de stenen verzorgt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Netwerkpoort> a owl:Class;
  rdfs:comment "De ingang van het toestel samen met component die erop zit,bv. SFP of XFP."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie> a owl:Class;
  rdfs:comment "Een houtkant of een bos."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#HoutigeVegetatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PunctueleVerlichtingsmast> a owl:Class;
  rdfs:comment "Paal waarop punctuele verlichting van niet-beveiligde oversteekplaatsen bevestigd kan worden, inclusief deurtje, klemmenblok, montagekastje, bevestigingsmaterialen (bv. voetplaten) en fundering (bv. buisfundering) of verankeringsmassief. Deze wordt geschilderd in afwisselende stroken zwart/geel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMDraagconstructie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Straatkolk> a owl:Class;
  rdfs:comment "De hemelwaterinlaatconstructie,meestal geplaatst in de straatgoot of watergreppel,waarlangs het hemelwater van de verhardingen wordt afgevoerd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Put>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PutRelatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Transformator> a owl:Class;
  rdfs:comment "Elektrische apparatuur,bestaande uit magnetisch gekoppelde spoelen,die instaat voor het transformeren van de voedingsspanning."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Verkeersbordsteun> a owl:Class;
  rdfs:comment "Een draagconstructie voor verkeersborden. Dit kan een ronde paal of een vakwerksteun zijn."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Draagconstructie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Lichtmast> a owl:Class;
  rdfs:comment "Paal waarop een verlichtingstoestel of andere toestellen zoals een camera bevestigd kunnen worden met uitzondering van wegverlichting. Omvat het deurtje, klemmenblok, montagekastje, bevestigingsmaterialen (bv. voetplaten) en fundering (bv. buisfundering) of verankeringsmassief. Indien de paal gebruikt wordt voor wegverlichting moet het objecttype WVLichtmast gebruikt worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMDraagconstructie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Pomp> a owl:Class;
  rdfs:comment "Een pomp is een werktuig dat water verplaatst door er energie aan af te geven in de vorm van een drukverhoging of snelheidsverhoging."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LinkendElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#IntercomToestel> a owl:Class;
  rdfs:comment "Het toestel dat deel uitmaakt van een intercomsysteem en audio- en/of videocommunicatie tussen twee personen mogelijk maakt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Seinbrug> a owl:Class;
  rdfs:comment "Metalen constructie bestaande uit twee of meer verticale steunen met voetplaat en uit een enkele of een dubbel uitgevoerde horizontale dwarsverbinding, allen kokervormig met rechthoekige doorsnede. Ook wel portiek of portaal genoemd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VRIDraagconstructie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Verkeersregelaar> a owl:Class;
  rdfs:comment "Een verkeersregelaar is een programmeerbaar toestel dat de verkeerslichten op kruispunten kan regelen overeenkomstig een goedgekeurd verkeersplan. Een verkeersregelaar is bedoeld om het verkeer verkeersafhankelijk te sturen overeenkomstig het gedetecteerde verkeer. Verkeersregelaars kunnen op zichzelf werken of in groep ingeschakeld worden, zodoende op een gecoördineerde wijze de verkeersstromen te verwerken. Eveneens detecteert een verkeersregelaar defecte onderdelen, van zichzelf of van aangesloten installaties. Afhankelijk van het soort defect stuurt een verkeersregelaar een code uit opdat het euvel hersteld kan worden. Bij welbepaalde defecten worden verkeerslichten uitgeschakeld of op knipperstand gezet. Volgende documenten zijn specifiek van toepassing voor verkeersregelaars: *Koninklijk Besluit van 01.12.1975 (wegcode), aangevuld met alle officiële documenten hierover gepubliceerd; *NBN EN 12675:2000 (Verkeersregelapparaten - Functionele veiligheidseisen); *NBN EN 50556:2011 (Signalisatie voor wegverkeer; *NBN EN 12368:2006 (Verkeersregelinstallaties - Verkeerslantaars); *NBN EN 50293:2012 (Verkeersregelinstallaties - Elektromagnetische compatibiliteit)"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Badgelezer> a owl:Class;
  rdfs:comment "Een inrichting voor automatische authenticatie op basis van een badge."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FirmwareObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Netwerkelement> a owl:Class;
  rdfs:comment "Toestel,onderdeel van het netwerk zoals een backbone of IP-netwerk,waarop netwerkverbindingen kunnen aangelegd worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#RHZModule> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Tank> a owl:Class;
  rdfs:comment "Een constructie voor het opslaan van goederen,typisch in vloeibare of gasvormige toestand,zoals water,brandstof,aardgas,lucht,etc."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Bovenbouw> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.1.0 "@nl;
  rdfs:comment "Een combinatie van het riooldeksel met de kader en de regeling."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcHoutigeAanleg> a owl:Class;
  rdfs:comment "Complex datatype dat de aanleg van houtige vegetatie beschrijft."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Groutanker> a owl:Class;
  rdfs:comment "Stalen staaf of strengen die de trekkracht op de grondkering overdraagt op een groutlichaam. Dit lichaam wordt rond het anker onder hoge druk in de bodem gevormd. Door wrijving tussen grout en grond kan de kracht worden overgedragen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondanker> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PutBovenbouw> a owl:Class;
  rdfs:comment "Een combinatie van het riooldeksel met de kader en de regeling."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Boom> a owl:Class;
  rdfs:comment "Een opgaande boom is een boom waarvan de vorm van de kruin overeenkomt met zijn natuurlijke, soortgebonden habitus. Opgaande bomen kunnen een hoge, lage, brede, smalle of een afwijkende groeivorm hebben, zoals zuil- en treurvormen. De boom kan zich op volstrekt natuurlijke wijze uitgezaaid hebben en zijn groeivorm kan bepaald zijn door de natuurlijke groeiomstandigheden (bv. natuurlijke snoei). Ontstond de boom in kunstmatige omstandigheden, dan is de groeivorm bepaald door de jeugdsnoei in de kwekerij en is het eindbeeld van de boom bepaald door de begeleidingssnoei of vormsnoei die wordt uitgevoerd vanaf het planten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VegetatieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Camera> a owl:Class;
  rdfs:comment "Een CCTV-camera, closed-circuit television camera, kortweg camera, produceert beelden of opnames voor bewaking van een regio vanop afstand. Het is een element dat beelden neemt van een locatie en deze doorgeeft naar verschillende partijen om zo de werkelijke situatie te kunnen inschatten vanop afstand. Deze camera kan van het analoge type zijn of digitaal."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Elektromotor> a owl:Class;
  rdfs:comment "Een machine die elektrische energie omzet in mechanische energie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#HSBeveiligingscel> a owl:Class;
  rdfs:comment "Cel die de hoogspanningsschakelinrichting omvat. Hieronder vallen onder meer de lastscheidingsschakelaar,smeltveiligheden,aardingsschakelaar,..."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.0.0 "@nl;
  rdfs:comment "Een opgaande boom is een boom waarvan de vorm van de kruin overeenkomt met zijn natuurlijke, soortgebonden habitus. Opgaande bomen kunnen een hoge, lage, brede, smalle of een afwijkende groeivorm hebben, zoals zuil- en treurvormen. De boom kan zich op volstrekt natuurlijke wijze uitgezaaid hebben en zijn groeivorm kan bepaald zijn door de natuurlijke groeiomstandigheden (bv. natuurlijke snoei). Ontstond de boom in kunstmatige omstandigheden, dan is de groeivorm bepaald door de jeugdsnoei in de kwekerij en is het eindbeeld van de boom bepaald door de begeleidingssnoei of vormsnoei die wordt uitgevoerd vanaf het planten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VegetatieElement> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm> a owl:Class;
  rdfs:comment "Complex datatype om alle eigenschappen van de aanleg van een opgaande boom onder 1 noemer te houden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#VerlichtingstoestelLED> a owl:Class;
  rdfs:comment "Het geheel van de LEDlichtmodule en de behuizing die werden samengesteld met als doel: * de lichtstroom van de lichtbronnen hoofdzakelijk op het te verlichten oppervlak (doorlopende wegsectie, conflictgebied,...) te richten, teneinde de zichtbaarheid te verhogen; * de lichtstroom te beheersen zodat de weggebruikers niet verblind worden en de lichthinder beperkt wordt; * het optisch systeem, de lichtbronnen en de hulpapparatuur tegen uitwendige invloeden te beschermen De LED driver bevindt zich fysiek in het verlichtingstoestel maar wordt als een apart onderdeel behandeld."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VerlichtingstoestelConnector>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verlichtingstoestel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> a owl:Class;
  rdfs:comment "Diepfundering waarbij d.m.v. palen de belasting wordt afgedragen naar de diepe ondergrond. Enkel te gebruiken wanneer het type paal nog niet is vastgelegd bij ontwerp."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogen>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Fundering> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#GeluidswerendeConstructie> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.0.0 "@nl;
  rdfs:comment "Een geluidswerende wandvormige constructie bestaande uit een desgevallend geluidsisolerend materiaal en/of geluidsabsorberend materiaal en voorzien van de nodige structuren om de bouwkundige stabiliteit te verzekeren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LijnvormigElement> .

