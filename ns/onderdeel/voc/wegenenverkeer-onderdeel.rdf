        <rdfs:comment xml:lang="nl">Een kabel die gebruikt kan worden als externe naspanning of als wapening.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
