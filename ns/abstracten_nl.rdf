          <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ArtificieleLaag">
            <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
            <rdfs:comment xml:lang="nl">Abstracte als noemer om de abstracten Laag, LaagProductidentificatiecode en LaagDikte te groeperen.</rdfs:comment>
            <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Laag"/>
            <rdfs:subClassOf>
              <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LaagDikte">
                <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
