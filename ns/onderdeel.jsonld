  "publication-state": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard",
  "publication-date": "18-12-2024",
  "classes": [
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#AanvullendeGeometrie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Beschrijft een geometrie die aanvullend is bij de de werking van een asset maar beschrijft niet de asset zelf, bv. een detailplan of een werkingsgebied met een specifieke locatie, enz...De aanvullende geometrie kan al dan niet een bijlage bevatten."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#BehoortTot",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#BekrachtigdBij",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een rechtsgrond of legale verschijningsvorm krijgt volledige rechtskracht door instemming onder opschortende voorwaarde van een andere."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bekrachtigt",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Instemming onder opschortende voorwaarde van een rechtsgrond of legale verschijningsvorm op een andere zodat deze laatste volledige rechtskracht krijgt."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#BevatOntwerp",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#BevatOntwerpVoor",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#BevatVerkeersteken",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestiging",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Deze relatie heeft geen richting."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NietDirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bijlage",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een bestand (document,afbeelding,...) dat behoort tot 1 of meerdere assets."
      },
      "usage": {
        "nl": "Voor bijlagen die meerdere assettypes behandelen of aanvullende informatie bieden. Voor specifieke informatie van de asset, en waarvoor een eigenschap gedefinieerd is bv. technische fiche, detailplan, moet deze opgenomen worden via deze eigenschap."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Citeert",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een citatie in de wettelijke tekst. Dit omvat zowel woordelijke citaten als citaten in verwijzingen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Corrigeert",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Duidt aan dat deze rechtsgrond of legale verschijningsvorm tekstuele veranderingen zonder legale impact aanbrengt in een andere rechtsgrond of legale verschijningsvorm."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype om alle eigenschappen van de aanleg van een opgaande boom onder 1 noemer te houden."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcAfmetingNetwerkelement",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype voor de afmetingen van een netwerktelement."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcBSSRandafwerking",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype voor de afwerking van de rand van een betonstraatsteenverharding."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcBeschermingVraatschade",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype voor bescherming van de stam tegen knaagdieren."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcCompacteBatterij",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype waarmee de informatie, zoals merk, modelnaam, spanning, enz..., van de compacte batterij wordt verzameld."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcExterneReferentie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype waarmee een referentienummer zoals gekend bij de externe partij bv. aannemer, VLCC, ... kan toegevoegd worden aan object."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcGCMateriaalKarakteristiek",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype voor het materiaal en zijn geluidskarakteristiek van de geluidswerende constructie."
      },
      "parents": []
    },
