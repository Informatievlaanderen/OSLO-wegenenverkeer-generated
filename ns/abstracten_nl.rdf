    <rdfs:comment xml:lang="nl">Abstracte voor alle draagconstructies.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#DwarseMarkeringToegang">
