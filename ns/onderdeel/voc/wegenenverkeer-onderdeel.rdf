    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Verkeersregelaar.regelaartype">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Onderverdeling in type regelaar volgens het maximale aantal aan te sluiten seingroepen en kruispuntdetectoren.</rdfs:comment>
