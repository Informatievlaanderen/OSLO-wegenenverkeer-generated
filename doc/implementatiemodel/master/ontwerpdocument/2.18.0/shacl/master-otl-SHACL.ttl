  shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Centreerinrichting>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brugdek>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Stootblok>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug>,
