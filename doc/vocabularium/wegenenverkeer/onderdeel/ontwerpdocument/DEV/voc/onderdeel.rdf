  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsGerelateerdAan">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsInspectieVan">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De relatie geeft aan dat er een inspectie, proef of meting gedaan kan worden op een onderdeel of installatie. De bron van de relatie is de inspectie, het doel het onderdeel of de installatie waarbij de inspectie hoort.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsNetwerkECC">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie geeft aan hoe afgeschermde netwerkelementen bereikt kunnen worden vanuit het gewone netwerk. De relatie vertrekt steeds in het controlerende netwerkelement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsOnderdeelVan">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het besluit waarvan het artikel een onderdeel is.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsOntwerpVan">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">TODO</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsOntwerpVoor">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Mobiliteitsmaatregel die deel uitmaakt van het ontwerp</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsSWGehostOp">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie legt de link tussen een software en hardware onderdeel.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsSWOnderdeelVan">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie geeft de link aan tussen een software onderdeel en een ander software onderdeel waarbij de eerste bv. een service is van een grotere software.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#LigtOp">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie geeft aan dat 2 onderdelen direct fysiek op elkaar liggen. Deze relatie heeft een richting en gaat van het bovenste naar het onderste onderdeel.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Omhult">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OntwerpVanMaatregel">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">TODO</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OpgehevenBij">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan dat deze rechtsgrond of legale verschijningsvorm opgeheven is door een ander.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Realiseert">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Verwijst naar een extern element in een extern vocabularium.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord.fabricageDatum">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De datum waarop het bord werd gebouwd.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Verkeersbord met op het beeldvlak een tekening en/of tekst die worden weergegeven met een geëigend bekledingsmateriaal.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Verkeersbord"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord.fabricageType">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Genormaliseerde referentie waaraan het verkeersbord voldoet.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord.horizontaleVerschuiving">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De verschuiving van het bord, gemeten van het midden van het bord tot de centrale as van de opstelling. Een positieve waarde duidt op een verschuiving naar rechts, een negatieve waarde op een verschuiving naar links</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendeFolie.folietype">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het type folie dat bevestigd is aan het retroreflecterend verkeersbord.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendeFolie">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Retroreflecterend bekledingsmateriaal, bijvoorbeeld van een divergentiepuntbebakeningselement, retroreflecterende koker, of het beeldvlak van een retroreflecterend verkeersbord.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#SluitAanOp">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Sturing">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NietDirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#TrektIn">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan dat een rechtsgrond of legale verschijningsvorm een andere intrekt.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VeranderdDoor">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Duidt aan dat deze rechtsgrond een verandering met legale gevolgen heeft ondergaan door een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Verandert">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Duidt aan dat deze rechtsgrond een verandering met legale gevolgen doorvoert op een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Vereist">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Mobiliteitsmaatregel die vereist is om een inname tot stand te brengen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Vergunt">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Inname dat vergunt is in de innamevergunning.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VervangenBij">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan dat deze rechtsgrond of legale verschijningsvorm vervangen is bij een ander.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Vervangt">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Geeft aan dat een rechtsgrond of legale verschijningsvorm een andere vervangt.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VerwijdertMaatregel">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VerwijstNaar">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Artikel beschreven in de wegcode waarvan de verkeersmaatregel de uitvoering is.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt.aansluitspanning">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Spanning van de aansluiting, dit wordt enkel ingevuld op voedingsrelaties voorbij de hoofdschakelaar.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Deze relatie wordt enkel gelegd naar onderdelen die permanent onder spanning staan in normaal bedrijf. Aan deze relatie wordt steeds een richting toegekend van de voedinggever naar de ontvanger.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInVolt"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt.aansluitvermogen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Vermogen van de aansluiting, dit wordt enkel ingevuld op voedingsrelaties voorbij de hoofdschakelaar.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.1.0-RC2</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInVolt"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VoedtAangestuurd">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze relatie wordt enkel gelegd naar objecttypes die typisch een groot vermogen vereisen en onder spanning komen nadat het voedend element aangestuurd is om die spanning door te sturen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VoegtIn">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Deze rechtsgrond of legale verschijningsvorm voegt een verandering met legale impact in bij een andere.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#WordtAangeduidDoor">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Een verkeersteken dat bijdraagt tot de aanduiding van een mobiliteitsmaatregel.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"/>
  </owl:Class>
</rdf:RDF>
