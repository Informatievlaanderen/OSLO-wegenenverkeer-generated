<owl:ObjectProperty rdf:about='https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#BlindePut.materiaal'>
<rdfs:comment xml:lang='nl'>Het materiaal waaruit de blinde put is vervaardigd.</rdfs:comment>

<rdfs:domain>
