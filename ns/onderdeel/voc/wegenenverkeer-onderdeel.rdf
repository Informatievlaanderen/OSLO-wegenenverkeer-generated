  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#BetonnenBoorpaal.rekennota">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De rekennota van de boorpaal. Deze omvat o.a. het draagvermogen,... De rekennota wordt officieel afgetekend.</rdfs:comment>
