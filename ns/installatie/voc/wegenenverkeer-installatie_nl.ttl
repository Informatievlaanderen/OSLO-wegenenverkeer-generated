<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balansarm> a owl:Class;
  rdfs:comment "Onderdeel van een balans. Er kunnen één of meerdere balansarmen aanwezig zijn. Het is typisch een lange, horizontale arm die aan lastzijde via een trekker verbonden is met het beweegbare brugdeel ('het val' of ook 'de klap') en aan machtzijde het gebruik van tegengewicht mogelijk maakt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balgmechanisme> a owl:Class;
  rdfs:comment "Een mechanisme dat de beweegbare waterkerende constructie van een balgstuw beweegt door middel van lucht en/of waterdruk."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Bewegingsmechanisme> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balk.typeBalk> a owl:ObjectProperty;
