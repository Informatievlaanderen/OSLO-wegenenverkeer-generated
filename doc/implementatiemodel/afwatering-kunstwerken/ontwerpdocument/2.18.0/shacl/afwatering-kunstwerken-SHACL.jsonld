        {
          "@id": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/2.18.0#KoppelbalkShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
