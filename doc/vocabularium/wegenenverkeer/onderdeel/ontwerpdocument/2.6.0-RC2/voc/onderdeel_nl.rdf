</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.heeftBoomrooster'>
<ns0:usageNote xml:lang='nl'>Klasse uit gebruik sinds versie 2.0.0-RC3</ns0:usageNote>

<rdfs:comment xml:lang='nl'>Duidt aan of een horizontale structuur aanwezig is die zorgt voor een adequate bescherming van bomen tegen betreding van de boomspiegel door voetgangers of verkeer.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2001/XMLSchema#boolean' />

</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.heeftLuchtleiding'>
<ns0:usageNote xml:lang='nl'>Klasse uit gebruik sinds versie 2.0.0-RC3</ns0:usageNote>

<rdfs:comment xml:lang='nl'>Bepaling of een bovengrondse nutsleiding aanwezig is die in conflict kan komen met de boom.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2001/XMLSchema#boolean' />

</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.isVerplant'>
<ns0:usageNote xml:lang='nl'>Klasse uit gebruik sinds versie 2.0.0-RC3</ns0:usageNote>

<rdfs:comment xml:lang='nl'>Aanduiding of de opgaande boom al dan niet van locatie veranderd is na een eerste aanplant binnen het openbaar domein.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2001/XMLSchema#boolean' />

</owl:DatatypeProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.kroonDiameter'>
<ns0:usageNote xml:lang='nl'>Klasse uit gebruik sinds versie 2.0.0-RC3</ns0:usageNote>

<rdfs:comment xml:lang='nl'>Diameter van de kroonprojectie in meter.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.takvrijeStamlengte'>
<ns0:usageNote xml:lang='nl'>Klasse uit gebruik sinds versie 2.0.0-RC3</ns0:usageNote>

<rdfs:comment xml:lang='nl'>Tot aan de hoogte van de gewenste takvrije stamlengte wordt de boom zodanig gesnoeid dat er één doorgaande stam is.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.totaleBoombeschermingszone'>
<ns0:usageNote xml:lang='nl'>Klasse uit gebruik sinds versie 2.0.0-RC3</ns0:usageNote>

<rdfs:comment xml:lang='nl'>De straal van de cirkelvormige ruimte rond de boom waar maatregelen genomen worden om de boom te beschermen tijdens projecten of manifestaties uitgedrukt in centimeters.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.vrijeDoorrijhoogte'>
<ns0:usageNote xml:lang='nl'>Klasse uit gebruik sinds versie 2.0.0-RC3</ns0:usageNote>

<rdfs:comment xml:lang='nl'>Vrij te houden hoogte in meter, voor het doorrijden van verkeer toe te laten.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie.groeiplaatsverbetering'>
<rdfs:comment xml:lang='nl'>De techniek waarmee de groeiplaats wordt verbeterd met als doel de levensverwachting en de conditie van de vegetatie te verbeteren.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie.huidigNatuurbeeld'>
<rdfs:comment xml:lang='nl'>Bepaling van het vegetatietype op basis van terreininventarisatie.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie.natuurstreefbeeld'>
<rdfs:comment xml:lang='nl'>Een natuurstreefbeeld is een nagestreefd biotoop, mozaïek van biotopen of een leefgebied van een soort dat je wil behouden of verkrijgen via een goed natuurbeheer. In het definitief plan van type twee, drie of vier wordt het ecologisch einddoel vastgesteld aan de hand van natuurstreefbeelden.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie.type'>
<rdfs:comment xml:lang='nl'>Het type van de opgaande houtige vegetatie.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OpgaandeHoutigeVegetatie' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Oplegging.bewegingsvrijheidInHetVlak'>
<rdfs:comment xml:lang='nl'>De bewegingsvrijheid in het vlak. Er kunnen meerdere mogelijkheden zijn.</rdfs:comment>

<rdfs:domain>
<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Oplegging'>
<rdfs:comment xml:lang='nl'>Een oplegging of steunpunt is een element dat is vastgemaakt aan de vaste ondergrond (vb. aan het landhoofd) of aan een ander constructiedeel. Een oplegging beperkt hier de beweging van het bewegend lichaam (vb. van de brugklap). Een oplegging kan ook een dempend effect hebben bij het sluiten van een bewegend lichaam.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject' />

</owl:Class>

</rdfs:domain>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Oplegging.type'>
<rdfs:comment xml:lang='nl'>De soort oplegging.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Oplegging' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Oplegging.zijnNegatieveSteunpuntreactiesAanwezig'>
<rdfs:comment xml:lang='nl'>Geeft aan of er negatieve steunpuntreacties aanwezig zijn, al dan niet.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Oplegging' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2001/XMLSchema#boolean' />

</owl:DatatypeProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OptischeWegdeksensor.merk'>
<rdfs:comment xml:lang='nl'>Het merk van de optische wegdeksensor.</rdfs:comment>

<rdfs:domain>
<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OptischeWegdeksensor'>
<rdfs:comment xml:lang='nl'>Een meettoestel dat gebruik maakt van optische eigenschappen om de wegdekcondities zoals nat, ijs, sneeuw en vorst te meten.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject' />
 <rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Sensoropstelling' />

</owl:Class>

</rdfs:domain>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OptischeWegdeksensor.modelnaam'>
<rdfs:comment xml:lang='nl'>De modelnaam van de optische wegdeksensor.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OptischeWegdeksensor' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overdrukventilator'>
<rdfs:comment xml:lang='nl'>Onderdeel dat tot doel heeft overdruk te creëren in een gesloten ruimte zodat bij het openen van de ruimte enkel lucht kan ontsnappen naar buiten en geen lucht, rook, partikels, ... naar binnen te laten.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Ventilatie' />

</owl:Class>

<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overgangsconstructie'>
<rdfs:comment xml:lang='nl'>Verbinding tussen twee afschermende constructies voor wegen van verschillende ontwerpen en/of prestatiekenmerken.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#SchokindexVoertuigkering' />
 <rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#AansluitendeConstructie' />

</owl:Class>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering.code'>
<rdfs:comment xml:lang='nl'>De (COPRO/BENOR) code van de overlangse markering.</rdfs:comment>

<rdfs:domain>
<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering'>
<rdfs:comment xml:lang='nl'>Een markering overlangs op de weg aangebracht om het verkeer te waarschuwen, informeren of regelen.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Markering' />
 <rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#AOWSType' />

</owl:Class>

</rdfs:domain>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering.lengte'>
<rdfs:comment xml:lang='nl'>De lengte van de markering in meter.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering.oppervlakte'>
<rdfs:comment xml:lang='nl'>De oppervlakte van de overlangse markering in vierkante meter.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInVierkanteMeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering.positie'>
<rdfs:comment xml:lang='nl'>Bepaling van het wegdeel van de overlangse markering.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering.type'>
<rdfs:comment xml:lang='nl'>Het type van overlangse markering.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OverlangseMarkering' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.drempellengte'>
<rdfs:comment xml:lang='nl'>Drempellengte of breedte van de overstort. Deze wordt gemeten aan de kortste zijde van de drempel.</rdfs:comment>

<rdfs:domain>
<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort'>
<rdfs:comment xml:lang='nl'>Een overstort is een drempel tussen twee kamers waar water vanaf een bepaald peil van de ene naar de andere kamer kan stromen. Tussen twee kamers kunnen een of meerdere overstorten voorkomen.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#LinkendElement' />

</owl:Class>

</rdfs:domain>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.materiaalDrempel'>
<rdfs:comment xml:lang='nl'>Het gebruikte materiaal voor het vervaardigen van de overstort (drempel).</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.peil'>
<rdfs:comment xml:lang='nl'>Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.vrijeHoogte'>
<rdfs:comment xml:lang='nl'>De vrije hoogte tussen de overstortdrempel en het plafond van de constructie ter hoogte van de drempel. Voor drempels in leidingen worden de vrije hoogte voor de databank genomen tussen de drempel en de binnenbovenkant buis. Indien er geen sprake is van een vrije hoogte (vb drempels in grachten) wordt dit niet ingevuld.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstortrand.breedte'>
<rdfs:comment xml:lang='nl'>De afstand tussen de uiterste zijden van de overstortrand in millimeter.</rdfs:comment>

<rdfs:domain>
<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstortrand'>
<rdfs:comment xml:lang='nl'>Een overstortrand heeft als doel het afvoeren van (pieken in) overtollig rioolwater vanuit de gemengde riolering naar het oppervlaktewater.</rdfs:comment>

