      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#TrottoirbandStd">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
