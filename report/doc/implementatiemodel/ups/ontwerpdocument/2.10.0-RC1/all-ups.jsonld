        {
            "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#UPS",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "definition": {
                "nl": "Toestel (Uninterruptible Power Supply = niet onderbreekbare voeding) voor het leveren van elektrische energie van een vastgelegde kwaliteit, onafhankelijk van de beschikbaarheid van een betrouwbare netspanning. Indien het openbare net niet langer bruikbaar is om als energiebron te fungeren, wordt de energievoorziening overgenomen door de accubatterij. Deze zal gedurende een bepaalde tijd, afhankelijk van de capaciteit, de stroomvoorziening verzorgen. De UPS dient om de (minimale) voeding ononderbroken te verzekeren"
            },
            "label": {
                "nl": "UPS"
            },
            "ap-label-nl": {
                "nl": "UPS"
            },
            "ap-definition-nl": {
