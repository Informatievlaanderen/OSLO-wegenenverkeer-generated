</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VirtueleServer.modelnaam'>
<rdfs:comment xml:lang='nl'>De modelnaam van de virtuele server.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VirtueleServer' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

