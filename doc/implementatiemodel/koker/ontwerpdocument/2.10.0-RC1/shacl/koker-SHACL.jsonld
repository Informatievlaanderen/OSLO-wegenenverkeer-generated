      "sh:closed": false,
      "sh:property": [
        {
          "@id": "https://wegenenverkeer-test.data.vlaanderen.be//doc/implementatiemodel/koker/ontwerpdocument/2.10.0-RC1#HorizontaleConstructieplaatShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
