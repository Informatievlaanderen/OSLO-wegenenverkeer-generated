  shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wormschroef>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Keerwiel>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Kabeltrommel>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Cilinderbodem>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Lagerblok>,
