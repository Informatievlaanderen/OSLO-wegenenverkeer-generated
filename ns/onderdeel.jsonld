    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsNetwerkECC",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie geeft aan hoe afgeschermde netwerkelementen bereikt kunnen worden vanuit het gewone netwerk. De relatie vertrekt steeds in het controlerende netwerkelement."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsOnderdeelVan",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het besluit waarvan het artikel een onderdeel is."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsOntwerpVoor",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Mobiliteitsmaatregel die deel uitmaakt van het ontwerp"
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsSWGehostOp",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie legt de link tussen een software en hardware onderdeel."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsSWOnderdeelVan",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie geeft de link aan tussen een software onderdeel en een ander software onderdeel waarbij de eerste bv. een service is van een grotere software."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#LigtOp",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie geeft aan dat 2 onderdelen direct fysiek op elkaar liggen. Deze relatie heeft een richting en gaat van het bovenste naar het onderste onderdeel."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Omhult",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OpgehevenBij",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Geeft aan dat deze rechtsgrond of legale verschijningsvorm opgeheven is door een ander."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Realiseert",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Verwijst naar een extern element in een extern vocabularium."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Verkeersbord met op het beeldvlak een tekening en/of tekst die worden weergegeven met een geëigend bekledingsmateriaal."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Verkeersbord"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RetroreflecterendeFolie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Retroreflecterend bekledingsmateriaal, bijvoorbeeld van een divergentiepuntbebakeningselement, retroreflecterende koker, of het beeldvlak van een retroreflecterend verkeersbord."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#SluitAanOp",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Sturing",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NietDirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#TrektIn",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Geeft aan dat een rechtsgrond of legale verschijningsvorm een andere intrekt."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VeranderdDoor",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Duidt aan dat deze rechtsgrond een verandering met legale gevolgen heeft ondergaan door een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Verandert",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Duidt aan dat deze rechtsgrond een verandering met legale gevolgen doorvoert op een andere rechtsgrond. Dit omvat amendementen, vervangingen, herroepingen en andere types verandering."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Vereist",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Mobiliteitsmaatregel die vereist is om een inname tot stand te brengen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Vergunt",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Inname dat vergunt is in de innamevergunning."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VervangenBij",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Geeft aan dat deze rechtsgrond of legale verschijningsvorm vervangen is bij een ander."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Vervangt",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Geeft aan dat een rechtsgrond of legale verschijningsvorm een andere vervangt."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VerwijstNaar",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Artikel beschreven in de wegcode waarvan de verkeersmaatregel de uitvoering is."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie wordt enkel gelegd naar onderdelen die permanent onder spanning staan in normaal bedrijf. Aan deze relatie wordt steeds een richting toegekend van de voedinggever naar de ontvanger."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VoedtAangestuurd",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze relatie wordt enkel gelegd naar objecttypes die typisch een groot vermogen vereisen en onder spanning komen nadat het voedend element aangestuurd is om die spanning door te sturen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VoegtIn",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Deze rechtsgrond of legale verschijningsvorm voegt een verandering met legale impact in bij een andere."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#WordtAangeduidDoor",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een verkeersteken dat bijdraagt tot de aanduiding van een mobiliteitsmaatregel."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DirectioneleRelatie"
      ]
    }
  ],
