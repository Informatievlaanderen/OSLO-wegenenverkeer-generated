  "classes": [
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#ASTRIDInstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een (radio)heruitzendingsinstallatie van radiosignalen (over TETRA in een hogere frequentieband van 380 tot 400 MHz) ondersteund door ASTRID als communicatiesysteem voor de hulpdiensten. Door de ontvangst- en zendfrequenties verschillend te maken ontstaat tweerichtingscommunicatie over grote afstanden en op plaatsen, waar radiogolven normaal niet geraken."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Aanslagbalk",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Balk die kracht overdraagt tussen een beweegbare waterkerende constructie en een aanslag."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Aanvaarbescherming",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Constructie om te verhinderen dat schepen ergens tegenaan botsen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AanvaarbeschermingGeleidewerk"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "TODO"
      },
      "usage": {
        "nl": "Geometrie van AanzichtVerkeersbordopstelling heeft betrekking op de kaart voorstelling in de verkeersbordenapplicatie en heeft niets te maken met de fysieke positie."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Aardingsinstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een galvanische verbinding van een elektrische installatie met de aarde. De elektrische installatie die op deze wijze met de aarde wordt verbonden krijgt een spanning van nul volt."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Asweger",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een asweger is een meetinstrument dat wordt gebruikt om de belasting van individuele assen van voertuigen te meten. De meting heeft tot doel te controleren of voertuigen voldoen aan wettelijke maxima voor aslast, om zo schade aan wegeninfrastructuur te vermijden. "
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Aswegersite",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het geheel van infrastructuurelementen en toestellen op één locatie voor de exploitatie van een asweger."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Baanlichaam",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De lagen tussen het baanbed en het baanoppervlak."
      },
      "usage": {
        "nl": "Klasse uit gebruik sinds versie 2.11.0-RC1"
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balans",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balansarm",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Onderdeel van een balans. Er kunnen één of meerdere balansarmen aanwezig zijn. Het is typisch een lange, horizontale arm die aan lastzijde via een trekker verbonden is met het beweegbare brugdeel ('het val' of ook 'de klap') en aan machtzijde het gebruik van tegengewicht mogelijk maakt."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balgmechanisme",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een mechanisme dat de beweegbare waterkerende constructie van een balgstuw beweegt door middel van lucht en/of waterdruk."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Bewegingsmechanisme"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balk",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Ruimteoverspannend enkelvoudig constructie-element waarvan de lengte vele malen groter is dan de breedte en de hoogte in doorsnede. De breedte is weer gelijk of kleiner dan de hoogte."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructieElementSluisStuw",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructiefObject",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructieElementAanvaarbeschermingGeleidewerk"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#BasisverlichtingTunnel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het geheel van verlichtingstoestellen dat over de hele lengte van de koker loopt en met verschillende regimes het verlichtingsniveau voor de koker kan bepalen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Been",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een aaneengesloten reeks van links die samen een traject realiseren over het netwerk,gebruik makende van eenzelfde technologie (vb SDH,OTN...)."
      },
      "usage": {
        "nl": "De asset hoeft geometrisch niet gelokaliseerd te worden."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Berlinerwand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een damwandconstructie, opgebouwd uit stalen H-profielen en (stalen)planken. De berlinerwand wordt vooral toegepast als grondkering bij bouwputten."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Grondkeringen"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#BeweegbareWaterkerendeConstructie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een beweegbare constructie ontworpen om een waterpeilverschil te keren, inclusief alle gelaste onderdelen die bijdragen aan de structurele integriteit en functionaliteit van de constructie."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#BiFlashInstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het geheel van twee bi-flashsteunen, seinlantaarns, retroreflecterende verkeersborden en hun aansluiting, beveiligingsapparatuur en sturing op een bepaalde locatie."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#BinnenverlichtingGroep",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een groep voor het groeperen van objecten van het type Binnenverlichtingstoestel."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#BlindePut",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een put waar de riolering op aangesloten is maar die niet meer zichtbaar is."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Put"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Bochtafbakeningsinstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De verzameling van alle bochtafbakeningsborden in dezelfde bocht en rijrichting."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#EMAfbakening"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Bodembescherming",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een constructieve maatregel om de onderwaterbodem te beschermen tegen erosie en andere vormen van schade."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Boog",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een gebogen overspanning (boven een opening), tussen twee steunpunten en ter ondersteuning van een brug, waarbij de druk (ook) zijdelings wordt afgevoerd."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Bovenrolwagen",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Dit object is verbonden met de roldeur en bevat wielen die over de bovenste looprails van de constructie rijden, waardoor de deur horizontaal kan bewegen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject",
