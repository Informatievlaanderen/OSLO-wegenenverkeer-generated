      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Plantbakvorm",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Beplanting die niet in volle grond werd aangebracht, maar in bakvorm."
      },
