    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument.uri">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De verwijzing naar de bestandslocatie via een link. Bij lokale bestanden kan dit eventueel ook een pad zijn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcFrequentierange.bovengrens">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De bovengrens van de frequentierange van het toestel.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcFrequentierange">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
        <rdfs:comment xml:lang="nl">Complex datatype voor de frequentierange van een toestel.</rdfs:comment>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInHerz">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
        <rdfs:comment xml:lang="nl">Een kwantitatieve waarde die een getal in herz uitdrukt.</rdfs:comment>
      </owl:Class>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcFrequentierange.ondergrens">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De ondergrens van de frequentierange van het toestel.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcFrequentierange"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInHerz"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcHoutspecificaties.fscCertificaat">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Een attest of een bewijs dat voor elke boom die gebruikt wordt er een andere in de plaats is geplant.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcHoutspecificaties">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
        <rdfs:comment xml:lang="nl">Complex datatype om de eigenschappen van hout te bundelen.</rdfs:comment>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcHoutspecificaties.houtduurzaamheidsklasse">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De verwachte levensduur van het hout. De klasse geeft de resistentie aan van het kernhout tegen ongunstige omstandigheden.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcHoutspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcHoutspecificaties.houtkwaliteitsklasse">
