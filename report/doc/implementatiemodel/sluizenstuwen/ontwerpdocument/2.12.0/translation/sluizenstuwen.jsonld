          },
          {
            "key": "deprecated",
            "value": "true",
            "note": "null"
          },
          {
            "key": "beheerstatus",
            "value": "UitGebruikGeconsolideerd",
            "note": "Values: Nieuw,Gepubliceerd,InVerwerking,UitGebruik,Vervangen,Geconsolideerd,UitGebruikGeconsolideerd,NieuwGeconsolideerd,NieuwUitGebruik\r\nDefault: Nieuw\r\n"
          },
          {
            "key": "label-nl",
            "value": "Omhult",
            "note": "Default: Omhult\r\n"
          },
          {
            "key": "creatie",
            "value": "2.8.0-RC1.2",
            "note": "null"
          },
          {
            "key": "definition-nl",
            "value": "NOTE",
            "note": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
          }
        ],
