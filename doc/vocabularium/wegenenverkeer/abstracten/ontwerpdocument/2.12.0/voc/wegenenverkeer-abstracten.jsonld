      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SteunStandaard"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VRModuleMetFirmware",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor modules met firmware van een verkeersregelaar."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VerkeersregelaarModule",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FirmwareObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VRModuleZFirmware",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor modules zonder firmware van een verkeersregelaar."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VerkeersregelaarModule"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VegetatieElement",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte om alle gemeenschappelijke eigenschappen en relaties van de solitaire plant in de ruimte onder 1 noemer te plaatsen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Ventilatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor attributen die gemeenschappelijk zijn voor verschillende types van ventilatie."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verankering",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor verschillende soorten ankers waarmee objecten aan elkaar gefixeerd worden. Ankers worden typisch vastgezet in een of alle betrokken objecten."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verkeersbord",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte klasse voor borden die een fysieke drager van verkeerstekens kunnen zijn waarvan de betekenis bepaald wordt door een verkeersbordconcept."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verkeerslicht",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor verkeerslichten. Dit zijn apparaten, opgesteld naast of boven de weg, om weggebruikers visueel te geleiden over een kruispunt door het gebruik van rode, oranje-gele en groene lichten. De bepalingen van de wegcode zijn van toepassing, meer bepaald titel III, hoofdstuk I, artikelen 61 t.e.m. 64."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VerkeersregelaarModule",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor de verschillende modules waaruit een verkeersregelaar opgebouwd is."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verkeersteken",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte klasse voor aanwijzingen ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verlichtingstoestel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor het geheel van de lichtbron en de behuizing die werden samengesteld met als doel: * de lichtstroom van de lichtbronnen hoofdzakelijk op het te verlichten oppervlak (doorlopende wegsectie, conflictgebied,...) te richten, teneinde de zichtbaarheid te verhogen; * de lichtstroom te beheersen zodat de weggebruikers niet verblind worden en de lichthinder beperkt wordt; * het optisch systeem, de lichtbronnen en de hulpapparatuur tegen uitwendige invloeden te beschermen"
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#SerienummerObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#VerlichtingstoestelConnector",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte om een besturingsconnector toe te voegen aan een WV-toestel."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Voedingspunt",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor het aansluitpunt van de voeding."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Waarschuwingslantaarn",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor waarschuwingsinrichtingen in de buurt van een verkeerslichtengeregeld kruispunt."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterloopRelatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte om de gemeenschappelijke relaties van de verschillende soorten waterlopen onder 1 noemer te houden."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Waterremmend",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor onderdelen die waterremmend kunnen zijn."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor installaties die waterremmend kunnen zijn."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Waterremmend"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ZenderOntvangerToegang",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor relaties van Zender,Ontvanger en Repeater met andere apparatuur."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Communicatieapparatuur",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#FirmwareObject"
      ]
    }
