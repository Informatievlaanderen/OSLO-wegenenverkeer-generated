            "note": "Values: Nieuw,Gepubliceerd,InVerwerking,UitGebruik,Vervangen,Geconsolideerd,UitGebruikGeconsolideerd,NieuwGeconsolideerd,NieuwUitGebruik\r\nDefault: Nieuw\r\n"
          },
          {
            "key": "creatie",
            "value": "2.4.0-RC1.253",
            "note": "null"
          },
          {
            "key": "definition-nl",
            "value": "Zorgt voor het overbrengen van een elektrisch vermogen van de ene locatie naar de andere binnen een privaat netwerk. Onder dit type vallen ook installatiedraden die beschouwd worden als kabels met slechts één ader.",
            "note": "null"
          },
          {
            "key": "idOrigineel",
            "value": "5675",
            "note": "null"
          },
          {
            "key": "laatstGewijzigd",
            "value": "2.18.0-RC3.769",
            "note": "null"
          },
          {
            "key": "label-nl",
            "value": "Voedingskabel",
            "note": "null"
          },
          {
            "key": "uri",
            "value": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Voedingskabel",
            "note": "null"
          },
          {
            "key": "usageNote-nl",
            "value": "NOTE",
            "note": "Het gaat om voedingskabels die niet behoren het het openbaar nutsvoorzieningennet. Binnen het eigen netwerk kan een entiteit de voedingskabels ter beschikking stellen en beheren voor anderen binnen dezelfde (overkoepelende) entiteit. Ook in dat geval is er nog steeds sprake van voedingskabels.\n"
          }
        ],
        "Scope": "FULL_DEFINITON"
      },
      "inpackage": "ACTIVE_PACKAGE",
      "name": "Voedingskabel",
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kabel"
      ]
    },
    {
