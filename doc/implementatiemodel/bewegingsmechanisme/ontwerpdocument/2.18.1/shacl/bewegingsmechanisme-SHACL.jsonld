        {
          "@id": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#DrukvatShape/107a720fd4e89bca7ba6d4f3feb664b74f447097",
          "rdfs:seeAlso": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#Drukvat%3Amaximale%20druk",
          "sh:description": {
            "nl": "De hoogste druk die het drukvat kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van het drukvat. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij het drukvat geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat het drukvat faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast."
          },
          "sh:name": {
            "nl": "maximale druk"
          },
          "sh:nodekind": "sh:BlankNodeOrIRI",
          "sh:path": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Drukvat.maximaleDruk",
          "vl:message": {
            "nl": "De verwachte waarde voor maximale druk is een rdfs:Resource (URI of blank node)"
          },
          "vl:rule": ""
        },
        {
