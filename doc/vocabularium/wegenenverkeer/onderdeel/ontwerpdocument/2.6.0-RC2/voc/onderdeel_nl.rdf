<rdfs:range rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Boom.totaleBoombeschermingszone'>
<rdfs:comment xml:lang='nl'>De straal van de cirkelvormige ruimte rond de boom waar maatregelen genomen worden om de boom te beschermen tijdens projecten of manifestaties uitgedrukt in centimeters.</rdfs:comment>

<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Boom' />

