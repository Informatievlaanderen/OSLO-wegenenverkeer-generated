      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ArtificieleLaag",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte als noemer om de abstracten Laag, LaagProductidentificatiecode en LaagDikte te groeperen."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Laag",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LaagDikte",
