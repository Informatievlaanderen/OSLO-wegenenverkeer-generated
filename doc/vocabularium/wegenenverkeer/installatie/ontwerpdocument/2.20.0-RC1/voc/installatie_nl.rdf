    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Pompkamer.breedte">
