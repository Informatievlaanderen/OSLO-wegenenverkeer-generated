      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "definition": {
        "nl": "Dit een overzichtsfoto van de hele constructie. Op basis van deze afbeelding kan je snel bekijken hoe de kleur of hoogte varieert over het verloop van de geluidswerende constructie."
      },
      "domain": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GeluidwerendeConstructie"
      ],
