  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#ProefVerankeringskracht.verankeringskracht">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
    <rdfs:comment xml:lang="nl">Het resultaat van de test om de verankeringskracht in de BV laag.</rdfs:comment>
