  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstort.peil">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstort"/>
