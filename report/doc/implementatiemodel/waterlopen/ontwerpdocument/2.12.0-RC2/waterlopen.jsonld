            "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Stuwconstructie",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "definition": {
                "nl": "Een debietbegrenzende constructie waarbij het af te voeren water in zijn geheel door een (knijp)opening stroomt bij normale afvoer. Bij hevige regenval, wanneer de watertoevoer niet meer kan worden verwerkt, wordt een buffer opgebouwd tot aan de overstort."
            },
            "label": {
                "nl": "Stuwconstructie"
            },
            "ap-label-nl": {
                "nl": "Stuwconstructie"
            },
