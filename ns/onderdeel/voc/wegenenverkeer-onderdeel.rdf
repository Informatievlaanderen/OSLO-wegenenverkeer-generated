    <rdfs:comment xml:lang="nl">De afstand tussen het laagste punt van de onderkant en hoogste punt van de bovenkant van de fundering.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingsmassief"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter"/>
  </owl:ObjectProperty>
