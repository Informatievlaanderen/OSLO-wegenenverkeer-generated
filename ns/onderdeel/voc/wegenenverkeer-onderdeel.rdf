    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het aantal ladders waarmee de seinbrug toegankelijk is.</rdfs:comment>
