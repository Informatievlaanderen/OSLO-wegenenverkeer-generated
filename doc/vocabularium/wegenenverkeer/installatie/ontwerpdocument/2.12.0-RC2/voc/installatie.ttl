  rdfs:range <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Zoutbijlaadplaats.opstellingsplan> a owl:ObjectProperty;
  rdfs:comment "Een plan dat de opstelling van alle infrastructuurelementen op de site aangeeft."@nl;
  rdfs:domain <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Zoutbijlaadplaats>;
