      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PLC">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een verwerkingseenheid die volgens een vaste cyclus op basis van informatie van zijn ingangen, zijn uitgangen aanstuurt op basis van zijn programma. Omwille van zijn vormfactor kan de eenheid gebruikt worden in een vijandige omgeving.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Controller"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ElektrischComponentennummerObject"/>
