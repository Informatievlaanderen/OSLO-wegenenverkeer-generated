    "classes": [
        {
            "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie-vlag#AanzichtVerkeersbordopstelling",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "label-nl": {
                "nl": "Aanzicht verkeersbordopstelling"
            },
            "usage": {
                "nl": "Geometrie van AanzichtVerkeersbordopstelling heeft betrekking op de kaart voorstelling in de verkeersbordenapplicatie en heeft niets te maken met de fysieke positie."
            },
            "usageNote-nl": {
                "nl": "Geometrie van AanzichtVerkeersbordopstelling heeft betrekking op de kaart voorstelling in de verkeersbordenapplicatie en heeft niets te maken met de fysieke positie."
            },
            "definition": {
                "nl": "Een aanzicht van een verkeersbordopstelling is de verzameling van één of meerdere verkeersborden en hun bijbehorende ondersteunende elementen,zoals palen en eventuele onderborden, zoals deze zichtbaar zijn vanuit een specifieke kijkhoek of positie in de verkeerssituatie. Het aanzicht biedt inzicht in de ruimtelijke indeling, plaatsing en zichtbaarheid van de verkeersborden ten opzichte van de weggebruikers."
            },
            "label": {
                "nl": "Aanzicht verkeersbordopstelling"
            },
