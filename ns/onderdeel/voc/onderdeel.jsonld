      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "S1 - struikheide, dopheide, blauwe bosbes,stekelbrem, kruipbrem."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Struweel"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DynBordExternePU",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Externe stuureenheid die buiten het dynamisch bord bevestigd is, in de buurt van de openbare weg. Het betreft dus geen stuureenheid in een serverroom, noch een stuureenheid op het bord zelf."
      },
      "parents": [
