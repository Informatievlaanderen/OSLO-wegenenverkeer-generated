    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
    <rdfs:comment xml:lang="nl">Het type van de test.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#DtcGeluidstestRapport"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#Keuring.datum">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
    <rdfs:comment xml:lang="nl">De datum waarop de keuring werd uitgevoerd.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Klasse uit gebruik sinds versie 2.18.0-RC3</ns0:usageNote>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#Keuring">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
        <rdfs:comment xml:lang="nl">Technische keuring uitgevoerd door een officiële keuringsinstantie.</rdfs:comment>
        <ns0:usageNote xml:lang="nl">Klasse uit gebruik sinds versie 2.18.0-RC3 .De asset hoeft geometrisch niet gelokaliseerd te worden.</ns0:usageNote>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Proef"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#Keuring.geldigheidsDuur">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
    <rdfs:comment xml:lang="nl">de periode (in jaar) waarbinnen de keuring geldig blijft.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Klasse uit gebruik sinds versie 2.18.0-RC3</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#Keuring"/>
    <rdfs:range rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInJaar"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#Keuring.verslag">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
    <rdfs:comment xml:lang="nl">document met het verslag van de keuring.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Klasse uit gebruik sinds versie 2.18.0-RC3</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#Keuring"/>
    <rdfs:range rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#MeteropnameEnergiemeter.datumMeterstand">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
