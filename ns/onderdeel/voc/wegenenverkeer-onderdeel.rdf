    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Nummers van de voertuigen die connecteren met de PT regelaar.</rdfs:comment>
