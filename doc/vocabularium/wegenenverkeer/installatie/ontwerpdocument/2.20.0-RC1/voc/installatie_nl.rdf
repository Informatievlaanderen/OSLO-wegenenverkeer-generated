    <rdfs:comment xml:lang="nl">De lengte van het kabelveerhuis, uitgedrukt in millimeter.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kabelveerhuis"/>
    <rdfs:range rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter"/>
