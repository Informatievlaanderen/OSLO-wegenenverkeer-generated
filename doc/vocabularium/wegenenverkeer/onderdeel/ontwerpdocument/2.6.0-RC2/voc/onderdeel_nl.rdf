<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#EnergiemeterDNB' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

