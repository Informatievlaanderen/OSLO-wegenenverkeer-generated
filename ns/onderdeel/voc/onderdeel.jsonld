      ],
      "range": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DteIPv4Adres"
      ],
      "generalization": []
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Camera.heeftSpitsstrook",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "definition": {
        "nl": "Locatie-eigenschap van een camera. Dit attribuut geeft aan of de camera ingezet wordt om een spitsstrook te schouwen."
      },
      "usage": {
        "nl": "Attribuut uit gebruik sinds versie 2.3.0-RC1"
      },
      "domain": [
