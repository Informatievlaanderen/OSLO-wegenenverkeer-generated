<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcKrimpvoeg> a owl:Class;
  rdfs:comment "Complex datatype voor de informatie van de krimpvoegen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcProfieltype> a owl:Class;
  rdfs:comment "Complex datatype om de hoogtemaat en de soort van het profiel in te geven."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcProfileerlaag> a owl:Class;
  rdfs:comment "Complex datatype om extra informatie te capteren van de profilerende laag."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcSoortVervuiling> a owl:Class;
  rdfs:comment "Complex datatype om het soort vervuiling te bepalen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcSupplementenCBV> a owl:Class;
  rdfs:comment "Complex datatype voor de supplementen van de CBV."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcVegetatieSoortnaam> a owl:Class;
  rdfs:comment "Complex datatype voor de soortnaam en code van een begroeiing."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcVoorzetconstructieBevestigingsmateriaal> a owl:Class;
  rdfs:comment "Complex datatype voor de bevestigingsmaterialen van een voorzetconstructie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtuBVLaagtypes> a owl:Class;
  rdfs:comment "Union datatype voor een laagtype anders dan de profileerlaag. Bij een profileerlaag kan men het gewicht toelichten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtuLichtmastMasthoogte> a owl:Class;
  rdfs:comment "Union datatype om een standaard of afwijkende masthoogte te bepalen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DunneOverlaging> a owl:Class;
  rdfs:comment "Een dunne overlaging kan bestaan uit een SME overlaging of een antisliplaag."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AndereLaag> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DwarseMarkering> a owl:Class;
  rdfs:comment "Een markering dwars op de weg aangebracht om het verkeer te waarschuwen, informeren of regelen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DwarseMarkeringToegang> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Gassensor> a owl:Class;
  rdfs:comment "Een meettoestel dat de aanwezigheid van bepaalde gassen detecteert."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Geleidingswand> a owl:Class;
