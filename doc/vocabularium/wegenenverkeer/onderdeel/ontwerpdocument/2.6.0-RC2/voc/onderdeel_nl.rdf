<rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#NietWeggebondenDetectie' />
 <rdfs:subClassOf rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#TypeWeggebruiker' />

</owl:Class>

</rdfs:domain>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

<rdfs:range rdf:resource='http://www.w3.org/2004/02/skos/core#Concept' />

</owl:ObjectProperty>

<owl:ObjectProperty rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Radar.modelnaam'>
