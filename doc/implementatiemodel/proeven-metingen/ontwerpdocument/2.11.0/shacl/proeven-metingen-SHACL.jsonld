        {
          "@id": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/proeven-metingen/ontwerpdocument/2.11.0#BuisShape/21f219edbc3aebd4d4f3c8de99d8a1e420faf466",
          "rdfs:seeAlso": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/proeven-metingen/ontwerpdocument/2.11.0#Buis%3ASluit%20aan%20op",
          "sh:description": {
            "nl": "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."
          },
          "sh:name": {
            "nl": "Sluit aan op"
          },
          "sh:nodekind": "sh:BlankNodeOrIRI",
