  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Wegkantkast.elektrischSchema">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Elektrisch aansluitschema van de kast.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Bestanden van het type pdf,dwg of dxf.</ns0:usageNote>
