    },
    {
      "name": {
        "nl": "Type brugdeel"
      },
      "@id": "http://www.w3.org/2004/02/skos/core#Concept",
      "@type": "rdfs:Class"
    },
    {
      "name": {
        "nl": "Type trekker"
      },
      "@id": "http://www.w3.org/2004/02/skos/core#Concept",
      "@type": "rdfs:Class"
    },
    {
      "name": {
