    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brug",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een beweegbare, vaste of drijvende verbinding voor het verkeer tussen twee punten, die door water of iets anders gescheiden zijn."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brugballast",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Extra gewicht dat, meestal, geplaatst wordt op het einde van een brugdeel om het brugdeel naar beneden te krijgen. Dit dient om negatieve steunpuntreacties weg te werken."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brugdeel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het deel dat je kan wegnemen van een brug in zijn geheel. Dit kan ook meerdere overspanningen hebben. In het geval van beweegbare bruggen worden de onderdelen die de beweging mogelijk maken zoals balansarmen, tegengewicht, hameipoort,..etc ook gevat in het object brugdeel."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
