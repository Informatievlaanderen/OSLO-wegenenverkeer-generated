  "license": "https://data.vlaanderen.be/id/licentie/modellicentie-gratis-hergebruik/v1.0",
  "issued": "TODO",
  "navigation": {
    "prev": "/doc/vocabularium/wegenenverkeer/installatie/ontwerpdocument/2.7.1"
  },
  "publication-state": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard",
  "publication-date": "7-7-2023",
  "classes": [
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#ASTRIDInstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een (radio)heruitzendingsinstallatie van radiosignalen (over TETRA in een hogere frequentieband van 380 tot 400 MHz) ondersteund door ASTRID als communicatiesysteem voor de hulpdiensten. Door de ontvangst- en zendfrequenties verschillend te maken ontstaat tweerichtingscommunicatie over grote afstanden en op plaatsen, waar radiogolven normaal niet geraken."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Aanvaarbescherming",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Constructie om schepen te geleiden en/of te verhinderen dat ze ergens tegenaan botsen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Aardingsinstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een galvanische verbinding van een elektrische installatie met de aarde. De elektrische installatie die op deze wijze met de aarde wordt verbonden krijgt een spanning van nul volt."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Aswegersite",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het geheel van infrastructuurelementen en toestellen op één locatie voor de exploitatie van een asweger."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Baanlichaam",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De lagen tussen het baanbed en het baanoppervlak."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balk",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Ruimteoverspannend enkelvoudig constructie-element waarvan de lengte vele malen groter is dan de breedte en de hoogte in doorsnede. De breedte is weer gelijk of kleiner dan de hoogte."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Been",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een aaneengesloten reeks van links die samen een traject realiseren over het netwerk, gebruik makende van eenzelfde technologie (vb SDH, OTN...)."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Berlinerwand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een damwandconstructie, opgebouwd uit stalen H-profielen en (stalen)planken. De berlinerwand wordt vooral toegepast als grondkering bij bouwputten."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#BiFlashInstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het geheel van twee bi-flashsteunen, seinlantaarns, retroreflecterende verkeersborden en hun aansluiting, beveiligingsapparatuur en sturing op een bepaalde locatie."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#BlindePut",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een put waar de riolering op aangesloten is maar die niet meer zichtbaar is."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Put"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Bochtafbakeningsinstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De verzameling van alle bochtafbakeningsborden in dezelfde bocht en rijrichting."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMAfbakening"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Boog",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een gebogen overspanning (boven een opening), tussen twee steunpunten en ter ondersteuning van een brug, waarbij de druk (ook) zijdelings wordt afgevoerd."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brug",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een beweegbare, vaste of drijvende verbinding voor het verkeer tussen twee punten, die door water of iets anders gescheiden zijn."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brugballast",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Extra gewicht dat, meestal, geplaatst wordt op het einde van een brugdeel om het brugdeel naar beneden te krijgen. Dit dient om negatieve steunpuntreacties weg te werken."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brugdeel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het deel dat je kan wegnemen van een brug in zijn geheel. Dit kan ook meerdere overspanningen hebben."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brugdek",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Dragende structuur die kan bestaan uit platen, balken,... Deze kan uitgevoerd worden in verschillende materialen (beton, staal, kunststof, hout)."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brugligger",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Ondersteunende balkstructuur van een brug onder het brugdek."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Combiwand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een gecombineerde wand bestaande uit verschillende damplanken en buispalen of H-profielen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogenWand",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogen",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Damwand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een grond- en/of waterkerende constructie, die bestaat uit een verticaal in de grond geplaatste wand."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DrogePompkelder",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een droge pompkelder is dat gedeelte van een gebouw/kunstwerk dat (meestal) onder het maaiveld is gelegen,veelal om beheersvoorzieningen te herbergen en/of als een technische ruimte dat deel uitmaakt van een pompstation."
      },
      "usage": {
        "nl": "Gebruik PompKamer voor het waterbouwkundig systeem van het pompstation."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcAardingsstelsel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype dat het mogelijk maakt om het attest van de distributienetbeheerder toe te voegen in het geval van een globaal aardingsstelsel."
      },
      "usage": {
        "nl": "Het attest is enkel vereist voor globale aardingsstelsels. Voor gescheiden aardinsstelsel kanhet attribuut attestDNB leeg blijven."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Complex datatype om de burgerlijke klasse van een brug te bepalen."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ecoduct",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Ecoducten of natuurbruggen zorgen ervoor dat dieren veilig de weg kunnen oversteken."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ecoduiker",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Buis- of tunnelvormige doorgang voor water onder een weg, die is voorzien van een oeverstrook of van looprichels zodat kleinere diersoorten beschermd voor het verkeer kunnen doorsteken."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ecokoker",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een kleine ecotunnel of ecokoker is een doorgang voor dieren onder een weg of spoorweg."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ecotunnel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een (grote) ecotunnel is een tunnel onder een grote weg, waarlangs dieren veilig de overkant kunnen bereiken."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ecovallei",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een vallei onder de verkeersbrug waar het landschap gewoon onderdoor loopt en minimaal wordt verstoord."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#ExterneNaspanning",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Nagespannen kabel of staaf die wordt geplaatst om de draagkracht van een structuur (bv. van een brug) te verhogen. Dit kan zowel in bestaande als in nieuwe structuren wordt toegepast."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Fietstelinstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Groepering van onderdelen die samen een installatie vormen voor het verzamelen van telgegevens over passerende fietsers en in sommige installaties het tonenvan de gegevens."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Flitsgroep",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Groepering om de flitspalen van een kruispunt of bepaalde zone in onder te brengen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Flitspaal",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Buiteninstallatie waarin een flitscamera geplaatst kan worden."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Funderingswand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Wand die dient om de belastingen van constructies/elementen op te vangen/over te brengen naar draagkrachtige lagen. Kan ook een grondkerende/waterkerende functie hebben."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogenWand",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogen",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gebouw",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Elk bouwwerk,dat een voor mensen toegankelijke overdekte,geheel of gedeeltelijk met wanden omsloten ruimte vormt."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Behuizing"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GecombineerdePut",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Alle putrelaties."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GeluidwerendeConstructie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een geluidswerende wandvormige constructie bestaande uit een desgevallend geluidsisolerend materiaal en/of geluidsabsorberend materiaal en voorzien van de nodige structuren om de bouwkundige stabiliteit te verzekeren."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GewapendeGrond",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Grondkering waarbij constructieve elementen van staal of geotextiel/geogrid samenwerken met de grond en daaruit stabiliteit ontwikkelen. Gewapende grond is ook wel gekend als 'terre armée'."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gewichtsmuur",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Kerende constructie die stabiliteit ontleent aan zijn eigen gewicht. Onder stabiliteit dient verstaan te worden: glijden, omkantelen en verticaal draagvermogen. De muur is (meestal) onderaan breder dan bovenaan."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GroepDwarseMarkeringEnFiguratie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Groepering van de dwarse- en figuratiemarkering."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GroepMarkering",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Groepering om alle soorten markeringen te groeperen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gronddam",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Gronddammen zijn trapeziumvormige constructies bestaande uit zand, grond of steenachtige materialen. De onderkant van de gronddam wordt direct op het bestaand maaiveld aangebracht of op een vooraf aangebrachte grondverbetering. Een gronddam kan volgende functies vervullen: geluidswering, geleiding van dieren, veiligheid en lichtwering."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#HorizontaleConstructieplaat",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een plaat die dient ter constructie en die horizontaal wordt gebruikt. Deze omvat geen platen die met fundering te maken hebben (vb.: funderingsplaat, funderingszool,...)."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Hulppost",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De verzameling van hulpgerelateerde technieken en objecten op een bepaalde plaats, bv.een nis in een tunnel."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#IPBackbone",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Netwerk dat bestaat uit meerdere L3 switches. Zij verbinden de verschillende L2 access structuren met de datacentres"
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#InspectieputRiolering",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Dient om de aanwezige riolering te kunnen inspecteren, reinigen of onderhouden."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Put"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kabelkoker",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een ruimte die een of meerdere kabels of leidingen beschermt tegen beschadiging en/of de kabels of leidingen op een gecontroleerde plaats laat hangen of liggen. De constructieve elementen die de ruimte creëeren vormen een aaneen- en afgesloten geheel dat niet meer uit elkaar kan gehaald worden. De kabels en leidingen zijn enkel nog toegankelijk door in de koker zelf rond te lopen (of te kruipen). De koker is op die toegankelijkheid voorzien."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kabelgeleiding"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kelderlandhoofd",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Landhoofd uitgerust met kelder voor het herbergen van bewegende delen of onderhoudsvoorzieningen (bv. beweging tegengewicht). Deze kan ook afgesloten zijn (niet toegankelijk) en holle ruimtes bevatten."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kelderpijler",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Pijler uitgerust met een kelder voor het herbergen van bewegende delen of onderhoudsvoorzieningen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kolom",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een verticale constructie die dient als drager en bestaat uit een zuil of pilaar."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Koppeling",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een koppeling is een machineonderdeel dat wordt gebruikt om vermogen (rotatie en koppel) over te brengen van een aandrijvende as naar een aangedreven as."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#L2AccessStructuur",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Opstelling die het mogelijk maakt om een techniek direct te koppelen met het IP telematica netwerk. Een L2 access structuur bestaat uit meerdere L2 Switches die met elkaar verbonden zijn."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#LEDRotondeafbakening",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De verzameling van actieve lichtgevende modules ter hoogte van één toerit die ingeslepen worden in, of geplaatst worden op, de boordsteen van een rotonde en als doel hebben om de rand van de rotonde duidelijk zichtbaar te maken."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMAfbakening"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#LEDWegdekreflectorBebakening",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De verzameling van op de rijbaan verankerde actieve lichtmodules. De modules hebben als doel de randen van de rijbaan of de grenzen tussen rijstroken te markeren of gevaarlijke plaatsen te signaleren. De verzameling bundelt de actieve reflectoren die hetzelfde obstakel of risico aanduiden."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMAfbakening"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Landhoofd",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Eindsteunpunt van een brug die de overgang vormt naar het achterliggend grondlichaam én als hoofdfunctie heeft de brug te ondersteunen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Link",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het (glasvezel) traject tussen twee toestellen (NetwerkElementen) die rechtstreeks met mekaar communiceren."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Lokaal",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een ruimte binnen een gebouw."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Behuizing"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Luchtkwaliteitsensor",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Installatie voor het meten van verschillende aspecten van de luchtkwaliteit in tunnels tussen twee punten op basis van de onderbrekingen in een signaal dat tussen die twee punten reist."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MIVInstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De volledige opstelling voor meten in Vlaanderen op een bepaalde locatie."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MIVMeetpunt",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een meetpunt van Meten-In-Vlaanderen als plaats waar beide meetlussen bij benadering in de weg ingeslepen zijn."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MVPaal",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Grondverdringende stalen paal met een inwendige en/of uitwendige injectie met grout-specie. Ze wordt vervaardigd door het heien van een stalen profiel/buis in de bodem onder gelijktijdig injecteren van een groutmengsel."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Meetstation",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De plaats waar verschillende sensoren samen 1 meetstation vormen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Onderbord",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een bord met een verkeersteken dat als toevoeging onder een verkeersbord is gehangen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#RetroreflecterendVerkeersbord"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Oplegrij",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een rij van opleggingen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Overbrenging",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een overbrenging of transmissie brengt een vermogen (bv. van een motor) over op een bewegingsmechanisme. Daarbij kan de snelheid, de kracht en het koppel aangepast worden aan de noden van het bewegingsmechanisme (bv. door gebruik te maken van een tandwielkast)."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pad",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een aaneengesloten reeks van benen die samen een verbinding realiseren over het netwerk, gebruik makende van eenzelfde technologie (vb SDH, OTN...). De verschillende benen binnen een pad volgen bij voorkeur een gescheiden geografisch traject binnen het netwerk."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pijler",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een pijler is een steunpilaar die fungeert als vrijstaande drager en een steunpunt vormt tussen landhoofden voor de liggers of gewelven van een kunstwerk."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#PompGroep",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een systeem dat instaat voor het omzetten van elektrische energie in een verplaatsing of drukverhoging van water. In dit geval spreekt men van een pomp. In de omgekeerde situatie spreekt men van een turbine."
      },
      "usage": {
        "nl": "Gebruik PompGroep voor een modulair systeem."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pompkamer",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Elk volume,inclusief de bouwkundige elementen die dit volume bepalen,dat deel uitmaakt van het waterbouwkundig systeem van het pompstation en als zodanig onder water kan staan."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PutRelatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pompstation",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Inrichting voor het oppompen van grond- of oppervlaktewater."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pyloon",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een pyloon is een taps toelopende hoge constructie, als drager van kabels e.d. (bv. een hoogspanningmast of een mast van een brug)."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#RadioheruitzendInstallatie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het geheel van ontvangstantenne, infrastructuur en straalkabel of zendantenne om de radiosignalen van radiozenders over FM (88 tot 108 MHz) of DAB (174 tot 230 MHz) uit te zenden op plaatsen, die afgesloten zijn van de buitenwereld, zoals tunnels en ondergrondse parkings."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Randprofiel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Profiel ter afwerking en versterking van de rand. Deze kan uitgevoerd worden in verschillende materialen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Rioleringsstelsel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De groepering van de objecten die behoren tot de riolering."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een secans- of tangenspalenwand bestaat uit betonnen boorpalen. Bij de secanspalenwand zijn dit primaire en secundaire, in elkaar oversneden palen. Bij de tangenspalenwand snijden de boorpalen niet in elkaar in (geen overlap). De wand heeft tot doel een bouwputbeschoeiing te realiseren. De stabiliteit van de grondkering wordt verzekerd door verankeringen en/of schoringen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Slagboom",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een afsluitingsmechanisme met slagboomarmen dat dient om controle uit te kunnen oefenen over het gebruik van een doorgang of een toegang."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Soilmixwand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een cutter soilmixwand (CSM-wand) is een aansluitende kerende wand bestaande uit elkaar overlappende moten in de grond gevormd. Deze heeft een grond- en waterkerende functie."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenCaisson",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Dit is een samengesteld element bestaande uit twee of meerdere warmgewalste stalen damplanken met Z- of U-vorm."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Stalen profiel, bijvoorbeeld een H-profiel, dat wordt gebruikt als fundering of wapening van een fundering. Dit is geen profiel voor een damplank: hiervoor moet 'Stalen damplank' worden gebruikt."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeBerlinerwandTussenschot",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het tussenschot (plaat of plank tussen profielen) voor een tijdelijke berlinerwand. Om een berlinerwand te definiëren die permanent in de grond blijft, moeten de specifieke (materiaal)onderdelen gebruikt worden."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Trajectcontrole is een systeem waarbij de gemiddelde snelheid over een langere afstand wordt gemeten."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trekker",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een langwerpig (lijnvormig) element dat op trek wordt belast. Dit maakt de verbinding tussen het brugdek en de hoofddraagstructuur van het brugdeel (vb.: tussen boog en brugdek, tussen pyloon en brugdek, tussen draagkabel en brugdek, tussen windverband onder de brug en brugdek)."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Binnen de L2 access structuur vormt de VLAN een specifieke virtuele LAN. De toepassingen zijn verbonden met een specifieke VLAN. Rechtstreekse communicatie tussen toepassingen is enkel mogelijk indien deze zijn verbonden met dezelfde VLAN."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VakwerkElement",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Element dat deel uitmaakt van een constructie waarbij balken en staven, volgens een stelsel van rechthoeken en/of driehoeken, aan de uiteinden en/of kruiselings verbonden worden tot een onwrikbaar geheel."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Inhoudelijke definitie van de betekenis van een verkeersbord zoals opgenomen in de wegcode."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordVerkeersteken",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De voorstelling door middel van een verkeersbord van een aanwijzing ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verkeersteken"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Het geheel van verticale verkeerssignalisatie die bevestigd is aan één of meerdere draagconstructies op éénzelfde geolocatie."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Signalisatie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Versteviging van de grond door een rooster van ankers (nagels), waarbij de oppervlakte tussen de ankers gestabiliseerd wordt door middel van gewapend spuitbeton."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VoorzieningNegatieveReactie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Voorziening om opwaartse reacties ter hoogte van de steunpunten tegen te gaan, bv. stalen staven. Dit element maakt de verbinding tussen brugdeel en landhoofd/pijler en bevindt zich in de onmiddellijke omgeving van de opleggingen. De oplegging (dit is een andere klasse) kan zowel druk als trek opnemen en kan ook gebruikt worden als een voorziening tegen negatieve reactie."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een verticaal constructiedeel, vrijstaand of omsluitend die een afscheiding vormt, bv. tussen 2 ruimtes."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wegberm",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Gedeelte van het wegplatform dat buiten de rijbanen ligt. Een wegberm kan sloten en bijzonder ingerichte onderdelen bevatten."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#TerreinDeel"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wilddetectiezone",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "De wilddetectiezone van een wilddetectiesysteem betreft de nabije zone rond de detectiesystemen (zoals een bewegingssensor). Deze zone vereist extra onderhoud, om valse detecties te voorkomen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Windverband",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Ook: kruisverband. Stabiliteitsvoorziening om een constructie stijf te maken. Vangt windbelastingen, spatkrachten en dwarskrachten op. Ze bestaan meestal uit vrijwel onwrikbare (onvervormbare) driehoeken."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Zoutbijlaadplaats",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Site in het beheer van een district, waar strooiwagens zout of pekel kunnen bijladen, wanneer ze tijdens de winterdienst hun strooiroute afleggen. De leverancier kan toegang krijgen (batch of codeklavier) om de tanks of de silos terug te vullen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Zpad",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "End-to-end gebruikersverbinding over het transport netwerk."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"
      ]
    }
  ],
