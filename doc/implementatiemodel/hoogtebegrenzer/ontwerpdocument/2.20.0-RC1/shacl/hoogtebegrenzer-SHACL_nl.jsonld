          "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/hoogtebegrenzer/ontwerpdocument/2.20.0-RC1#GalgpaalShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
