    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.4.0 </ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#VerlichtingstoestelLED"/>
