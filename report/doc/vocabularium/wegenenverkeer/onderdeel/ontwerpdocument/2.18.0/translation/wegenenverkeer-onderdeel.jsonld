    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Kalkgrasland",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Kalkgrasland"
      },
      "usage": {
        "nl": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
      },
      "usageNote-nl": {
        "nl": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
      },
      "definition": {
        "nl": "G5c - blauwgras, bergdravik, duifkruid, grote centaurie, ruige scheefkelk, geel zonneroosje, kleine pimpernel, kalkwalstro, gevinde kortsteel, aarddistel, smal fakkelgras, driedistel."
      },
      "label": {
        "nl": "Kalkgrasland"
