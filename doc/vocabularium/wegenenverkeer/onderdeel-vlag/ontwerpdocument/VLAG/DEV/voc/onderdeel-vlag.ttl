<https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm.groeiplaatsverbetering> a owl:ObjectProperty;
  rdfs:comment "De techniek waarmee de groeiplaats wordt verbeterd met als doel de levensverwachting en de conditie van de vegetatie te verbeteren."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag>;
  rdfs:range skos:Concept .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm.heeftBoomplaat> a owl:DatatypeProperty;
  rdfs:comment "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag>;
  rdfs:range xsd:boolean .

<https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm.heeftWortelgeleidingwortelwering> a owl:DatatypeProperty;
  rdfs:comment "Aanduiding of de boom wortelwering heeft. Wortelgeleiding en wering moet voorkomen dat boomwortels het trottoir, de middenberm, het fietspad, de rijweg, andere wegverhardingen en leidingstelsels beschadigen."@nl;
  rdfs:domain <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag#DtcAanlegBoomvorm>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel-vlag>;
  rdfs:range xsd:boolean .

