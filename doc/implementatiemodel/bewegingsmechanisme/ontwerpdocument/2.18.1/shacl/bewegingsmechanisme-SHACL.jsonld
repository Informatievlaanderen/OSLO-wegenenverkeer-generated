        {
          "@id": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#BalgShape/107a720fd4e89bca7ba6d4f3feb664b74f447097",
          "rdfs:seeAlso": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#Balg%3Amaximale%20druk",
          "sh:description": {
            "nl": "De hoogste druk die de balg kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van de balg. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij de balg geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat de balg faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast"
          },
          "sh:name": {
            "nl": "maximale druk"
          },
          "sh:nodekind": "sh:BlankNodeOrIRI",
          "sh:path": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Balg.maximaleDruk",
