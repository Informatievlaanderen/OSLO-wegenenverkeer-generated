    <rdfs:comment xml:lang="nl">Geeft aan of de cilinder een inwendige standmeting heeft.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#HydraulischeCilinder"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
