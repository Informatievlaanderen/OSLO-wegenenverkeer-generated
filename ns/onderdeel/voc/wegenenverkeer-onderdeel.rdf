    <rdfs:comment xml:lang="nl">Afwijkende kantopsluiting,bestemd om de rand van de verharding te beschermen en te versterken.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AfwijkendeKantopsluiting"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#TrottoirbandStd.norm">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De gestandaardiseerde trottoirband volgens aangeduide norm.</rdfs:comment>
