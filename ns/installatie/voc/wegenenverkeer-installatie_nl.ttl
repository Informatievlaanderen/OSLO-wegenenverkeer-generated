    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GroepMarkering> a owl:Class;
  rdfs:comment "Groepering om alle soorten markeringen te groeperen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Hameipoort> a owl:Class;
  rdfs:comment "Een hameipoort is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Het is een portaalstructuur die staat op de onderbouw, aan de scharnierzijde. Het draagt bovenaan de volledige balans die er scharnierend ermee verbonden is."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Hameistijl> a owl:Class;
  rdfs:comment "Een hameistijl is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. De verticale (kolom)structuur staat op de onderbouw, aan de scharnierzijde. Samen met een tweede hameistijl draagt het de balans die bovenaan scharnierend ermee verbonden is."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Hanger> a owl:Class;
  rdfs:comment "Een hanger is een secundair constructieonderdeel van een hangbrug dat, meestal met talrijke andere hangers, een brugdeel ophangt aan een overspannende hoofddrager/hoofdkabel. Een moderne hanger bestaat meestal uit staalkabel, maar deze kan ook uit profielstaal, platstaal of rondstaal vervaardigd zijn of zelfs uit schakels bestaan."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#HorizontaleConstructieplaat> a owl:Class;
  rdfs:comment "Een plaat die dient ter constructie en die horizontaal wordt gebruikt. Deze omvat geen platen die met fundering te maken hebben (vb.: funderingsplaat,funderingszool,...)."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementSluisStuw>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementAanvaarbeschermingGeleidewerk> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kolkwand> a owl:Class;
  rdfs:comment "De wand van een kolk. Wanden dienen opgesplitst te worden per moot. Elke moot heeft een aparte wand aan beide kanten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Koppelbalk> a owl:Class;
  rdfs:comment "Een balk die delen van een constructie met elkaar verbindt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BalkGK> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Lokaal> a owl:Class;
  rdfs:comment "Een ruimte binnen een gebouw."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Behuizing>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kokerruimte> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Oplegrij> a owl:Class;
  rdfs:comment "Een rij van opleggingen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pad> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De asset hoeft geometrisch niet gelokaliseerd te worden."@nl;
  rdfs:comment "Een aaneengesloten reeks van benen die samen een verbinding realiseren over het netwerk, gebruik makende van eenzelfde technologie (vb SDH, OTN...). De verschillende benen binnen een pad volgen bij voorkeur een gescheiden geografisch traject binnen het netwerk."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Randprofiel> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.18.0 "@nl;
  rdfs:comment "Profiel ter afwerking en versterking van de rand. Deze kan uitgevoerd worden in verschillende materialen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DetaiplanObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Slagboom> a owl:Class;
  rdfs:comment "Een afsluitingsmechanisme met slagboomarmen dat dient om controle uit te kunnen oefenen over het gebruik van een doorgang of een toegang."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Sluishoofd> a owl:Class;
  rdfs:comment "Constructiehoofd van een sluis waarin één of meerdere sluisdeuren zitten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Constructiehoofd> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Tegengewichtkist> a owl:Class;
  rdfs:comment "De tegengewichtkist is een stevige behuizing die deel uitmaakt van de macht-zijde van balans of een gebalanceerd, beweegbaar brugdeel. Vaak erdoor beschermd tegen nadelige atmosferische invloeden, is er massa (ballast) in ondergebracht om een (regelbaar) tegengewicht te bekomen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VakwerkElement> a owl:Class;
  rdfs:comment "Element dat deel uitmaakt van een constructie waarbij balken en staven,volgens een stelsel van rechthoeken en/of driehoeken,aan de uiteinden en/of kruiselings verbonden worden tot een onwrikbaar geheel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementAanvaarbeschermingGeleidewerk> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verdeelbalk> a owl:Class;
  rdfs:comment "Een constructief element dat de belasting op een grondkerende constructie, zoals een damwand of beschoeiing, verdeelt naar meerdere ankerstaven of andere steunpunten. Het zorgt voor een gelijkmatige(re) spreiding van de belastingen op de constructie en vormt zo mee een essentieel onderdeel van de structuur."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BalkGK> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Vloernis> a owl:Class;
  rdfs:comment "Vaste uitsparing (verticale verdieping) in de bodem van het constructiehoofd over de breedte van de constructie voor de waterdichting en/of krachtoverdracht van de beweegbare waterkerende constructie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wilddetectiezone> a owl:Class;
  rdfs:comment "De wilddetectiezone van een wilddetectiesysteem betreft de nabije zone rond de detectiesystemen (zoals een bewegingssensor). Deze zone vereist extra onderhoud, om valse detecties te voorkomen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Windverband> a owl:Class;
  rdfs:comment "Ook: kruisverband. Stabiliteitsvoorziening om een constructie stijf te maken. Vangt windbelastingen, spatkrachten en dwarskrachten op. Ze bestaan meestal uit vrijwel onwrikbare (onvervormbare) driehoeken."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wrijfbalk> a owl:Class;
  rdfs:comment "Balk om een constructie te beschermen in geval van wrijvend contact met schepen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidSluisStuw>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DetaiplanObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Zoutbijlaadplaats> a owl:Class;
  rdfs:comment "Site in het beheer van een district,waar strooiwagens zout of pekel kunnen bijladen,wanneer ze tijdens de winterdienst hun strooiroute afleggen. De leverancier kan toegang krijgen (badge of codeklavier) om de tanks of de silos terug te vullen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#ASTRIDInstallatie> a owl:Class;
  rdfs:comment "Een (radio)heruitzendingsinstallatie van radiosignalen (over TETRA in een hogere frequentieband van 380 tot 400 MHz) ondersteund door ASTRID als communicatiesysteem voor de hulpdiensten. Door de ontvangst- en zendfrequenties verschillend te maken ontstaat tweerichtingscommunicatie over grote afstanden en op plaatsen, waar radiogolven normaal niet geraken."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Aanvaarbescherming> a owl:Class;
  rdfs:comment "Constructie om te verhinderen dat schepen ergens tegenaan botsen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanvaarbeschermingGeleidewerk> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Geometrie van AanzichtVerkeersbordopstelling heeft betrekking op de kaart voorstelling in de verkeersbordenapplicatie en heeft niets te maken met de fysieke positie."@nl;
  rdfs:comment "Een aanzicht van een verkeersbordopstelling is de verzameling van één of meerdere verkeersborden en hun bijbehorende ondersteunende elementen,zoals palen en eventuele onderborden, zoals deze zichtbaar zijn vanuit een specifieke kijkhoek of positie in de verkeerssituatie. Het aanzicht biedt inzicht in de ruimtelijke indeling, plaatsing en zichtbaarheid van de verkeersborden ten opzichte van de weggebruikers."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Berlinerwand> a owl:Class;
  rdfs:comment "Een damwandconstructie, opgebouwd uit stalen H-profielen en (stalen)planken. De berlinerwand wordt vooral toegepast als grondkering bij bouwputten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Bochtafbakeningsinstallatie> a owl:Class;
  rdfs:comment "De verzameling van alle bochtafbakeningsborden in dezelfde bocht en rijrichting."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMAfbakening> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Drempel> a owl:Class;
  rdfs:comment "Vaste opstand op de bodem van het constructiehoofd over de breedte van de constructie voor de waterdichting en/of krachtoverdracht van de beweegbare waterkerende constructie (m.u.v. roldeuren)."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#ExterneNaspanning> a owl:Class;
  rdfs:comment "Nagespannen kabel of staaf die wordt geplaatst om de draagkracht van een structuur (bv. van een brug) te verhogen. Dit kan zowel in bestaande als in nieuwe structuren wordt toegepast."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gebouw> a owl:Class;
  rdfs:comment "Elk bouwwerk,dat een voor mensen toegankelijke overdekte,geheel of gedeeltelijk met wanden omsloten ruimte vormt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Behuizing> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gewichtsmuur> a owl:Class;
  rdfs:comment "Kerende constructie die stabiliteit ontleent aan zijn eigen gewicht. Onder stabiliteit dient verstaan te worden: glijden, omkantelen en verticaal draagvermogen. De muur is (meestal) onderaan breder dan bovenaan."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GroepDwarseMarkeringEnFiguratie> a owl:Class;
  rdfs:comment "Groepering van de dwarse- en figuratiemarkering."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Halsbeugelmechanisme> a owl:Class;
  rdfs:comment "Dient om de beweging van de waterkerende constructie, meer bepaald puntdeur of draaideur, te geleiden. De geleiding bestaat hoofdzakelijk uit een rotatie om een verticale as en soms mogelijk ook een translatie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Geleidingsmechanisme> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Hefportiek> a owl:Class;
  rdfs:comment "Een hefportiek is een vrijstaand, stijf hoofdconstructieonderdeel. Het bestaat uit minstens twee steunbenen die onderling verbonden zijn en rusten op de onderbouw. Deze steunbenen staan (mede) in voor het verticale steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dit niet rust op zijn vaste steunpunten. Het tilt meestal een brugdeel of beweegbare waterkerende constructie op. Meestal herbergt een hefportiek een mechaniek met ook een tegengewicht en steekt het samen met een tweede, gelijkaardig exemplaar aan de overzijde, hoog boven de rest van het kunstwerk uit. "@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Heftoren> a owl:Class;
  rdfs:comment "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#InspectieputRiolering> a owl:Class;
  rdfs:comment "Dient om de aanwezige riolering te kunnen inspecteren,reinigen of onderhouden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Put> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kokercomplex> a owl:Class;
  rdfs:comment "Een constructie met een gesloten doorsnede dat over de hele lengte doorloopt, continu ondersteund, bestaande uit 1 of meerdere kokers die 2 of meer locaties verbindt, met 1 of meerdere in- en uitgangen, ongeacht de toepassing."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kolom> a owl:Class;
  rdfs:comment "Een verticale constructie die dient als drager en bestaat uit een zuil of pilaar."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementSluisStuw>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementAanvaarbeschermingGeleidewerk> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Lmuur> a owl:Class;
  rdfs:comment "Grond- en/of waterkerend betonnen element bedoeld om een niveauverschil in het maaiveld op te vangen met een teen of voet aan de basis waaraan het zijn stabiliteit ontleent."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MVPaal> a owl:Class;
  rdfs:comment "Grondverdringende stalen paal met een inwendige en/of uitwendige injectie met grout-specie. Ze wordt vervaardigd door het heien van een stalen profiel/buis in de bodem onder gelijktijdig injecteren van een groutmengsel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Stuwhoofd> a owl:Class;
  rdfs:comment "Constructiehoofd van een stuw waarin één of meerdere stuwelementen zitten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Constructiehoofd> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Taatsmechanisme> a owl:Class;
  rdfs:comment "Wordt gebruikt om bouwkundige constructies, zoals een puntdeur, draaideur of draaibrug, te geleiden. De geleiding omvat voornamelijk rotatie en soms ook translatie. Daarnaast vervult het een dragende functie met betrekking tot de sluisdeur."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Geleidingsmechanisme> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeBerlinerwandTussenschot> a owl:Class;
  rdfs:comment "Het tussenschot (plaat of plank tussen profielen) voor een tijdelijke berlinerwand. Om een berlinerwand te definiëren die permanent in de grond blijft, moeten de specifieke (materiaal)onderdelen gebruikt worden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trekker> a owl:Class;
  rdfs:comment "Een lineair mechanisch element, dubbelzijdig scharnierend, dat beoogd is om hoofdzakelijk op trek te belasten. Het verbindt, bijvoorbeeld, enerzijds het (bewegend) brugdeel/ beweegbare waterkerende constructie met anderzijds de lastzijde van de balansarm/bovenrolwagen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#TechnischDocument> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ventilatiekanaal> a owl:Class;
  rdfs:comment "Een buis die paarsgewijs zorgt voor passieve verluchting van een afgesloten ruimte door langs de ene buis lucht naar binnen en door de andere naar buiten te laten stromen op basis van de hoogte ten opzichte van elkaar."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordVerkeersteken> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De asset hoeft geometrisch niet gelokaliseerd te worden."@nl;
  rdfs:comment "De voorstelling door middel van een verkeersbord van een aanwijzing ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verkeersteken> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wegberm> a owl:Class;
  rdfs:comment "Gedeelte van het wegplatform dat buiten de rijbanen ligt. Een wegberm kan sloten en bijzonder ingerichte onderdelen bevatten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#TerreinDeel> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#ZonnepanelenInstallatie> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Technische fiches, legplan,  berekeningsnota's, ballast- of funderingsberekening, etc... aanleveren via Bijlage."@nl;
  rdfs:comment "Een technische installatie die bestaat uit zonnepanelen, elektrische bekabeling, omvormers en ondersteunende infrastructuur, en die tot doel heeft om door middel van fotovoltaïsche omzetting gelijkstroom te produceren en deze, via energieomzetting en beveiligingscomponenten, bruikbaar te maken voor lokaal verbruik of injectie op het elektriciteitsnet."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Baanlichaam> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.11.0 "@nl;
  rdfs:comment "De lagen tussen het baanbed en het baanoppervlak."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Bodembescherming> a owl:Class;
  rdfs:comment "Een constructieve maatregel om de onderwaterbodem te beschermen tegen erosie en andere vormen van schade."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Bovenrolwagen> a owl:Class;
  rdfs:comment "Dit object is verbonden met de roldeur en bevat wielen die over de bovenste looprails van de constructie rijden, waardoor de deur horizontaal kan bewegen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#StaalsoortObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Geleidingsmechanisme> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcAardingsstelsel> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Het attest is enkel vereist voor globale aardingsstelsels. Voor gescheiden aardinsstelsel kanhet attribuut attestDNB leeg blijven."@nl;
  rdfs:comment "Complex datatype dat het mogelijk maakt om het attest van de distributienetbeheerder toe te voegen in het geval van een globaal aardingsstelsel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcMateriaalEnAfwerking> a owl:Class;
  rdfs:comment "Complex datatype voor materiaal en afwerking van de leuning."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcMeteoFoto> a owl:Class;
  rdfs:comment "Complex datatype voor meteo gerelateerde foto's."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcMinMaxHoogteSchermelement> a owl:Class;
  rdfs:comment "Complex datatype voor de hoogte in centimeter van het laagste element en van het hoogste element."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcTypeBWC> a owl:Class;
  rdfs:comment "Complex datatype om het type beweegbare waterkerende constructie aan te duiden"@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Geleidewerk> a owl:Class;
  rdfs:comment "Een constructie in een waterweg waarmee schepen worden geleid als ze een kunstwerk zoals een brug of sluis naderen, binnenvaren of passeren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanvaarbeschermingGeleidewerk> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kabelveerhuis> a owl:Class;
  rdfs:comment "Een behuizing die een veersysteem bevat, dat wordt gebruikt om de spanning op de kabels binnen het mechanisme te reguleren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#TechnischDocument> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kelderlandhoofd> a owl:Class;
  rdfs:comment "Landhoofd uitgerust met kelder voor het herbergen van bewegende delen of onderhoudsvoorzieningen (bv. beweging tegengewicht). Deze kan ook afgesloten zijn (niet toegankelijk) en holle ruimtes bevatten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kelderpijler> a owl:Class;
  rdfs:comment "Pijler uitgerust met een kelder voor het herbergen van bewegende delen of onderhoudsvoorzieningen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kesp> a owl:Class;
  rdfs:comment "Algemene benaming voor het aanduiden van een betonnen balk bovenaan grondkerende structuren, een kopbalk als het ware (wordt ook wel kaaimuurkop genoemd). Ankervoorzieningen, ladders, enz. worden in/tegen de kesp bevestigd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BalkGK> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Link> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De asset hoeft geometrisch niet gelokaliseerd te worden."@nl;
  rdfs:comment "Het (glasvezel) traject tussen twee toestellen (NetwerkElementen) die rechtstreeks met mekaar communiceren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MIVInstallatie> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.9.0 "@nl;
  rdfs:comment "Een MIV eenheid die instaat voor de verwerking van gegevens van lussen op een bepaalde locatie, hetzij als satelliet-eenheid hetzij als centrale eenheid voor de combinatie van verschillende eenheden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MIVModule> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Vervangt MIVInstallatie om duidelijk te maken dat het om de aparte eenheden gaat (Sat's en LVE) en niet over het geheel van gekoppelde eenheden."@nl;
  rdfs:comment "Een verwerkingseenheid die instaat voor de verwerking van gegevens van lussen op een bepaalde locatie, hetzij als satelliet-eenheid hetzij als centrale eenheid voor de combinatie en doorsturen van verschillende eenheden. Het kan gaan om een alles-in-een toestel of om een opstelling met aparte componenten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#IpAdresObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Onderrolwagen> a owl:Class;
  rdfs:comment "Dit object is verbonden met de roldeur en bevat wielen die over de onderste looprails van de constructie rijden, waardoor de deur horizontaal kan bewegen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#StaalsoortObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Geleidingsmechanisme> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pijler> a owl:Class;
  rdfs:comment "Een pijler is een steunpilaar die fungeert als vrijstaande drager en een steunpunt vormt tussen landhoofden voor de liggers of gewelven van een kunstwerk."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Rioleringsstelsel> a owl:Class;
  rdfs:comment "De groepering van de objecten die behoren tot het riolering, aanvoer- of afvoerstelsel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand> a owl:Class;
  rdfs:comment "Een secans- of tangenspalenwand bestaat uit betonnen boorpalen. Bij de secanspalenwand zijn dit primaire en secundaire, in elkaar oversneden palen. Bij de tangenspalenwand snijden de boorpalen niet in elkaar in (geen overlap). De wand heeft tot doel een bouwputbeschoeiing te realiseren. De stabiliteit van de grondkering wordt verzekerd door verankeringen en/of schoringen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel> a owl:Class;
  rdfs:comment "Stalen profiel, bijvoorbeeld een H-profiel, dat wordt gebruikt als fundering of wapening van een fundering. Dit is geen profiel voor een damwand: hiervoor moet 'Stalen damplank' worden gebruikt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VasteWaterbouwkundigeConstructie> a owl:Class;
  rdfs:comment "Statische bouwkundige constructie in of aan een waterloop al dan niet in combinatie met een beweegbare waterkerende constructie, om grond en een waterpeilverschil te keren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand> a owl:Class;
  rdfs:comment "Een verticaal constructiedeel,vrijstaand of omsluitend die een afscheiding vormt,bv. tussen 2 ruimtes."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementSluisStuw>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElementAanvaarbeschermingGeleidewerk> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Aardingsinstallatie> a owl:Class;
  rdfs:comment "Een galvanische verbinding van een elektrische installatie met de aarde. De elektrische installatie die op deze wijze met de aarde wordt verbonden krijgt een spanning van nul volt."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Aswegersite> a owl:Class;
  rdfs:comment "Het geheel van infrastructuurelementen en toestellen op één locatie voor de exploitatie van een asweger."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brugligger> a owl:Class;
  rdfs:comment "Ondersteunende balkstructuur van een brug onder,boven of aansluitend op het brugdek."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug> a owl:Class;
  rdfs:comment "Complex datatype om de burgerlijke klasse van een brug te bepalen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kokersectie> a owl:Class;
  rdfs:comment "Een kokersectie is een deel van een serie elementen waaruit een kokercomplex is opgebouwd."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kolk> a owl:Class;
  rdfs:comment "Vaste waterbouwkundige constructie van een sluis tussen sluishoofden, met een regelbaar waterniveau, waarin een schip van het ene niveau naar het andere kan gaan."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kolkvloer> a owl:Class;
  rdfs:comment "De vloer van de kolk. De vloer dient opgesplitst te worden per moot, elke moot heeft een aparte vloer."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Landhoofd> a owl:Class;
  rdfs:comment "Eindsteunpunt van een brug die de overgang vormt naar het achterliggend grondlichaam én als hoofdfunctie heeft de brug te ondersteunen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Omloopriool> a owl:Class;
  rdfs:comment "Een vaste waterbouwkundige constructie voor het nivelleren van een sluis."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Randafwerking> a owl:Class;
  rdfs:comment "Profiel ter afwerking van de rand. Deze kan uitgevoerd worden in verschillende materialen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DetaiplanObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole> a owl:Class;
  rdfs:comment "Trajectcontrole is een systeem waarbij de gemiddelde snelheid over een langere afstand wordt gemeten."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De asset hoeft geometrisch niet gelokaliseerd te worden."@nl;
  rdfs:comment "Binnen de L2 access structuur vormt de VLAN een specifieke virtuele LAN. De toepassingen zijn verbonden met een specifieke VLAN. Rechtstreekse communicatie tussen toepassingen is enkel mogelijk indien deze zijn verbonden met dezelfde VLAN."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand> a owl:Class;
  rdfs:comment "Versteviging van de grond door een rooster van ankers (nagels), waarbij de oppervlakte tussen de ankers gestabiliseerd wordt door middel van gewapend spuitbeton."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Zpad> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De asset hoeft geometrisch niet gelokaliseerd te worden."@nl;
  rdfs:comment "End-to-end gebruikersverbinding over het transport netwerk."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Combiwand> a owl:Class;
  rdfs:comment "Een gecombineerde wand bestaande uit verschillende damplanken en buispalen of H-profielen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogenWand>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogen>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcDVWtoelaatbareSchipsafemetingen> a owl:Class;
  rdfs:comment "Complexe datatype om de toelaatbare schipsafmetingen bij te houden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#DtcOntwerpSchip> a owl:Class;
  rdfs:comment "Complexe datatype om de afmetingen van het ontwerpschip bij te houden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GewapendeGrond> a owl:Class;
  rdfs:comment "Grondkering waarbij constructieve elementen van staal of geotextiel/geogrid samenwerken met de grond en daaruit stabiliteit ontwikkelen. Gewapende grond is ook wel gekend als 'terre armée'."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#LEDRotondeafbakening> a owl:Class;
  rdfs:comment "De verzameling van actieve lichtgevende modules ter hoogte van één toerit die ingeslepen worden in, of geplaatst worden op, de boordsteen van een rotonde en als doel hebben om de rand van de rotonde duidelijk zichtbaar te maken."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMAfbakening> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Stuw> a owl:Class;
  rdfs:comment "Beweegbare of vaste waterbouwkundige constructie tussen twee waterlichamen met als doel het waterpeil/waterdebiet te reguleren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#OntwerpwaterstandStreefpeil> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling> a owl:Class;
  rdfs:comment "Het geheel van verticale verkeerssignalisatie die bevestigd is aan één of meerdere draagconstructies op éénzelfde geolocatie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Signalisatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gronddam> a owl:Class;
  rdfs:comment "Gronddammen zijn trapeziumvormige constructies bestaande uit zand, grond of steenachtige materialen. De onderkant van de gronddam wordt direct op het bestaand maaiveld aangebracht of op een vooraf aangebrachte grondverbetering. Een gronddam kan volgende functies vervullen: geluidswering, geleiding van dieren, veiligheid en lichtwering."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#LEDWegdekreflectorBebakening> a owl:Class;
  rdfs:comment "De verzameling van op de rijbaan verankerde actieve lichtmodules. De modules hebben als doel de randen van de rijbaan of de grenzen tussen rijstroken te markeren of gevaarlijke plaatsen te signaleren. De verzameling bundelt de actieve reflectoren die hetzelfde obstakel of risico aanduiden."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#EMAfbakening> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Meteostation> a owl:Class;
  rdfs:comment "Het geheel van meteorologische sensoren en andere infrastructuurelementen die samen een meteostation vormen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#MeetstationAbstract> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De asset hoeft geometrisch niet gelokaliseerd te worden."@nl;
  rdfs:comment "Inhoudelijke definitie van de betekenis van een verkeersbord zoals opgenomen in de wegcode."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brug> a owl:Class;
  rdfs:comment "Een beweegbare,vaste of drijvende verbinding voor het verkeer tussen twee punten,die door water of iets anders gescheiden zijn."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#HydraulischeCilinder> a owl:Class;
  rdfs:comment "Hydraulisch aangedreven actuator waarbij de beweging wordt bewerkstelligd door een inwendige hydraulische druk."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Cilindermechanisme> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#PompGroep> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Gebruik PompGroep voor een modulair systeem."@nl;
  rdfs:comment "Een systeem dat instaat voor het omzetten van elektrische energie in een verplaatsing of drukverhoging van water. In dit geval spreekt men van een pomp. In de omgekeerde situatie spreekt men van een turbine."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#RadioheruitzendInstallatie> a owl:Class;
  rdfs:comment "Het geheel van ontvangstantenne, infrastructuur en straalkabel of zendantenne om de radiosignalen van radiozenders over FM (88 tot 108 MHz) of DAB (174 tot 230 MHz) uit te zenden op plaatsen, die afgesloten zijn van de buitenwereld, zoals tunnels en ondergrondse parkings."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GeluidwerendeConstructie> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "De geometrie van de z-coördinaat dient overeen te stemmen met de bovenkant van de geluidwerende constructie."@nl;
  rdfs:comment "Een geluidswerende wandvormige constructie bestaande uit een desgevallend geluidsisolerend materiaal en/of geluidsabsorberend materiaal en voorzien van de nodige structuren om de bouwkundige stabiliteit te verzekeren."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Leuning> a owl:Class;
  rdfs:comment "Een leuning is een constructie waaraan men met een hand steun of stabiliteit kan vinden om niet in de diepte te vallen. Ze kan bestaan uit een stevige balk, strip of touw maar ook uit een boven- en onderregel en stijlen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidSluisStuw>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidKoker>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#DetaiplanObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Meetstation> a owl:Class;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.14.0 "@nl;
  rdfs:comment "De plaats waar verschillende sensoren samen 1 meetstation vormen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Koker> a owl:Class;
  rdfs:comment "Een koker is een opdeling van het kokercomplex in de lengte richting, het heeft een doorvoerende functie met een in- en uitgang en eventuele zijgangen, die met een gesloten doorsnede verbonden zijn. "@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pompkamer> a owl:Class;
  rdfs:comment "Elk volume,inclusief de bouwkundige elementen die dit volume bepalen,dat deel uitmaakt van het waterbouwkundig systeem van het pompstation en als zodanig onder water kan staan."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kokerruimte>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#PutRelatie> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeWaterkerendeConstructie> a owl:Class;
  rdfs:comment "Constructie, al dan niet opgebouwd uit meerdere op elkaar stapelbare elementen, voor het droogzetten van een (onderdeel van een) sluis of stuw."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brugdeel> a owl:Class;
  rdfs:comment "Het deel dat je kan wegnemen van een brug in zijn geheel. Dit kan ook meerdere overspanningen hebben. In het geval van beweegbare bruggen worden de onderdelen die de beweging mogelijk maken zoals balansarmen, tegengewicht, hameipoort,..etc ook gevat in het object brugdeel."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Damwand> a owl:Class;
  rdfs:comment "Een grond- en/of waterkerende constructie,die bestaat uit een verticaal in de grond geplaatste wand."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructieElement>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Sluis> a owl:Class;
  rdfs:comment "Waterbouwkundige constructie tussen twee waterlichamen met een verschillend waterpeil. Sluizen hebben als doel het beheersen van het waterpeil en het gecontroleerde doorlaten van schepen."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#OntwerpwaterstandStreefpeil> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MIVMeetpunt> a owl:Class;
  rdfs:comment "Een meetpunt van Meten-In-Vlaanderen als plaats waar beide meetlussen bij benadering in de weg ingeslepen zijn."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#BeweegbareWaterkerendeConstructie> a owl:Class;
  rdfs:comment "Een beweegbare constructie ontworpen om een waterpeilverschil te keren, inclusief alle gelaste onderdelen die bijdragen aan de structurele integriteit en functionaliteit van de constructie."@nl;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:subClassOf <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject> .

