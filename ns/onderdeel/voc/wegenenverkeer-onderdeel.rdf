  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#VerlichtingstoestelLED.tussenafstandLED">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Afstand, uitgedrukt in meter, tussen de verschillende LED verlichtingstoestellen.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Maximum 1 cijfer na de komma ingeven.</ns0:usageNote>
