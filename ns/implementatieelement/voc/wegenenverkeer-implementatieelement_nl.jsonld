    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#Pipe",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een buis die dienst kan doen als object voor het omhullen van meerdere kabels of andere (kleinere) leidingen."
      },
      "usage": {
        "nl": "Gebruik dit type enkel voor aanlevering voor AKELA indien geen specifieke types aanwezig zijn in OTL."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#OmhullendeInrichting",
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Leiding"
      ]
    },
