  rdfs:comment "De oppervlakte van de brug, uitgedrukt in vierkante meter. Dit is meestal de breedte maal lengte."@nl;
  rdfs:domain <https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brug>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInVierkanteMeter> .

