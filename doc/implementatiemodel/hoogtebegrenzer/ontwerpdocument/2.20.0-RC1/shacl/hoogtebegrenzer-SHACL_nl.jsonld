    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/hoogtebegrenzer/ontwerpdocument/2.20.0-RC1#SeinbrugShape",
      "@type": "sh:NodeShape",
      "sh:closed": false,
      "sh:property": [
        {
          "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/hoogtebegrenzer/ontwerpdocument/2.20.0-RC1#SeinbrugShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
          "rdfs:seeAlso": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/hoogtebegrenzer/ontwerpdocument/2.20.0-RC1#Seinbrug%3ABevestiging",
          "sh:description": {
            "nl": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
          },
          "sh:name": {
            "nl": "Bevestiging"
          },
          "sh:nodekind": "sh:BlankNodeOrIRI",
          "sh:path": "https://wegenenverkeer-test.data.vlaanderen.be/doc/implementatiemodel/hoogtebegrenzer/#Bevestiging",
          "vl:message": {
            "nl": "De verwachte waarde voor Bevestiging is een rdfs:Resource (URI of blank node)"
          },
          "vl:rule": ""
        },
        {
          "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/hoogtebegrenzer/ontwerpdocument/2.20.0-RC1#SeinbrugShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
