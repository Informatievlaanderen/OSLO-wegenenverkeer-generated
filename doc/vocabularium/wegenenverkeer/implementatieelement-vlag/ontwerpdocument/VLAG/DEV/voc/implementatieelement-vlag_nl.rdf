    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#KwantWrdInMillimeter"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.isCementMetBeperktAlkaligehalte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">Aanduiding of het cement een beperkt alkaligehalte heeft (LA).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.isCementMetHogeAanvangssterkte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het cement gebruikt wordt voor een snelle binding (bijvoorbeeld in de winter) (HES).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.isCementMetHogeBestandheidTegenSulfaten">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het cement een hoge bestandheid heeft tegen sulfaten (SR).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.isCementMetLageHydratatiewarmte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het cement gebruikt wordt voor een tragere sterkteontwikkeling (LH).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.isColloidaalbeton">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het beton zich niet ontmengt onder of in water.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.technischeFiche">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">De technische fiche van het beton. Deze moet volgende eigenschappen bevatten: de norm waaraan het beton voldoet, de sterkteklasse, de duurzaamheid (bestaande uit het gebruiksdomein en de omgevingsklasse(n)), de consistentieklasse, de nominale grootste korrelafmeting,...</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.5.0-RC1</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.technischeFicheSpecificatiesBeton">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">De technische fiche van de specificaties van het beton. Deze moet volgende eigenschappen bevatten: de norm waaraan het beton voldoet, de sterkteklasse, de duurzaamheid (bestaande uit het gebruiksdomein en de omgevingsklasse(n)), de consistentieklasse, de nominale grootste korrelafmeting,...</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag#DtcBetonspecificaties.toeslagmiddelen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement-vlag"/>
    <rdfs:comment xml:lang="nl">Materialen die aan het beton worden toegevoegd om vb.: een beter geheel te maken, holle ruimten te vullen waardoor de sterkte toeneemt, ruimten met minder massa te creëren,... Dit kunnen er meerdere zijn.</rdfs:comment>
