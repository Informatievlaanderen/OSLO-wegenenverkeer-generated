  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling.hoek> a owl:ObjectProperty;
  <http://purl.org/vocab/vann/usageNote> "hoek"@nl;
  rdfs:comment "De hoek waarin het fysiek bord gepositioneerd is ten opzichte van een vooropgestelde as."@nl;
  rdfs:domain <https://wegenenverkeer.data.vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
