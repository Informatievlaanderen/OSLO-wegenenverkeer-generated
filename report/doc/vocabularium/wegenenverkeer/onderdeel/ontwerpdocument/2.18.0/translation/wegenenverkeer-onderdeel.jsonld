    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#HoutenHeipaal",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Houten Heipaal"
      },
      "definition": {
        "nl": "De houten paal wordt in de grond gebracht door deze in een hei-installatie te plaatsen waarna men er een zwaar gewicht (heiblok) op laat vallen. De grond onder de paal wordt verdreven en verdicht waardoor de draagkracht groter wordt."
      },
