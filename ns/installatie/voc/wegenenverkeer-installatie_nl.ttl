  rdfs:range <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balans.isGevuldMetTegengewicht> a owl:DatatypeProperty;
  rdfs:comment "Aanduiding of de balans al dan niet gevuld is met een tegengewicht."@nl;
  rdfs:domain <https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balans>;
