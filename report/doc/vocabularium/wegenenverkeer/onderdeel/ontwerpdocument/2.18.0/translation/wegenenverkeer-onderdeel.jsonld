    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Terugslagklep",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Terugslagklep"
      },
      "definition": {
        "nl": "Een terugslagklep is een klep die dient om water, vloeistof, granulaat, poeder of gas in één richting door te laten. Meestal duwt het medium de klep bij het heenstromen open en sluit een veer of de zwaartekracht de klep."
      },
      "label": {
        "nl": "Terugslagklep"
      },
      "definition-nl": {
        "nl": "Een terugslagklep is een klep die dient om water, vloeistof, granulaat, poeder of gas in één richting door te laten. Meestal duwt het medium de klep bij het heenstromen open en sluit een veer of de zwaartekracht de klep."
      },
      "extra": {
