  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#Appurtenance.opstelhoogte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
