    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">Het volume van het totale betonnen object uitgedrukt in kubieke meter.</rdfs:comment>
