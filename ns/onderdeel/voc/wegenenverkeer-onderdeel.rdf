    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Galgpaal"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter"/>
  </owl:ObjectProperty>
