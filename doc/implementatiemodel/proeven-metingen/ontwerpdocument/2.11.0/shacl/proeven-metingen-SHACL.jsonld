        {
          "@id": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/proeven-metingen/ontwerpdocument/2.11.0#BuisShape/41fb05a836ddf8d92afbe3357e2a826e8455fda9",
          "rdfs:seeAlso": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/proeven-metingen/ontwerpdocument/2.11.0#Buis%3AOmhult",
          "sh:description": {
            "nl": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
          },
          "sh:name": {
            "nl": "Omhult"
          },
