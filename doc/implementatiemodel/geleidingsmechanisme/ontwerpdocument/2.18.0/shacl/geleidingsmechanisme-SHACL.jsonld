          "@id": "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.0#VeerhuisShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
