    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/DEV#GeluidsschermelementShape",
      "@type": "sh:NodeShape",
      "sh:closed": false,
      "sh:property": [
        {
          "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/DEV#GeluidsschermelementShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
          "rdfs:seeAlso": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/DEV#Geluidsschermelement%3ABevestiging",
          "sh:description": {
            "nl": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
          },
          "sh:name": {
            "nl": "Bevestiging"
          },
