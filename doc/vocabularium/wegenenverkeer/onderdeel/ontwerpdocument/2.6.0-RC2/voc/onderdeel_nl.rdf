</owl:ObjectProperty>

<owl:Class rdf:about='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VerkeerslichtWit'>
<rdfs:comment xml:lang='nl'>Een witte lichtbron om het verkeer te regelen van voertuigen van personentransport.</rdfs:comment>

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

