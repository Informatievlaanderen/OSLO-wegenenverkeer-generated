  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand.hOhAfstandPalen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Hart op hart afstand tussen palen in de wand.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Een secans- of tangenspalenwand bestaat uit betonnen boorpalen. Bij de secanspalenwand zijn dit primaire en secundaire, in elkaar oversneden palen. Bij de tangenspalenwand snijden de boorpalen niet in elkaar in (geen overlap). De wand heeft tot doel een bouwputbeschoeiing te realiseren. De stabiliteit van de grondkering wordt verzekerd door verankeringen en/of schoringen.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterremmendeFunctie"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand.heeftInsnijdendePalen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Bepaling of er insnijdende palen aanwezig zijn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand.rekennota">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De bijhorende rekennota met berekeningen.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Slagboom.isManueel">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Geeft aan of de slagboom (uitsluitend) manueel bediend wordt of door een aangestuurde motor in de slagboomkolom.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Voor een manuele slagboom zijn geen instanties van de onderliggende onderdelen Slagboomkolom en Slagboomarm vereist.</ns0:usageNote>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Slagboom">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Een afsluitingsmechanisme met slagboomarmen dat dient om controle uit te kunnen oefenen over het gebruik van een doorgang of een toegang.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Soilmixwand">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een cutter soilmixwand (CSM-wand) is een aansluitende kerende wand bestaande uit elkaar overlappende moten in de grond gevormd. Deze heeft een grond- en waterkerende functie.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenCaisson">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Dit is een samengesteld element bestaande uit twee of meerdere warmgewalste stalen damplanken met Z- of U-vorm.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel.aanzetpeilSlot">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Aanzetpeil van het slot.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Stalen profiel, bijvoorbeeld een H-profiel, dat wordt gebruikt als fundering of wapening van een fundering. Dit is geen profiel voor een damwand: hiervoor moet 'Stalen damplank' worden gebruikt.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Funderingspaal"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel.inbrengmethode">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Keuzelijst om de inbrengmethode toe te lichten.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel.isSlotAanwezig">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Geeft aan of er al dan niet een slot aanwezig is.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenFunderingsprofiel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeBerlinerwandTussenschot.aanzetpeil">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Aanzetpeil van het element in mTaw.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeBerlinerwandTussenschot">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Het tussenschot (plaat of plank tussen profielen) voor een tijdelijke berlinerwand. Om een berlinerwand te definiëren die permanent in de grond blijft, moeten de specifieke (materiaal)onderdelen gebruikt worden.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeBerlinerwandTussenschot.materiaal">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het materiaal voor het tijdelijke tussenschot.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeBerlinerwandTussenschot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeOpslagplaats">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Permanent terrein voor tijdelijke opslag van materialen, grond, maaisel etc. gedurende de uitvoering van werken. Het opgeslagen materiaal wordt na de uitvoering van de werken van het terrein verwijderd.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole.attest">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het ijkingsattest van de trajectcontrole in zijn geheel.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Bestanden van het type pdf.</ns0:usageNote>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Trajectcontrole is een systeem waarbij de gemiddelde snelheid over een langere afstand wordt gemeten.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole.nTP">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Aanduiding of het systeem voor zijn tijdsaanduiding gebruik maakt van NTP.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole.rijrichting">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De rijrichting van de voertuigen die gecontroleerd worden.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole.snelheidsregime">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het snelheidsregime waarop de voertuigen worden gecontroleerd.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trajectcontrole"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trappentoren">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een trappentoren is een geïntegreerde constructie van trappen die kan dienen om 1 of meerdere niveaus te beklimmen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidKoker"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trekker.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het type van de trekker.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trekker">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Een langwerpig (lijnvormig) element dat op trek wordt belast. Dit maakt de verbinding tussen het brugdek en de hoofddraagstructuur van het brugdeel (vb.: tussen boog en brugdek, tussen pyloon en brugdek, tussen draagkabel en brugdek, tussen windverband onder de brug en brugdek).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Tunnelverlichting">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het systeem van verlichtingselementen en armaturen, typisch ontworpen en geïnstalleerd in een tunnel, om aangepaste lichtniveaus volgens verschillende regimes te bieden voor veilig verkeer en zichtbaarheid binnenin een koker.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN.defaultGateway">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het IP adres van de gateway. Binnen een deelnetwerk is de Gateway de toegangspoort tot het ruimere netwerk.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Binnen de L2 access structuur vormt de VLAN een specifieke virtuele LAN. De toepassingen zijn verbonden met een specifieke VLAN. Rechtstreekse communicatie tussen toepassingen is enkel mogelijk indien deze zijn verbonden met dezelfde VLAN.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#NaampadObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DteIPv4Adres"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN.ipMask">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Bepaalt welke range van IP adressen beschikbaar zijn in een netwerk.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DteIPv4Adres"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN.ipSubnet">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Identificatie van een IP netwerk binnen een ruimer netwerk.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DteIPv4Adres"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN.vlanId">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Identificeert een VLAN met een getal tussen 0 en 4095.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VLAN"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VakwerkElement.typeVakwerkElement">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het type van vakwerk-element.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VakwerkElement">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Element dat deel uitmaakt van een constructie waarbij balken en staven, volgens een stelsel van rechthoeken en/of driehoeken, aan de uiteinden en/of kruiselings verbonden worden tot een onwrikbaar geheel.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ventilatiecluster">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een systeem van ventilatoren die samenwerken om de luchtstroom en luchtkwaliteit in een deel van de koker of een specifieke ruimte te reguleren en te verbeteren.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ventilatiekanaal.materiaal">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het materiaal van een ventilatiekanaal verwijst naar de substantie waaruit het kanaal is vervaardigd.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ventilatiekanaal">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Een buis die paarsgewijs zorgt voor passieve verluchting van een afgesloten ruimte door langs de ene buis lucht naar binnen en door de andere naar buiten te laten stromen op basis van de hoogte ten opzichte van elkaar.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ventilatiekanaal.oppervlakte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De oppervlakte van het ventilatiekanaal is de totale doorsnede van het kanaal en vertegenwoordigt het gebied dat beschikbaar is voor de luchtstroom binnenin.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Ventilatiekanaal"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInVierkanteMeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept.afbeelding">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De afbeelding van het verkeersbordconcept.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Inhoudelijke definitie van de betekenis van een verkeersbord zoals opgenomen in de wegcode.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept.betekenis">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Betekenis die gegeven wordt aan dit soort verkeersbord volgens de wegcode.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept.rechtsgrondOnderdeel">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Verwijst naar een rechtsgrondonderdeel over dit verkeersbordconcept.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Verwijst meestal naar een artikel in de wegcode die informatie over dit verkeersbordconcept bevat. Bijvoorbeeld: artikel 68.3 voor verbodsborden.</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcExterneReferentie"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept.status">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Duidt of het verkeersbordconcept nog gebruikt wordt.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Bijvoorbeeld: stabiel, onstabiel, afgeschaft. Een bord met snelheidslimiet van 60 km/u is bijvoorbeeld afgeschaft.</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept.verkeersbordCategorie">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Categorie van het verkeersbordconcept.	.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept.verkeersbordCode">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Code die aan dit soort bord gegeven wordt binnen de wegcode.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordConcept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordVerkeersteken.isBeginZone">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Duidt aan of het verkeersteken het begin van een zone aanduidt.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordVerkeersteken">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">De voorstelling door middel van een verkeersbord van een aanwijzing ten behoeve van de weggebruikers die verbonden wordt aan het aankondigen of opleggen van een bepaalde verkeersmaatregel zoals bepaald in de wegcode.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verkeersteken"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordVerkeersteken.isEindeZone">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Duidt aan of het verkeersteken het einde van een zone aanduidt.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VerkeersbordVerkeersteken"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling.afbeelding">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Grafische weergave van de opstelling geplaatst op het openbaar domein.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Een bestand dat een afbeelding weergeeft.</ns0:usageNote>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Het geheel van verticale verkeerssignalisatie die bevestigd is aan één of meerdere draagconstructies op éénzelfde geolocatie.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Signalisatie"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling.isBotsvriendelijk">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een botsvriendelijk obstakel is een voorwerp dat bij aanrijding door een voertuig de letselernst voor de inzittenden reduceert.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling.operationeleStatus">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Operationele status van de Verkeersbordopstelling volgens keuzelijst.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Enkel te gebruiken wanneer een object 'in gebruik' is. Zie ook attribuut toestand overgeërfd van AIMToestand om de asset levenscyclus aan te duiden.</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling.positieTovRijweg">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De plaatsing van de opstelling ten aanzien van de rijbaan.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Bijvoorbeeld: boven, rechts, links</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling.wegSegment">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Wegsegment waarbij de verkeersbordopstelling geplaatst is.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Dit is niet noodzakelijk het wegsegment waarop het verkeersbord van toepassing is.</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verkeersbordopstelling"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcExterneReferentie"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand.detailplan">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Plan met details van de opbouw van de vernagelde wand.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Versteviging van de grond door een rooster van ankers (nagels), waarbij de oppervlakte tussen de ankers gestabiliseerd wordt door middel van gewapend spuitbeton.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand.hOhAfstandGrondankers">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Hart op hart afstand tussen grondankers in de wand.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand.hellingshoek">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Hoek van de vernagelde wand t.o.v. de grond in decimale graden.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInDecimaleGraden"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand.rekennota">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De bijhorende rekennota met berekeningen.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VersterkingsverlichtingTunnel">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een aanvullend verlichtingssysteem aan de in -en uitgang van de koker met verschillende regimes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Vluchtdeurindicatie">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De componenten die visuele of audiovisuele aanwijzingen bieden over de plaats in een koker waar een vluchtdeur of vluchtopening te vinden is,zodat mensen snel en effectief kunnen worden geleid naar veilige uitgangen tijdens een noodsituatie.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Vluchtganginrichting">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het geheel van componenten die ontworpen zijn om snel en effectief de evacuatie van mensen te faciliteren in een koker die dienst doet als vluchtgang in geval van een calamiteit.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Vluchtgeleiding">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het geheel van componenten die ontworpen zijn om snel en effectief de evacuatie van mensen te faciliteren vanuit de voertuigkoker/rijwegkoker tot een veilige ruimte</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Vluchtroute">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Verzameling van technieken die de routes waarlangs de weggebruiker het kunstwerk kan verlaten aanduiden.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VoorzieningNegatieveReactie">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Voorziening om opwaartse reacties ter hoogte van de steunpunten tegen te gaan, bv. stalen staven. Dit element maakt de verbinding tussen brugdeel en landhoofd/pijler en bevindt zich in de onmiddellijke omgeving van de opleggingen. De oplegging (dit is een andere klasse) kan zowel druk als trek opnemen en kan ook gebruikt worden als een voorziening tegen negatieve reactie.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand.isDragend">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Geeft aan of de wand dragend is, al dan niet.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Een verticaal constructiedeel,vrijstaand of omsluitend die een afscheiding vormt,bv. tussen 2 ruimtes.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand.typeWand">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De functie die de wand uitoefent.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand.zijden">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het type van de zijden dat de wand heeft (recht, rond, schuin,...).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wand"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#WaterdoorvoerendeDuiker">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een kokervormige constructie, die is bedoeld om wateren met elkaar te verbinden. Bij een duiker wordt in principe de bodem van de watergang onderbroken, dit in tegenstelling tot een brug.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
  </owl:Class>
  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Waterweg">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Een waterweg is, volgens het juridisch statuut, een bevaarbaar waterlichaam dat zorgt voor het transporteren van de horizontale afvloeiing van neerslag- en bronwater en zich typisch leent tot scheepvaart.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#WaterloopRelatie"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wegberm.bijzonderIngerichteOnderdelen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De bijzonder ingerichte onderdelen van de wegberm.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Klasse uit gebruik sinds versie 2.11.0 </ns0:usageNote>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wegberm">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Gedeelte van het wegplatform dat buiten de rijbanen ligt. Een wegberm kan sloten en bijzonder ingerichte onderdelen bevatten.</rdfs:comment>
        <ns0:usageNote xml:lang="nl">Klasse uit gebruik sinds versie 2.11.0 </ns0:usageNote>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"/>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#TerreinDeel"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wegberm.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het type van wegberm.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Klasse uit gebruik sinds versie 2.11.0 </ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wegberm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wilddetectiezone.afmeting">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">De afmetingen van de wilddetectiezone.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Wilddetectiezone">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">De wilddetectiezone van een wilddetectiesysteem betreft de nabije zone rond de detectiesystemen (zoals een bewegingssensor). Deze zone vereist extra onderhoud, om valse detecties te voorkomen.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAfmetingBxlInM"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Windverband.type">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Type windverband.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Windverband">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Ook: kruisverband. Stabiliteitsvoorziening om een constructie stijf te maken. Vangt windbelastingen, spatkrachten en dwarskrachten op. Ze bestaan meestal uit vrijwel onwrikbare (onvervormbare) driehoeken.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ConstructiefObject"/>
      </owl:Class>
    </rdfs:domain>
