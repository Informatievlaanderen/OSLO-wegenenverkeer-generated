  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting#ProefTextuurdiepte.textuurdiepte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/proefenmeting"/>
