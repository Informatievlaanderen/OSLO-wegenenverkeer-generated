    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Neerslagsensor",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "label-nl": {
        "nl": "Neerslagsensor"
      },
      "definition": {
        "nl": "Detectie van neerslag(hoeveelheid/intensiteit)."
      },
      "label": {
        "nl": "Neerslagsensor"
