<rdfs:domain rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#OmegaElement' />

<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel' />

