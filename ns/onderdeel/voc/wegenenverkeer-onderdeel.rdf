        <rdfs:comment xml:lang="nl">Een afsluiter die vanop afstand bediend wordt om te verhinderen dat er water in de leiding blijft staan.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Brandvoorziening"/>
      </owl:Class>
