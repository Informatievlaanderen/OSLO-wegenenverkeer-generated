        {
            "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Ophangportaal",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "definition": {
                "nl": "Het ophangportaal is een systeem dat wordt gebruikt om de deuren van een sluis te openen en te sluiten. Het ophangportaal bevindt zich meestal boven de sluiskolk en is verbonden met de sluisdeuren via een ketting- of tandwielmechanisme. Wanneer het portaal wordt geactiveerd, worden de sluisdeuren geopend of gesloten, waardoor het water kan stromen of stilstaan, afhankelijk van het type sluis en de huidige waterstand."
            },
            "label": {
                "nl": "Ophangportaal"
            },
            "ap-label-nl": {
                "nl": "Ophangportaal"
            },
            "ap-definition-nl": {
                "nl": "Het ophangportaal is een systeem dat wordt gebruikt om de deuren van een sluis te openen en te sluiten. Het ophangportaal bevindt zich meestal boven de sluiskolk en is verbonden met de sluisdeuren via een ketting- of tandwielmechanisme. Wanneer het portaal wordt geactiveerd, worden de sluisdeuren geopend of gesloten, waardoor het water kan stromen of stilstaan, afhankelijk van het type sluis en de huidige waterstand."
            },
