          "sh:name": {
            "nl": "Bevestiging"
          },
          "sh:path": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/master/#Bevestiging",
          "vl:message": {
            "nl": "De range van Bevestiging moet van het type <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Cilinderkop> zijn."
          },
          "vl:rule": ""
        },
