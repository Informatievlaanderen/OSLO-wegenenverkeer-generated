      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#PiezometrischeBuis">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">Een al dan niet permanente buis om waterstanden bij grondverlaging te meten.</rdfs:comment>
