    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De totale lengte van de beschoeiing langs de sleuf in lopende meter.</rdfs:comment>
