        <rdfs:comment xml:lang="nl">Complex datatype voor de inventarisatie van het type beschermlaag en de corrosiebelastingscategorie.</rdfs:comment>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBeschermendeLaag.corrosieklasse">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Een code om de mate van corrosieve belasting in een bepaalde omgeving te beschrijven, volgens ISO-12944-2.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBeschermendeLaag"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.betondekking">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De afstand in millimeter tussen de buitenkant van het beton (het oppervlak van het beton) tot het dichtstbijzijnde wapeningsstaal.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
        <rdfs:comment xml:lang="nl">Complex datatype om de eigenschappen van beton te bundelen. Deze omvat onder andere de verschillende betonklassen,hoe het beton gebruikt wordt,eigenschappen van het cement,een technische fiche van het beton,...</rdfs:comment>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.betonmilieuklassen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Milieuklassen (X-klassen) leggen rechtstreeks de link met bepaalde aantastingsmechanismen, waaraan de betonconstructie (of een onderdeel ervan) wordt blootgesteld tijdens het gebruik. Er kunnen meerdere milieuklassen van toepassing zijn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.betonomgevingsklassen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De omgeving waaraan de betonconstructie (of een onderdeel ervan) wordt blootgesteld tijdens het gebruik. Er kunnen meerdere omgevingsklassen van toepassing zijn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.betonsterkteklasse">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De sterkteklasse is een maat voor de druksterkte van beton.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.gebruiksdomein">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De gebruiksomstandigheden van het beton. Dit bepaalt tevens het maximum chloridegehalte.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.grootsteKorrelafmetingDmax">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De nominale grootste korrelafmeting (Dmax).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.isCementMetBeperktAlkaligehalte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Aanduiding of het cement een beperkt alkaligehalte heeft (LA).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.isCementMetHogeAanvangssterkte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het cement gebruikt wordt voor een snelle binding (bijvoorbeeld in de winter) (HES).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.isCementMetHogeBestandheidTegenSulfaten">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het cement een hoge bestandheid heeft tegen sulfaten (SR).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.isCementMetLageHydratatiewarmte">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het cement gebruikt wordt voor een tragere sterkteontwikkeling (LH).</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.isColloidaalbeton">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Geeft aan of het beton zich niet ontmengt onder of in water.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.technischeFiche">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De technische fiche van het beton. Deze moet volgende eigenschappen bevatten: de norm waaraan het beton voldoet, de sterkteklasse, de duurzaamheid (bestaande uit het gebruiksdomein en de omgevingsklasse(n)), de consistentieklasse, de nominale grootste korrelafmeting,...</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Attribuut uit gebruik sinds versie 2.5.0-RC1</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.technischeFicheSpecificatiesBeton">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De technische fiche van de specificaties van het beton. Deze moet volgende eigenschappen bevatten: de norm waaraan het beton voldoet, de sterkteklasse, de duurzaamheid (bestaande uit het gebruiksdomein en de omgevingsklasse(n)), de consistentieklasse, de nominale grootste korrelafmeting,...</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties.toeslagmiddelen">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Materialen die aan het beton worden toegevoegd om vb.: een beter geheel te maken, holle ruimten te vullen waardoor de sterkte toeneemt, ruimten met minder massa te creëren,... Dit kunnen er meerdere zijn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcBetonspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcCameraBeeldverwerking.configBestand">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Een bestand met de details van de configuratie voor het type beeldverwerking dat gekozen is in het type-attribuut van de instantie.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcCameraBeeldverwerking">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
        <rdfs:comment xml:lang="nl">Complex datatype waarmee een type beeldverwerking van een camera en het relevant configuratiebestand, bijgehouden worden.</rdfs:comment>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcCameraBeeldverwerking.typeBeeldverwerking">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Geeft aan welk type beeldverwerking als onlosmakelijk deel van de camera geconfigureerd is.</rdfs:comment>
    <ns0:usageNote xml:lang="nl">Wanneer de camera de beeldverwerking niet zelf doet maar enkel beelden  verstuurt voor verwerking in een externe eenheid, moet die externe eenheid als aparte asset aangemaakt worden indien het specifieke type bestaat in de OTL of moet een instantie van Software gebruikt worden wanneer geen specifieke externe verwerkingseenheid voorzien is.</ns0:usageNote>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcCameraBeeldverwerking"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcConstructiestaalspecificaties.staalsoort">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Staalkwaliteit die wordt gebruikt volgens Europese normen.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcConstructiestaalspecificaties">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
        <rdfs:comment xml:lang="nl">Complex datatype om de eigenschappen van constructiestaal te bundelen.</rdfs:comment>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcConstructiestaalspecificaties.walsmethode">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Op welke manier het staal gewalst is.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcConstructiestaalspecificaties"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument.bestandsnaam">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">De naam van het Document inclusief de bestandsextensie, van de naam gescheiden door een punt.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument.mimeType">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Het MIME type van het document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument.omschrijving">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
    <rdfs:comment xml:lang="nl">Een korte toelichting over waar het document juist voor dient.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument"/>
    <rdfs:range>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DteTekstblok">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
        <rdfs:comment xml:lang="nl">Een tekst welke uit meerdere zinnen bestaat, en ook regeleindes kan bevatten. Een tekstblok bevat maximaal 65.000 karakters.</rdfs:comment>
      </owl:Class>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument.opmaakdatum">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement"/>
