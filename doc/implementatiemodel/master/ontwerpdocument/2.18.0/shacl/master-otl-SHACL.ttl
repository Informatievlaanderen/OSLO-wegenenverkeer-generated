  shacl:path <https://wegenenverkeer.data.vlaanderen.be/doc/implementatiemodel/master/#Bevestiging>;
  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Pen> zijn."], [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De range van Bevestiging moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Pen> zijn."];
  <https://data.vlaanderen.be/ns/shacl#rule> "" .

