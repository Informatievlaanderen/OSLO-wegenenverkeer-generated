<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#RiooltoegangShape/21f219edbc3aebd4d4f3c8de99d8a1e420faf466> rdfs:seeAlso "https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0#Riooltoegang%3ASluit%20aan%20op";
  shacl:description "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."@nl;
  shacl:name "Sluit aan op"@nl;
  shacl:nodekind "sh:BlankNodeOrIRI";
  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/2.18.0nl> "De verwachte waarde voor Sluit aan op is een rdfs:Resource (URI of blank node)"];
  <https://data.vlaanderen.be/ns/shacl#rule> "" .

