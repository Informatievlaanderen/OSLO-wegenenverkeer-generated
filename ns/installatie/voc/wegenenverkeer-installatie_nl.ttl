  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.11.0 "@nl;
  rdfs:comment "De horizontale ligging van het baanlichaam als document bijlage."@nl;
  rdfs:domain <https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Baanlichaam>;
  rdfs:isDefinedBy <https://wegenenverkeer.data.vlaanderen.be/ns/installatie>;
  rdfs:range <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument> .

<https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Baanlichaam.langsprofiel> a owl:ObjectProperty;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.11.0 "@nl;
  rdfs:comment "Een langsprofiel is een doorsnijding van een terrein of constructie met een verticaal vlak, aangebracht in de lengterichting van de as ervan."@nl;
  rdfs:domain <https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Baanlichaam>;
