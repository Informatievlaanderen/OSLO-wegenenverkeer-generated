    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">De afstand tussen de vaste drempel en het hoogste punt van de overstortrand in millimeter.</rdfs:comment>
