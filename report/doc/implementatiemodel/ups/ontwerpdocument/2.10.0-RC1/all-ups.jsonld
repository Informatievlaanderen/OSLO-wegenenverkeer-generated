            "name": "Bypass schakelaar"
        },
        {
            "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Spanningsomvormer",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "definition": {
                "nl": "Een apparaat dat de invoerspanning kan omvormen om een andere uitvoerspanning te bekomen. Typisch is dit type apparaat ook in staat om de frequentie van de elektriciteit te veranderen. Het kan dus gelijkspanning omvormen naar wisselspanning (alternator of wisselrichter), wisselspanning naar wisselspanning van een andere frequentie, of wisselspanning naar gelijkspanning (gelijkrichter)."
            },
            "label": {
                "nl": "Spanningsomvormer"
            },
