          "sh:class": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Niveaumeting",
          "sh:description": {
            "nl": "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."
          },
          "sh:name": {
            "nl": "Sturing"
          },
          "sh:path": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/master/#Sturing",
          "vl:message": {
            "nl": "De range van Sturing moet van het type <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Niveaumeting> zijn."
          },
          "vl:rule": ""
