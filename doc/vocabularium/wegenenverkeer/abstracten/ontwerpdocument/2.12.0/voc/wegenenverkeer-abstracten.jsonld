  "classes": [
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AOWSType",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte om alle eigenschappen en relaties van AOWS type onder 1 noemer te houden."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een bundeling van aanhorigheden die bij een brug kunnen horen."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidKoker",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een abstracte klasse die de aanhorigheden bundelt die in een koker kunnen voorkomen zodat de overerving van de bevestigings relatie kan plaatsvinden."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidSluisStuw",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een bundeling van aanhorigheden die bij een Sluis en/of Stuw kunnen horen."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AansluitendeConstructie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte die alle aansluitende constructies bundelt."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AfschermendeConstructie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanvaarbeschermingGeleidewerk",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Een abstracte om de relaties van aanvaarbescherming en geleidewerk te bundelen.\n"
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte om de eigenschappen en relaties van AanvullendeGeometrie te bundelen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus",
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMToestand"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AfmetingenDiepCBWand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor het bundelen van de afmetingen van de diep- en de cement-bentonietwand."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Waterremmend",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Fundering",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Grondkeringen"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AfschermendeConstructie",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte die een lijn- of puntvormige constructie,geïnstalleerd langs de weg om een kerend vermogen te bieden aan een dwalend voertuig,samenvat."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BijlageVoertuigkering",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LijnvormigElement"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AfwijkendeKantopsluiting",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor een kantopsluiting die niet voldoet aan een bepaalde standaard."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Kantopsluiting"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AndereLaag",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte als tussenlaag voor de andere laag-objecten."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Laag",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LaagProductidentificatiecode"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AndereVerharding",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor de andere verhardingen, met een ander fysiek voorkomen van het aardoppervlak dat niet vegetatief is."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ArtificieleLaag"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#ArtificieleLaag",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte als noemer om de abstracten Laag, LaagProductidentificatiecode en LaagDikte te groeperen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Laag",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LaagDikte",
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#LaagProductidentificatiecode"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogen",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor de bundeling van de axiale druk- en trekdraagvermogens,berekend volgens verschillende grenstoestanden."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AxiaalDraagvermogenWand",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor de bundeling van de axiale druk- en trekdraagvermogens van de totale wand,berekend volgens verschillende grenstoestanden."
      },
      "parents": []
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Bebakening",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor de bebakeningen."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Signalisatie",
        "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Beginstuk",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Abstracte voor een stuk aan het uiteinde van een geleideconstructie,met als doel een frontale botsing te reduceren gericht naar het naderende verkeer."
      },
      "parents": [
        "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AfschermendeConstructie"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#BegroeidVoorkomen",
