          "sh:description": {
            "nl": "Geeft aan van wat voor pomp of turbine de waaierl deel uitmaakt. Bij een axiale pomp, wordt de vloeistof in de richting van de as van de waaier verpompt. Bij een radiale pomp, is er een hoek van 90° tussen de as van de waaierl en de richting waarin het vloeistof wordt verpompt. Bij een gemengde pomp ligt de hoek tussen de as van de waaier en de richting van de stroming van de vloeistof ergens tussen deze twee waarden. Voor turbines geldt een analoge terminologie."
          },
          "sh:maxCount": "1",
          "sh:name": {
            "nl": "type opstelling"
          },
          "sh:path": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Waaier.typeOpstelling",
          "vl:message": {
            "nl": "Maximaal 1 waarden toegelaten voor type opstelling"
          },
          "vl:rule": ""
        }
      ],
      "sh:targetClass": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Waaier"
    },
