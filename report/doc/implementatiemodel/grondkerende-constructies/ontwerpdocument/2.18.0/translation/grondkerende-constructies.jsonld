    {
      "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtuHellingsSchoorhoek.schoorhoek",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "name": "schoorhoek",
      "inpackage": "OTHER_PACKAGE",
      "definition": {
        "nl": "Hoek die het object maakt ten opzichte van de verticale, uitgedrukt als een verhouding (1 op x), bijvoorbeeld 1 op 4. Bij verticale palen is er geen sprake van een schoorhoek in verhouding, omdat er geen horizontale afwijking is. In dat geval dient de hoek expliciet als 0 graden aangegeven te worden bij het attribuut Hellingshoek."
      },
      "label": {
        "nl": "schoorhoek"
      },
      "ap-label-nl": {
        "nl": "schoorhoek"
      },
      "ap-definition-nl": {
        "nl": "Hoek die het object maakt ten opzichte van de verticale, uitgedrukt als een verhouding (1 op x), bijvoorbeeld 1 op 4. Bij verticale palen is er geen sprake van een schoorhoek in verhouding, omdat er geen horizontale afwijking is. In dat geval dient de hoek expliciet als 0 graden aangegeven te worden bij het attribuut Hellingshoek."
      },
