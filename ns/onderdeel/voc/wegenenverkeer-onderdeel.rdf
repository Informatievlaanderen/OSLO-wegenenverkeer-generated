  <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Duingrasland">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
    <rdfs:comment xml:lang="nl">G5a - Zanddoddengras, Kleverige reigersbek, Ruw vergeet-mij-nietje, Kruipend stalkruid, Zandhoornbloem, Duinfakkelgras, Liggende asperge, Duindravik, Duinviooltje, Kegelsilene, Ruwe klaver, Duin- en gewimperd langbaardgras, Lathyruswikke, Geel walstro, Grote tijm, Geel zonneroosje, Liggend bergvlas, Nachtsilene, Walstrobremraap, Kalkbedstro, Zachte haver, Voorjaarsganzerik, Duindravik, Gestreepte klaver, Wondklaver.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Class rdf:about="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#SoortenrijkSchraalGraslandGraslandfase5">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel"/>
        <rdfs:comment xml:lang="nl">G5 - Een fijn, soortenrijk mozaïek van geel-, grijs- en blauwgroene laagblijvende schijngrassen (zeggen en russen) en kruiden.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Grasland"/>
      </owl:Class>
    </rdfs:subClassOf>
  </owl:Class>
