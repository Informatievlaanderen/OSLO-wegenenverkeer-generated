  <https://data.vlaanderen.be/ns/shacl#message> [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/2.9.0nl> "De range van Sluit aan op moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AansluitendeConstructie> zijn."], [<https://wegenenverkeer.data.vlaanderen.be//doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/2.9.0nl> "De range van Sluit aan op moet van het type <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Obstakelbeveiliger> zijn."];
