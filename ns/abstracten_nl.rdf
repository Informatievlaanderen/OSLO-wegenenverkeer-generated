  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AfschermendeConstructie.certificaathouder">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
    <rdfs:comment xml:lang="nl">De houder van het uitvoeringscertificaat.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AfschermendeConstructie">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
        <rdfs:comment xml:lang="nl">Abstracte die een lijn- of puntvormige constructie,geïnstalleerd langs de weg om een kerend vermogen te bieden aan een dwalend voertuig,samenvat.</rdfs:comment>
        <rdfs:subClassOf>
          <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#BijlageVoertuigkering">
            <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
            <rdfs:comment xml:lang="nl">Abstracte om bestanden te bundelen omtrent voertuigkering.</rdfs:comment>
          </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
          <owl:Class rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LijnvormigElement">
            <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
            <rdfs:comment xml:lang="nl">Abstracte voor de gemeenschappelijke eigenschappen en relaties van lijnvormige elementen.</rdfs:comment>
            <rdfs:subClassOf rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject"/>
          </owl:Class>
        </rdfs:subClassOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AfschermendeConstructie.isPermanent">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten"/>
    <rdfs:comment xml:lang="nl">Vermelding of de afschermende constructie al dan niet van permanente aard is.</rdfs:comment>
