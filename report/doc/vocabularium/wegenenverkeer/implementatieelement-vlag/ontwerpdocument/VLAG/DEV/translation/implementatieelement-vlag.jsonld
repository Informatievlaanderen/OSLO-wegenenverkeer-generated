          }
        ],
        "parentclasses": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten-vlag#AIMLinkObject",
        "label": {
          "nl": "Besluit"
        },
        "definition": {
          "nl": "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."
        },
        "usage": {
          "nl": "Hieronder vallen zowel individuele besluiten (rechtshandelingen met een individueel karakter zoals het toekennen van een subsidie) als besluiten van algemene strekking (beslissingen van algemene reglementaire strekking die niet gericht zijn op een individu maar op een groep, zoals de verkeersregels)."
        },
        "label-nl": {
          "nl": "Besluit"
        },
        "definition-nl": {
          "nl": "De authentieke schriftelijke neerslag van een beslissing van een bestuursorgaan. Deze beslissing houdt een rechtshandeling in waarbij sprake is van een beoogd rechtsgevolg."
        },
        "usageNote-nl": {
          "nl": "Hieronder vallen zowel individuele besluiten (rechtshandelingen met een individueel karakter zoals het toekennen van een subsidie) als besluiten van algemene strekking (beslissingen van algemene reglementaire strekking die niet gericht zijn op een individu maar op een groep, zoals de verkeersregels)."
        },
        "label-en": {
          "en": "Resolution"
        },
        "definition-en": {
          "en": "The authentic written summary of a decision of a governing body. This decision involves a legal act with an intended legal effect."
        },
        "usageNote-en": {
          "en": "This includes both individual resolutions (legal acts with an individual character such as grants) and general resolutions (decisions of general rules that are aimed at a group rather than individuals, such as the traffic rules)."
        },
        "equivalent": "",
        "subclass": "",
