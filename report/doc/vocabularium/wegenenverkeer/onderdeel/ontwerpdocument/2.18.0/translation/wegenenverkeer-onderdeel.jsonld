      "label-nl": {
        "nl": "Exoten"
      },
      "usage": {
        "nl": "Klasse uit gebruik sinds versie 2.1.0 "
      },
      "usageNote-nl": {
        "nl": "Klasse uit gebruik sinds versie 2.1.0 "
      },
      "definition": {
        "nl": "Exoten, in deze context, zijn planten die zich hebben gevestigd in België terwijl ze oorspronkelijk niet in België voorkwamen. Ze verdringen bovendien inheemse soorten uit hun normale groeiplaats."
      },
      "label": {
