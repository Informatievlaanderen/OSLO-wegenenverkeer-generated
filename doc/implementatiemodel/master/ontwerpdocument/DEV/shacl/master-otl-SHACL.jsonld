      "sh:property": [
        {
          "@id": "https://wegenenverkeer.data.dev-vlaanderen.be//doc/implementatiemodel/master/ontwerpdocument/DEV#BVAfwateringKunstwerkenShape/440f3b063a60b3d33ddb75dd42f14247c90dc8ae",
