          "uri": "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter"
        },
        "label": {
          "nl": "vrije hoogte"
        },
        "definition": {
          "nl": "De vrije hoogte tussen de overstortdrempel en het plafond van de constructie ter hoogte van de drempel. Voor drempels in leidingen worden de vrije hoogte voor de databank genomen tussen de drempel en de binnenbovenkant buis. Indien er geen sprake is van een vrije hoogte (vb drempels in grachten) wordt dit niet ingevuld."
        },
        "usage": "",
        "ap-label-nl": {
          "nl": "vrije hoogte"
        },
        "ap-definition-nl": {
          "nl": "De vrije hoogte tussen de overstortdrempel en het plafond van de constructie ter hoogte van de drempel. Voor drempels in leidingen worden de vrije hoogte voor de databank genomen tussen de drempel en de binnenbovenkant buis. Indien er geen sprake is van een vrije hoogte (vb drempels in grachten) wordt dit niet ingevuld."
        },
        "ap-usageNote-nl": "",
        "ap-codelist": "",
        "RawTags": [
