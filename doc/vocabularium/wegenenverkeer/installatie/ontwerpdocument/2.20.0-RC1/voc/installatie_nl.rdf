  <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Oplegmechanisme">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Mechanisme dat de overdracht van krachten tussen brugdek en onderbouw toelaat en regelt, terwijl gecontroleerde vervormingen zoals rotatie, translatie of uitzetting mogelijk blijven.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMObject"/>
    <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Geleidingsmechanisme"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Oplegrij.aantalOpleggingenOpRij">
    <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
    <rdfs:comment xml:lang="nl">Het aantal opleggingen die op een rij liggen.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:about="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Oplegrij">
        <rdfs:isDefinedBy rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie"/>
        <rdfs:comment xml:lang="nl">Een rij van opleggingen.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject"/>
