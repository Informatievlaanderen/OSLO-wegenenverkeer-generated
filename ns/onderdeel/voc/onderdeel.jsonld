        "nl": "Voedingsmodule van de PT regelaar 230VAC/ 24 VDC - 5A."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#PTModuleZFirmware"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Persleiding",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "definition": {
        "nl": "Ondergronds kanaal of pijp voor afvoer van een vloeistof of gas onder druk."
      },
      "parents": [
        "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Buis"
      ]
    },
    {
      "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Pictogram",
      "@type": "http://www.w3.org/2002/07/owl#Class",
