<rdfs:isDefinedBy rdf:resource='https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie' />

<rdfs:subClassOf rdf:resource='https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#ConstructieElement' />
